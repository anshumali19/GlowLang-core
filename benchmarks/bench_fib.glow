blueprint Fibonacci:
    action calculate(n):
        when n <= 1:
            return n
        otherwise:
            return self.calculate(n - 1) + self.calculate(n - 2)
        end
    end
end
let calculator = Fibonacci()
let total = 0
let i = 0
while i <= 30:
    total = total + calculator.calculate(i)
    i = i + 1
end
show total
