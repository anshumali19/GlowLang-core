
// N-Queens Cross-Bench (N=10)
blueprint NQueens:
    can init(n):
        self.n = n
        self.count = 0
    end
    can solve():
        let board = range(self.n)
        let i = 0
        while i < self.n:
            board[i] = 0 - 1
            i = i + 1
        end
        self.backtrack(board, 0)
        return self.count
    end
    can backtrack(board, row):
        if row == self.n:
            self.count = self.count + 1
            return 0
        end
        let col = 0
        while col < self.n:
            if self.is_safe(board, row, col):
                board[row] = col
                self.backtrack(board, row + 1)
                board[row] = 0 - 1
            end
            col = col + 1
        end
    end
    can is_safe(board, row, col):
        let i = 0
        while i < row:
            let b = board[i]
            if b == col:
                return false
            end
            let diff = col - b
            if diff < 0:
                diff = 0 - diff
            end
            if diff == (row - i):
                return false
            end
            i = i + 1
        end
        return true
    end
end
let nq = NQueens()
nq.init(10)
print nq.solve()
