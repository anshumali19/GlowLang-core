blueprint Ackermann:
    action calculate(m, n):
        when m is 0:
            return n + 1
        end
        when n is 0:
            return self.calculate(m - 1, 1)
        end
        return self.calculate(m - 1, self.calculate(m, n - 1))
    end
end
let ackObj = Ackermann()
show ackObj.calculate(3, 8)
