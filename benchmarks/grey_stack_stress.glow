let depth = 500000
let head = [None]
let curr = head
let i = 0

while i < depth:
    let next_node = [None]
    curr[0] = next_node
    curr = next_node
    i = i + 1
end

show "Built linked list of depth : " , depth

i = 0
while i < 100000:
    let dummy = [1, 2, 3]
    i = i + 1
end

show "GlowLang GC completed successfully without segfaulting!"
