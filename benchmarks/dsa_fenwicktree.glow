/* Fenwick Tree BIT */

# The lowest set bit of x (x & -x in C): the largest power of two that
# divides x. GlowLang has no bitwise operators, so it is computed.
func lowbit(x):
    let p = 1
    while x % (p * 2) == 0:
        p = p * 2
    end
    return p
end
func update(BITree, n, index, val):
    index = index + 1
    while index <= n:
        BITree[index] = BITree[index] + val
        index = index + lowbit(index)
    end
end

func getSum(BITree, index):
    let sum = 0
    index = index + 1
    while index > 0:
        sum = sum + BITree[index]
        index = index - lowbit(index)
    end
    return sum
end

let freq = [2, 1, 1, 3, 2, 3, 4, 5, 6, 7, 8, 9]
let n = 12
let BITree = range(n + 1)
let i = 0
while i <= n:
    BITree[i] = 0
    i = i + 1
end

i = 0
while i < n:
    update(BITree, n, i, freq[i])
    i = i + 1
end

show getSum(BITree, 5)
