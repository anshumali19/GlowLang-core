blueprint NQueens:
    action init(n):
        self.n = n
        self.count = 0
    end
    action is_safe(board, row, col):
        let i = 0
        while i < row:
            let b = board[i]
            if b is col:
                return false
            end
            let diff = col - b
            if diff < 0:
                diff = 0 - diff
            end
            if diff is (row - i):
                return false
            end
            i = i + 1
        end
        return true
    end
    action backtrack(board, row):
        when row is self.n:
            self.count = self.count + 1
            return 0
        end
        let col = 0
        while col < self.n:
            when self.is_safe(board, row, col):
                board[row] = col
                self.backtrack(board, row + 1)
                board[row] = 0 - 1
            end
            col = col + 1
        end
    end
end
let n = 11
let nq = NQueens()
nq.init(n)
let board = range(n)
let i = 0
while i < n:
    board[i] = 0 - 1
    i = i + 1
end
nq.backtrack(board, 0)
show nq.count
