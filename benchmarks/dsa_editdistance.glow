/* Edit Distance */
func min3(a, b, c):
    let m = a
    if b < m: m = b end
    if c < m: m = c end
    return m
end

func editDistDP(str1, str2, m, n):
    let dp = range(m + 1)
    let i = 0
    while i <= m:
        let row = range(n + 1)
        let j = 0
        while j <= n: row[j] = 0 j = j + 1 end
        dp[i] = row
        i = i + 1
    end

    i = 0
    while i <= m:
        let j = 0
        while j <= n:
            let dp_i = dp[i]
            if i == 0:
                dp_i[j] = j
            end
            if i != 0:
                if j == 0:
                    dp_i[j] = i
                end
                if j != 0:
                    if str1[i - 1] == str2[j - 1]:
                        let dp_prev = dp[i - 1]
                        dp_i[j] = dp_prev[j - 1]
                    end
                    if str1[i - 1] != str2[j - 1]:
                        let dp_prev = dp[i - 1]
                        dp_i[j] = 1 + min3(dp_i[j - 1], dp_prev[j], dp_prev[j - 1])
                    end
                end
            end
            j = j + 1
        end
        i = i + 1
    end
    let final_row = dp[m]
    return final_row[n]
end

let str1 = [115, 117, 110, 100, 97, 121]
let str2 = [115, 97, 116, 117, 114, 100, 97, 121]
show editDistDP(str1, str2, 6, 8)
