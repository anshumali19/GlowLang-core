# Parses .github/workflows/ci.yml (191 lines) again and again for two
# seconds, then writes the parsed value back as text for two seconds, and
# prints how many of each it did per second.
import "yaml"

let text = fs.read(".github/workflows/ci.yml")
let config = yaml.parse(text)
assert(config["jobs"]["build-and-test"]["runs-on"] == "ubuntu-latest", "parsed wrong")
assert(json.stringify(yaml.parse(yaml.stringify(config))) == json.stringify(config), "wrote wrong")

func run(name, work):
    let n = 0
    let start = os.time()
    while os.time() - start < 2:
        work()
        n = n + 1
    end
    show format(name, "<16"), format(int(n / (os.time() - start)), ",d"), "per second"
end

func parse_once():
    yaml.parse(text)
end

func write_once():
    yaml.stringify(config)
end

run("yaml.parse", parse_once)
run("yaml.stringify", write_once)
