# Parses toml_config.toml (about 70 lines) again and again for two seconds,
# then writes the parsed dict back as text for two seconds, and prints how
# many of each it did per second.
import "toml"

let text = fs.read("benchmarks/libs/toml_config.toml")
let config = toml.parse(text)
assert(config["routes"][2]["rate"]["burst"] == 20, "parsed wrong")
let written = toml.stringify(config)
assert(toml.stringify(toml.parse(written)) == written, "wrote wrong")

func run(name, work):
    let n = 0
    let start = os.time()
    while os.time() - start < 2:
        work()
        n = n + 1
    end
    show format(name, "<16"), format(int(n / (os.time() - start)), ",d"), "per second"
end

func parse_once():
    toml.parse(text)
end

func write_once():
    toml.stringify(config)
end

run("toml.parse", parse_once)
run("toml.stringify", write_once)
