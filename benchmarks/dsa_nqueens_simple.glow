let n_global = 4
let count = 0

func is_safe(board, row, col):
    let i = 0
    while i < row:
        let b = board[i]
        if b == col:
            return false
        end
        let d1 = b - col
        let d2 = i - row
        let d3 = row - i
        if d1 == d2:
            return false
        end
        if d1 == d3:
            return false
        end
        i = i + 1
    end
    return true
end

func backtrack(board, row):
    if row == n_global:
        count = count + 1
        return 0
    end

    let col = 0
    while col < n_global:
        if is_safe(board, row, col):
            board[row] = col
            backtrack(board, row + 1)
            board[row] = 0 - 1
        end
        col = col + 1
    end
end

let board = range(n_global)
let i = 0
while i < n_global:
    board[i] = 0 - 1
    i = i + 1
end

let start = os.time()
backtrack(board, 0)
let t_finish = os.time()
show "Solutions: ", count
show "Time: ", t_finish - start
