
func minDistance(dist, sptSet, V):
    let min_val = 999999
    let min_index = 0 - 1
    let v = 0
    while v < V:
        if sptSet[v] == 0:
            if dist[v] <= min_val:
                min_val = dist[v]
                min_index = v
            end
        end
        v = v + 1
    end
    return min_index
end

func dijkstra(graph, V, src):
    let dist = range(V)
    let sptSet = range(V)
    let i = 0
    while i < V:
        dist[i] = 999999
        sptSet[i] = 0
        i = i + 1
    end
    dist[src] = 0
    
    let count = 0
    while count < V - 1:
        let u = minDistance(dist, sptSet, V)
        sptSet[u] = 1
        
        let v = 0
        let row = graph[u]
        while v < V:
            if sptSet[v] == 0:
                if row[v] != 0:
                    if dist[u] != 999999:
                        if dist[u] + row[v] < dist[v]:
                            dist[v] = dist[u] + row[v]
                        end
                    end
                end
            end
            v = v + 1
        end
        count = count + 1
    end
end

let V = 1000
let graph = range(V)
let i = 0
while i < V:
    let row = range(V)
    let j = 0
    while j < V:
        if i == j:
            row[j] = 0
        end
        if i != j:
            row[j] = (i * j + 1) % 100
        end
        j = j + 1
    end
    graph[i] = row
    i = i + 1
end

let start = os.time()
dijkstra(graph, V, 0)
let end_time = os.time()
show "Glow Time: ", end_time - start, " s"
