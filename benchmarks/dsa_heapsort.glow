/* HeapSort */
func heapify(arr, n, i):
    let largest = i
    let l = 2 * i + 1
    let r = 2 * i + 2

    if l < n:
        if arr[l] > arr[largest]:
            largest = l
        end
    end

    if r < n:
        if arr[r] > arr[largest]:
            largest = r
        end
    end

    if largest != i:
        let swap = arr[i]
        arr[i] = arr[largest]
        arr[largest] = swap
        heapify(arr, n, largest)
    end
end

func heapSort(arr, n):
    let i = n / 2 - 1
    while i >= 0:
        heapify(arr, n, i)
        i = i - 1
    end

    i = n - 1
    while i > 0:
        let temp = arr[0]
        arr[0] = arr[i]
        arr[i] = temp
        heapify(arr, i, 0)
        i = i - 1
    end
end

let arr = [12, 11, 13, 5, 6, 7]
heapSort(arr, 6)
show arr
