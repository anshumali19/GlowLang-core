/* Longest Common Subsequence DP */
func max(a, b):
    if a > b: return a end
    return b
end

func lcs(X, Y, m, n):
    let L = range(m + 1)
    let i = 0
    while i <= m:
        let row = range(n + 1)
        let j = 0
        while j <= n: row[j] = 0 j = j + 1 end
        L[i] = row
        i = i + 1
    end

    i = 1
    while i <= m:
        let j = 1
        while j <= n:
            if X[i - 1] == Y[j - 1]:
                let prev_row = L[i - 1]
                let curr_row = L[i]
                curr_row[j] = prev_row[j - 1] + 1
            end
            if X[i - 1] != Y[j - 1]:
                let prev_row = L[i - 1]
                let curr_row = L[i]
                curr_row[j] = max(prev_row[j], curr_row[j - 1])
            end
            j = j + 1
        end
        i = i + 1
    end
    let final_row = L[m]
    return final_row[n]
end

let X = [1, 2, 3, 4, 1]
let Y = [3, 4, 1, 2, 1, 3]
show lcs(X, Y, 5, 6)
