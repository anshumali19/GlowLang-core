{
    "comments": {
        "lineComment": "#",
        "blockComment": [ "/*", "*/" ]
    },
    "brackets": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"]
    ],
    "autoClosingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""],
        ["f\"", "\""],
        ["\"\"\"", "\"\"\""]
    ],
    "surroundingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""],
        ["f\"", "\""],
        ["\"\"\"", "\"\"\""]
    ],
    "indentationRules": {
        "increaseIndentPattern": "^.*:\\s*$",
        "decreaseIndentPattern": "^\\s*(otherwise|eif|catch|finally|end)\\b.*$"
    }
}
