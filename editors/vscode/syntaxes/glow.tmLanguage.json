{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "GlowLang",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#constants"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.glow",
                    "match": "//.*"
                },
                {
                    "name": "comment.line.number-sign.glow",
                    "match": "#.*"
                },
                {
                    "name": "comment.block.glow",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.glow",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.glow",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.glow",
                    "match": "\\b(when|if|eif|otherwise|while|until|repeat|times|for|every|each|in|is\\s+not|is|from|to|func|action|can|lambda|let|return|stop|break|skip|continue|try|catch|throw|import|class|blueprint|Blueprint|trait|extends|use|spawn|end)\\b"
                },
                {
                    "name": "keyword.other.glow",
                    "match": "\\b(show|print|write|input|ask)\\b"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.numeric.glow",
                    "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
                },
                {
                    "name": "constant.language.glow",
                    "match": "\\b(true|false|none|null)\\b"
                },
                {
                    "name": "entity.name.function.glow",
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()"
                }
            ]
        }
    ],
    "scopeName": "source.glow"
}
