{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "GlowLang",
    "scopeName": "source.glow",
    "fileTypes": ["glow"],
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#fstrings" },
        { "include": "#triple-strings" },
        { "include": "#keywords-control" },
        { "include": "#keywords-declaration" },
        { "include": "#keywords-io" },
        { "include": "#keywords-modifier" },
        { "include": "#operators" },
        { "include": "#constants" },
        { "include": "#blueprint-definition" },
        { "include": "#function-definition" },
        { "include": "#action-definition" },
        { "include": "#function-call" },
        { "include": "#variables" },
        { "include": "#self-keyword" },
        { "include": "#punctuation" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.number-sign.glow",
                    "match": "#.*$"
                },
                {
                    "name": "comment.line.double-slash.glow",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.glow",
                    "begin": "/\\*",
                    "end": "\\*/",
                    "name": "comment.block.glow"
                }
            ]
        },
        "triple-strings": {
            "patterns": [
                {
                    "name": "string.quoted.triple.glow",
                    "begin": "\"\"\"",
                    "end": "\"\"\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.glow",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "fstrings": {
            "patterns": [
                {
                    "name": "string.interpolated.glow",
                    "begin": "f\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.glow",
                            "match": "\\\\."
                        },
                        {
                            "name": "meta.interpolation.glow",
                            "begin": "\\{",
                            "end": "\\}",
                            "beginCaptures": {
                                "0": { "name": "punctuation.section.interpolation.begin.glow" }
                            },
                            "endCaptures": {
                                "0": { "name": "punctuation.section.interpolation.end.glow" }
                            },
                            "patterns": [
                                { "include": "source.glow" }
                            ]
                        }
                    ]
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.glow",
                    "begin": "(?<!f)\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.glow",
                            "match": "\\\\(n|r|t|\\\\|\"|0|x[0-9a-fA-F]{2})"
                        }
                    ]
                }
            ]
        },
        "keywords-control": {
            "patterns": [
                {
                    "name": "keyword.control.conditional.glow",
                    "match": "\\b(when|if|eif|otherwise|end)\\b"
                },
                {
                    "name": "keyword.control.loop.glow",
                    "match": "\\b(while|until|repeat|times|for\\s+each|for|every|each|in|from|to)\\b"
                },
                {
                    "name": "keyword.control.flow.glow",
                    "match": "\\b(return|stop|break|skip|continue)\\b"
                },
                {
                    "name": "keyword.control.exception.glow",
                    "match": "\\b(try|catch|throw|finally)\\b"
                },
                {
                    "name": "keyword.control.import.glow",
                    "match": "\\b(import|use)\\b"
                },
                {
                    "name": "keyword.control.async.glow",
                    "match": "\\b(spawn|async|await)\\b"
                }
            ]
        },
        "keywords-declaration": {
            "patterns": [
                {
                    "name": "keyword.declaration.function.glow",
                    "match": "\\b(func|task|lambda)\\b"
                },
                {
                    "name": "keyword.declaration.class.glow",
                    "match": "\\b(blueprint|Blueprint|class|trait|extends|can)\\b"
                },
                {
                    "name": "keyword.declaration.action.glow",
                    "match": "\\b(action)\\b"
                },
                {
                    "name": "keyword.declaration.variable.glow",
                    "match": "\\b(let)\\b"
                }
            ]
        },
        "keywords-io": {
            "patterns": [
                {
                    "name": "support.function.io.glow",
                    "match": "\\b(show|print|write|input|ask)\\b"
                }
            ]
        },
        "keywords-modifier": {
            "patterns": [
                {
                    "name": "keyword.operator.logical.glow",
                    "match": "\\b(and|or|not|is\\s+not|is)\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.comparison.glow",
                    "match": "(==|!=|<=|>=|<|>)"
                },
                {
                    "name": "keyword.operator.assignment.glow",
                    "match": "(\\+=|-=|\\*=|/=|%=|=)"
                },
                {
                    "name": "keyword.operator.arithmetic.glow",
                    "match": "(\\+|-|\\*|/|%|\\*\\*)"
                },
                {
                    "name": "keyword.operator.pipe.glow",
                    "match": "\\|>"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.numeric.float.glow",
                    "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
                },
                {
                    "name": "constant.numeric.hex.glow",
                    "match": "\\b0[xX][0-9a-fA-F]+\\b"
                },
                {
                    "name": "constant.numeric.integer.glow",
                    "match": "\\b[0-9]+\\b"
                },
                {
                    "name": "constant.language.boolean.glow",
                    "match": "\\b(true|false)\\b"
                },
                {
                    "name": "constant.language.null.glow",
                    "match": "\\b(none|null)\\b"
                }
            ]
        },
        "blueprint-definition": {
            "patterns": [
                {
                    "match": "\\b(blueprint|Blueprint)\\s+([A-Z][a-zA-Z0-9_]*)\\s*(:)",
                    "captures": {
                        "1": { "name": "keyword.declaration.class.glow" },
                        "2": { "name": "entity.name.type.class.glow" },
                        "3": { "name": "punctuation.separator.colon.glow" }
                    }
                }
            ]
        },
        "function-definition": {
            "patterns": [
                {
                    "match": "\\b(func|task)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
                    "captures": {
                        "1": { "name": "keyword.declaration.function.glow" },
                        "2": { "name": "entity.name.function.glow" }
                    }
                }
            ]
        },
        "action-definition": {
            "patterns": [
                {
                    "match": "\\b(action)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
                    "captures": {
                        "1": { "name": "keyword.declaration.action.glow" },
                        "2": { "name": "entity.name.function.method.glow" }
                    }
                }
            ]
        },
        "function-call": {
            "patterns": [
                {
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
                    "captures": {
                        "1": { "name": "entity.name.function.call.glow" }
                    }
                },
                {
                    "match": "\\.([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
                    "captures": {
                        "1": { "name": "entity.name.function.method-call.glow" }
                    }
                }
            ]
        },
        "self-keyword": {
            "patterns": [
                {
                    "name": "variable.language.self.glow",
                    "match": "\\bself\\b"
                }
            ]
        },
        "variables": {
            "patterns": [
                {
                    "match": "\\b(let)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
                    "captures": {
                        "1": { "name": "keyword.declaration.variable.glow" },
                        "2": { "name": "variable.other.glow" }
                    }
                }
            ]
        },
        "punctuation": {
            "patterns": [
                {
                    "name": "punctuation.separator.colon.glow",
                    "match": ":"
                },
                {
                    "name": "punctuation.separator.comma.glow",
                    "match": ","
                },
                {
                    "name": "punctuation.bracket.round.glow",
                    "match": "[()]"
                },
                {
                    "name": "punctuation.bracket.square.glow",
                    "match": "[\\[\\]]"
                },
                {
                    "name": "punctuation.bracket.curly.glow",
                    "match": "[{}]"
                }
            ]
        }
    }
}
