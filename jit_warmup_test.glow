action benchmark_jit():
    let i = 0
    while i < 1000:
        let start = time.now()
        hot_function()
        let end = time.now()
        /* We can't easily print 1000 times without flooding, so we'll just do a subset or sum */
        i = i + 1
    end
end

action hot_function():
    let a = 1
    let b = 2
    let c = a + b
end

benchmark_jit()
