# The everyday forms
same("reverse a list", [1, 2, 3][::-1], [3, 2, 1])
same("reverse text", "glow"[::-1], "wolg")
same("every other", [0, 1, 2, 3, 4, 5][::2], [0, 2, 4])
same("odd places", [0, 1, 2, 3, 4, 5][1::2], [1, 3, 5])
same("empty step part", [1, 2, 3][::], [1, 2, 3])
same("start and stop with an empty step part", [1, 2, 3][1:3:], [2, 3])
same("a slice is a copy", len([1, 2][::1]), 2)
same("empty list", [][::-1], [])
same("empty text", ""[::2], "")
let k = 2
same("expressions as parts", [0, 1, 2, 3, 4, 5, 6][k - 1:k * 3:k], [1, 3, 5])
func errs(f):
    try:
        f()
    catch e:
        return str(e)
    end
    return "no error"
end
same("step 0", errs(lambda(): [1][::0]), "slice step cannot be 0")
same("text step", errs(lambda(): [1][::"x"]), "slice step must be a whole number")
same("fraction step", errs(lambda(): [1][::1.5]), "slice step must be a whole number")
same("slicing a number", errs(lambda(): (5)[::1]), "cannot slice a int (only lists and strings)")
func hot():
    let total = 0
    every i from 1 to 3000:
        total = total + len([1, 2, 3, 4][::-1])
    end
    return total
end
same("in a hot loop", hot(), 12000)
show "passed: " + str(passed) + "   failed: " + str(failed)
if failed > 0:
    os.exit(1)
end
