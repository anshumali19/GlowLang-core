# Slices with a step: x[start:stop:step]. Every expected value below is
# what Python gives for the same slice (generated, then checked in).
let passed = 0
let failed = 0
func same(name, got, want):
    if got == want:
        passed = passed + 1
    else:
        failed = failed + 1
        show "FAIL: " + name + " (got " + str(got) + ", wanted " + str(want) + ")"
    end
end
let l = [10, 11, 12, 13, 14]
let s = "héllo🚀"
same("l[::-9]", l[::-9], [14])
same("s[::-9]", s[::-9], "🚀")
same("l[::-3]", l[::-3], [14, 11])
same("s[::-3]", s[::-3], "🚀l")
same("l[::-2]", l[::-2], [14, 12, 10])
same("s[::-2]", s[::-2], "🚀lé")
same("l[::-1]", l[::-1], [14, 13, 12, 11, 10])
same("s[::-1]", s[::-1], "🚀olléh")
same("l[::1]", l[::1], [10, 11, 12, 13, 14])
same("s[::1]", s[::1], "héllo🚀")
same("l[::2]", l[::2], [10, 12, 14])
same("s[::2]", s[::2], "hlo")
same("l[::3]", l[::3], [10, 13])
same("s[::3]", s[::3], "hl")
same("l[::9]", l[::9], [10])
same("s[::9]", s[::9], "h")
same("l[:-9:-9]", l[:-9:-9], [14])
same("s[:-9:-9]", s[:-9:-9], "🚀")
