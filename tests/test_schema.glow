# schema.validate / is_valid / check (lib/schema.glow).
import "schema"

func v(value, s):
    let errors = schema.validate(value, s)
    when len(errors) == 0:
        show "ok"
    otherwise:
        for each e in errors:
            show "  " + e
        end
    end
end

show "--- an API body"
let user = {
    "type": "object",
    "required": ["name", "age", "email"],
    "additionalProperties": false,
    "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 20},
        "age": {"type": "integer", "minimum": 0, "maximum": 150},
        "email": {"type": "string", "pattern": "^[^@ ]+@[^@ ]+\\.[a-z]+$"},
        "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "maxItems": 3},
        "role": {"enum": ["admin", "user"]}
    }
}
v({"name": "Ana", "age": 30, "email": "ana@glow.example", "tags": ["a", "b"], "role": "admin"}, user)
v({"name": "", "age": -1, "email": "not an email", "tags": ["a", "a", 3, "d"], "role": "root", "extra": 1}, user)
v({"age": 30.0, "name": "Bo", "email": "bo@x.io"}, user)
v({"age": 30.5}, user)
v([], user)
show schema.is_valid({"name": "Ana", "age": 1, "email": "a@b.co"}, user), schema.is_valid(5, user)
try:
    schema.check({"name": "Ana"}, user)
catch e:
    show e
end

show "--- types"
for each t in ["object", "array", "string", "number", "integer", "boolean", "null"]:
    let fits = []
    for each value in [{}, [], "x", 1.5, 2, true, none, 3.0]:
        when schema.is_valid(value, {"type": t}):
            fits.push(json.stringify(value))
        end
    end
    show t, fits
end
v(none, {"type": ["string", "null"]})
v(5, {"type": ["string", "null"]})

show "--- numbers"
v(10, {"exclusiveMinimum": 10})
v(10, {"exclusiveMaximum": 10})
v(9, {"multipleOf": 3})
v(10, {"multipleOf": 3})
v(7.5, {"multipleOf": 2.5})
v("not a number", {"minimum": 3})

show "--- combinations"
let id = {"anyOf": [{"type": "integer"}, {"type": "string", "pattern": "^[a-f0-9]{8}$"}]}
v(5, id)
v("deadbeef", id)
v("nope", id)
let one = {"oneOf": [{"type": "integer"}, {"minimum": 2}]}
v(1, one)
v(5, one)
v(1.5, one)
v("x", {"not": {"type": "string"}})
v(4, {"allOf": [{"minimum": 1}, {"maximum": 3}]})
v({"a": 1}, {"const": {"a": 1}})
v({"a": 2}, {"const": {"a": 1}})

show "--- objects"
v({"a": 1, "b": "x"}, {"additionalProperties": {"type": "integer"}})
v({}, {"minProperties": 1})
v({"a": 1, "b": 2}, {"maxProperties": 1})
v({"a/b": {"c~d": 1}}, {"properties": {"a/b": {"properties": {"c~d": {"type": "string"}}}}})

show "--- arrays"
v([[1, 2], [2, 1], [1, 2]], {"uniqueItems": true})
v([{"a": 1, "b": 2}, {"b": 2, "a": 1}], {"uniqueItems": true})
v([1, 1.0], {"uniqueItems": true})
v([], {"minItems": 1})

show "--- $ref and boolean schemas"
let tree = {
    "$defs": {"node": {"type": "object", "required": ["value"], "properties": {"value": {"type": "integer"}, "children": {"type": "array", "items": {"$ref": "#/$defs/node"}}}}},
    "$ref": "#/$defs/node"
}
v({"value": 1, "children": [{"value": 2}, {"value": "x", "children": [{}]}]}, tree)
v(42, true)
v(42, false)
v({"a": 1}, {"properties": {"a": false}})
try:
    schema.validate(1, {"$ref": "https://example.com/s.json"})
catch e:
    show e
end
try:
    schema.validate(1, {"$ref": "#/$defs/missing"})
catch e:
    show e
end
try:
    schema.validate(1, {"properties": 5, "type": "integer", "allOf": ["x"]})
catch e:
    show e
end

show "--- ignored keywords"
v("x", {"type": "string", "title": "Text", "default": "x", "examples": ["y"]})

show "--- format"
let formats = {
    "date": [["2024-02-29", "2026-12-31", "2000-02-29"], ["2023-02-29", "1900-02-29", "2026-13-01", "2026-04-31", "2026-00-10", "2026-1-01", "26-01-01"]],
    "time": [["23:59:60Z", "08:30:00.123+05:30", "00:00:00z"], ["24:00:00Z", "12:60:00Z", "12:00:00", "12:00:00+24:00", "1:00:00Z"]],
    "date-time": [["2026-11-25T09:30:00Z", "2026-11-25t09:30:00.5-01:00"], ["2026-11-25 09:30:00Z", "2026-11-31T09:30:00Z", "2026-11-25T09:30Z", "2026-11-25"]],
    "email": [["ana@glow.example", "a.b+c@x-y.example", "x@localhost"], ["ana", "@glow.example", "ana@", "a b@x.example", "ana@-x.example", "ana@x..example"]],
    "hostname": [["glow.example", "a", "x-1.example"], ["", "-x.example", "x-.example", "a..b", "a_b.example"]],
    "ipv4": [["0.0.0.0", "192.168.1.255"], ["256.1.1.1", "1.2.3", "01.2.3.4", "1.2.3.4.5", "a.b.c.d"]],
    "ipv6": [["::", "::1", "2001:db8::8a2e:370:7334", "1:2:3:4:5:6:7:8", "::ffff:192.0.2.1", "fe80::"], ["1:2:3:4:5:6:7:8:9", "1::2::3", "12345::", ":1", "1:2:3:4:5:6:7", "::ffff:999.0.2.1", "1.2.3.4::"]],
    "uri": [["https://glow.example/a?b=c", "mailto:ana@glow.example", "urn:isbn:0451450523"], ["glow.example", "/path", "https://a b", "1http://x"]],
    "uuid": [["123e4567-e89b-12d3-a456-426614174000", "123E4567-E89B-12D3-A456-426614174000"], ["123e4567e89b12d3a456426614174000", "123e4567-e89b-12d3-a456-42661417400g"]]
}
for each name in formats.keys():
    let s = {"format": name}
    for each good in formats[name][0]:
        when not schema.is_valid(good, s):
            show "rejected", name, json.stringify(good)
        end
    end
    for each bad in formats[name][1]:
        when schema.is_valid(bad, s):
            show "allowed", name, json.stringify(bad)
        end
    end
    show name, "checked"
end
v({"email": "nope", "when": "2026-02-30"}, {"properties": {"email": {"type": "string", "format": "email"}, "when": {"format": "date"}}})
v(42, {"format": "email"})
v("anything", {"format": "credit-card"})
