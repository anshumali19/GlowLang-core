# ini.parse, read, stringify and write (lib/ini.glow).
import "ini"

show "--- parse"
let text = "; settings\nname = shop\n\n[server]\nhost = 0.0.0.0\nport: 8080\n  # not a value\nurl = http://x.example/a=b\n\n[database]\nurl=postgres://db\ndescription = first line\n    second line\n    third line\nflag\nEmpty =\n[ spaced name ]\nKey = Value with spaces  \r\n"
let c = ini.parse(text)
show c
show int(c["server"]["port"]) + 1, c["database"]["description"].split("\n")
show ini.parse(""), ini.parse("# only a comment\n\n")

show "--- write and read back"
let written = ini.stringify(c)
show written
show json.stringify(ini.parse(written)) == json.stringify(c)
show json.stringify(ini.stringify({}))
let path = "test_ini_tmp.ini"
try:
    ini.write(path, {"app": {"debug": "false", "workers": 4}})
    show ini.read(path)
    try:
        ini.read("no_such_file.ini")
    catch e:
        show e
    end
finally:
    fs.remove(path)
end

show "--- errors"
for each bad in ["[a]\n[a]", "[a]\nk = 1\nk = 2", "[a", "= 1", "[a]\n: x"]:
    try:
        ini.parse(bad)
        show "allowed", json.stringify(bad)
    catch e:
        show e
    end
end
