# diff.lines and diff.unified (lib/diff.glow). The unified outputs below are
# what GNU diff -u prints for the same texts.
import "diff"

show "--- lines"
show diff.lines("a\nb\nc\n", "a\nB\nc\nd\n")
show diff.lines(["x", "y"], ["y", "z"])
show diff.lines("", ""), diff.lines("same", "same")

show "--- unified"
show diff.unified("a\nb\nc\n", "a\nB\nc\n")
show diff.unified("a\nb\nc", "a\nb\nc\n", "old.txt", "new.txt")
show diff.unified("", "x\ny\n")
show diff.unified("x\ny\n", "")
show json.stringify(diff.unified("same\n", "same\n"))

show "--- hunks and context"
let base = []
every i from 1 to 30:
    base.push("line " + str(i))
end
let changed = base.copy()
changed[2] = "line 3 changed"
changed[9] = "line 10 changed"
changed.insert(25, "inserted")
show diff.unified(base, changed)
show diff.unified(base, changed, "a", "b", 0)

show "--- the ops rebuild both texts"
random_seed(4)
let a = []
every i from 1 to 400:
    a.push("w" + str(random_int(1, 6)))
end
let b = a.copy()
every e from 1 to 60:
    let at = random_int(0, len(b) - 1)
    let what = random_int(0, 2)
    when what == 0:
        b = b[:at] + b[at + 1:]
    eif what == 1:
        b.insert(at, "new" + str(e))
    otherwise:
        b[at] = "changed" + str(e)
    end
end
let ops = diff.lines(a, b)
let left = []
let right = []
let edits = 0
for each op in ops:
    when op[0] != "+":
        left.push(op[1])
    end
    when op[0] != "-":
        right.push(op[1])
    end
    when op[0] != " ":
        edits = edits + 1
    end
end
show left == a, right == b, edits <= 120

show "--- shortest, also when the work is split in linear space"
# Edits of a shortest diff, from a table of common-subsequence lengths.
func lcs_edits(a, b):
    let prev = [0] * (len(b) + 1)
    for each x in a:
        let cur = [0] * (len(b) + 1)
        let j = 1
        while j <= len(b):
            when x == b[j - 1]:
                cur[j] = prev[j - 1] + 1
            otherwise:
                cur[j] = max(prev[j], cur[j - 1])
            end
            j = j + 1
        end
        prev = cur
    end
    return len(a) + len(b) - 2 * prev[len(b)]
end
func check_random(seed):
    random_seed(seed)
    let wrong = 0
    every t from 1 to 150:
        let a = []
        let b = []
        every i from 1 to random_int(0, 14):
            a.push(str(random_int(0, 3)))
        end
        every i from 1 to random_int(0, 14):
            b.push(str(random_int(0, 3)))
        end
        let left = []
        let right = []
        let edits = 0
        let last = " "
        let order_ok = true
        for each op in diff.lines(a, b):
            when op[0] != "+":
                left.push(op[1])
            end
            when op[0] != "-":
                right.push(op[1])
            end
            when op[0] != " ":
                edits = edits + 1
            end
            when last == "+" and op[0] == "-":
                order_ok = false
            end
            last = op[0]
        end
        when left != a or right != b or edits != lcs_edits(a, b) or not order_ok:
            wrong = wrong + 1
        end
    end
    return wrong
end
show check_random(7)
_DIFF_QUICK_EDITS = 0
show check_random(8)
show diff.lines("same
a
keep
b
end
", "same
x
keep
y
end
")

show "--- past the edit limit the middle is replaced whole"
_DIFF_MAX_EDITS = 1
show diff.lines("same
a
keep
b
end
", "same
x
keep
y
end
")
_DIFF_MAX_EDITS = 5000
_DIFF_QUICK_EDITS = 200

show "--- large texts stay quick"
let big_a = []
every i from 1 to 20000:
    big_a.push("row " + str(i))
end
let big_b = big_a.copy()
every e from 1 to 40:
    big_b[e * 400] = "edited " + str(e)
end
let start = os.time()
let d = diff.unified(big_a, big_b)
show d.count("@@ -"), os.time() - start < 10
