# Test Lambdas and Closures

# Basic lambda
add = lambda(x, y): x + y
show "1 + 2 =", add(1, 2)

# Lambda with no params
greet = lambda(): "Hello from lambda!"
show greet()

# Closure: capturing a variable
func make_adder(x):
    let y = x
    return lambda(z): y + z
end

add5 = make_adder(5)
show "5 + 10 =", add5(10)

# Closure with nested scopes
func outer(a):
    let x = a
    return lambda(b):
        let y = b
        return lambda(c): x + y + c
    end
end

f1 = outer(10)
f2 = f1(20)
show "10 + 20 + 30 =", f2(30)

# Lambda in a list
ops = [lambda(x): x*2, lambda(x): x*x]
show "2 * 5 =", ops[0](5)
show "5 * 5 =", ops[1](5)
