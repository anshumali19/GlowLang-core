# Compiled + - * / do float arithmetic inline. Every result here must be
# what the interpreter gives: the same value and the same type (a float that
# holds a whole number becomes an int, NaN stays NaN, big ints stay exact,
# division by zero is an error). Each function runs hot so it is compiled.

func f_add(a, b):
    return a + b
end
func f_sub(a, b):
    return a - b
end
func f_mul(a, b):
    return a * b
end
func f_div(a, b):
    return a / b
end

let big = 2 ** 60
let inf = 1e300 * 1e300
let values = [0, 1, -3, 140737488355327, -140737488355328, big, 0.0, -0.0, 0.5, -0.5, 2.0, 1.5, 0.1, 1e300, 1e-300, 4503599627370497.0, 9.5e18, inf, -inf, inf - inf]

func describe(r):
    return type(r) + ":" + str(r)
end

func run_all(record):
    let out = []
    for each a in values:
        for each b in values:
            let row = [describe(f_add(a, b)), describe(f_sub(a, b)), describe(f_mul(a, b))]
            try:
                row.push(describe(f_div(a, b)))
            catch e:
                row.push("error")
            end
            if record:
                out.push(str(a) + " " + str(b) + " -> " + row.join(" | "))
            end
        end
    end
    return out
end

# Warm up so the arithmetic functions are compiled, then record.
let w = 0
while w < 30:
    run_all(false)
    w = w + 1
end
for each line in run_all(true):
    show line
end

# A float loop of the kind the inline path is for.
func series(n):
    let s = 0.0
    let i = 0
    while i < n:
        let x = i * 0.5
        s = s + (x * x + 1.0) / (x + 1.0) - 0.25
        i = i + 1
    end
    return s
end
show "series:", series(100000)

# Strings and lists still go through + as before.
show f_add("a", "b"), f_add([1], [2]), f_mul("ab", 3)
try:
    show f_sub("a", 1)
catch e:
    show "sub error:", e
end

# Floats too big for an int64 used to be squeezed into one (1e300 * 2 gave
# -18446744073709551616); they are doubles, and compare exactly with big ints.
show 1e300 * 2, 1e19 + 1, 9.3e18 - 1, 1e300 * 1e300, 2 ** 100 + 1e300
show 2 ** 100 < 1e300, 1e300 > 2 ** 100, 2 ** 100 == 2.0 ** 100, 2 ** 64 == 18446744073709551616.0, -(2 ** 70) < -1e21
show 2 ** 100 < inf, 2 ** 100 > -inf, 7.5 % 2, -7 % 3, 1e19 % 7

# Whole-number results from the C library at or beyond 2^47 used to wrap
# (math.floor(1e15) gave -125899906842624).
show math.floor(1e15), math.sqrt(1e30), math.abs(-3e15), math.floor(2.5e14), math.ceil(-2.5e14)
show math.floor(140737488355327.0), math.floor(140737488355328.0), math.floor(1e15) + 1, math.sqrt(-1)
