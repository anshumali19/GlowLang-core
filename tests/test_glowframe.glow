# glowframe: building tables, CSV, choosing, sorting, statistics, groups, joins.
use "glowframe"

let passed = 0
let failed = 0

func ok(name, cond):
    if cond:
        passed = passed + 1
    else:
        failed = failed + 1
        show "FAIL: " + name
    end
end

func same(name, got, want):
    if got == want:
        passed = passed + 1
    else:
        failed = failed + 1
        show "FAIL: " + name + " (got " + str(got) + ", wanted " + str(want) + ")"
    end
end

func near(name, got, want, tol = 1e-9):
    let d = got - want
    if d < 0:
        d = 0 - d
    end
    if d <= tol:
        passed = passed + 1
    else:
        failed = failed + 1
        show "FAIL: " + name + " (got " + str(got) + ", wanted " + str(want) + ")"
    end
end

func fails_with(name, f, text):
    let msg = ""
    try:
        f()
    catch e:
        msg = str(e)
    end
    if msg.contains("glowframe:") and msg.contains(text):
        passed = passed + 1
    else:
        failed = failed + 1
        show "FAIL: " + name + " (error was: " + msg + ")"
    end
end

let df = DataFrame({"name": ["Ana", "Ben", "Cy", "Dee", "Eli"], "team": ["red", "blue", "red", "blue", "red"], "age": [30, 25, 35, none, 28], "score": [88.5, 92, 79, 85, none]})

show "== building"
same("shape", df.shape(), [5, 4])
same("columns", df.columns(), ["name", "team", "age", "score"])
same("count_rows", df.count_rows(), 5)
same("col", df.col("age"), [30, 25, 35, none, 28])
same("row", df.row(1), {"name": "Ben", "team": "blue", "age": 25, "score": 92})
same("rows", len(df.rows()), 5)
let source = {"a": [1, 2]}
let held = DataFrame(source)
source["a"][0] = 99
same("the DataFrame copies its data", held.col("a"), [1, 2])
let got = held.col("a")
got[0] = 77
same("col returns a copy", held.col("a"), [1, 2])
same("empty DataFrame", DataFrame({}).shape(), [0, 0])
let from_rows = frame_from_rows([{"x": 1, "y": "a"}, {"x": 2}, {"y": "c", "z": true}])
same("from rows: columns", from_rows.columns(), ["x", "y", "z"])
same("from rows: missing keys", from_rows.col("x"), [1, 2, none])
same("from rows: later column", from_rows.col("z"), [none, none, true])
same("from no rows", frame_from_rows([]).shape(), [0, 0])
let from_matrix = frame_from_matrix([[1, 2], [3, 4]], ["a", "b"])
same("from matrix", from_matrix.col("b"), [2, 4])
same("round trip through rows", frame_from_rows(df.rows()).rows(), df.rows())

show "== looking"
same("head", df.head(2).col("name"), ["Ana", "Ben"])
same("head default", df.head().shape(), [5, 4])
same("head past the end", df.head(99).count_rows(), 5)
same("head of none", df.head(0).shape(), [0, 4])
same("tail", df.tail(2).col("name"), ["Dee", "Eli"])
same("take", df.take([4, 0]).col("name"), ["Eli", "Ana"])
let sampled = df.sample(3, 1)
ok("sample size", sampled.count_rows() == 3 and len(sampled.unique("name")) == 3)
same("same seed, same sample", df.sample(3, 1).col("name"), sampled.col("name"))

show "== columns"
same("select", df.select(["age", "name"]).columns(), ["age", "name"])
same("select one name", df.select("age").columns(), ["age"])
same("drop", df.drop(["age", "score"]).columns(), ["name", "team"])
same("rename", df.rename({"age": "years"}).columns(), ["name", "team", "years", "score"])
same("rename leaves the original alone", df.columns(), ["name", "team", "age", "score"])
let doubled = df.with_column("double", lambda(r): r["age"] * 2 if r["age"] != none else none)
same("with_column from a function", doubled.col("double"), [60, 50, 70, none, 56])
same("with_column from a list", df.with_column("id", [1, 2, 3, 4, 5]).col("id"), [1, 2, 3, 4, 5])
same("with_column replaces", df.with_column("age", [1, 1, 1, 1, 1]).col("age"), [1, 1, 1, 1, 1])
same("with_column keeps column order", df.with_column("age", [1, 1, 1, 1, 1]).columns(), df.columns())
same("with_column on an empty DataFrame", DataFrame({}).with_column("a", [1, 2]).shape(), [2, 1])
same("map_column", df.map_column("name", lambda(v): v.upper()).col("name"), ["ANA", "BEN", "CY", "DEE", "ELI"])

show "== rows"
same("filter", df.filter(lambda(r): r["team"] == "red").col("name"), ["Ana", "Cy", "Eli"])
same("filter with missing values", df.filter(lambda(r): r["age"] != none and r["age"] > 28).col("name"), ["Ana", "Cy"])
same("filter keeping nothing", df.filter(lambda(r): false).shape(), [0, 4])
same("sort", df.sort_values("age").col("name"), ["Ben", "Eli", "Ana", "Cy", "Dee"])
same("sort descending keeps missing last", df.sort_values("age", true).col("name"), ["Cy", "Ana", "Eli", "Ben", "Dee"])
same("sort text", df.sort_values("name", true).col("name"), ["Eli", "Dee", "Cy", "Ben", "Ana"])
let ties = DataFrame({"k": [2, 1, 2, 1], "v": ["a", "b", "c", "d"]})
same("sort is stable", ties.sort_values("k").col("v"), ["b", "d", "a", "c"])
same("descending sort is stable", ties.sort_values("k", true).col("v"), ["a", "c", "b", "d"])
same("sort by two columns", df.sort_values(["team", "name"]).col("name"), ["Ben", "Dee", "Ana", "Cy", "Eli"])
same("sort leaves the original alone", df.col("name"), ["Ana", "Ben", "Cy", "Dee", "Eli"])
same("dropna", df.dropna().col("name"), ["Ana", "Ben", "Cy"])
same("dropna for one column", df.dropna("age").col("name"), ["Ana", "Ben", "Cy", "Eli"])
same("fillna", df.fillna(0).col("age"), [30, 25, 35, 0, 28])
same("fillna for one column", df.fillna(0, ["score"]).col("age"), [30, 25, 35, none, 28])
same("isna_counts", df.isna_counts(), {"name": 0, "team": 0, "age": 1, "score": 1})
let reps = DataFrame({"a": [1, 1, 2, 1], "b": ["x", "x", "x", "y"]})
same("drop_duplicates", reps.drop_duplicates().rows(), [{"a": 1, "b": "x"}, {"a": 2, "b": "x"}, {"a": 1, "b": "y"}])
same("drop_duplicates on one column", reps.drop_duplicates("a").col("b"), ["x", "x"])
same("1 and \"1\" are different values", DataFrame({"a": [1, "1", 1]}).drop_duplicates().count_rows(), 2)

show "== statistics"
same("sum", df.sum("age"), 118)
near("mean skips missing values", df.mean("age"), 29.5)
same("min", df.min("age"), 25)
same("max", df.max("score"), 92)
same("min of text", df.min("name"), "Ana")
near("median", df.median("age"), 29)
near("std", df.std("age"), math.sqrt(17.666666666666668))
same("count", df.count("age"), 4)
same("unique", df.unique("team"), ["red", "blue"])
let vc = df.value_counts("team")
same("value_counts", vc.rows(), [{"team": "red", "count": 3}, {"team": "blue", "count": 2}])
near("corr", DataFrame({"a": [1, 2, 3, none], "b": [2, 4, 6, 9]}).corr("a", "b"), 1)
same("numeric_columns", df.numeric_columns(), ["age", "score"])
let desc = df.describe()
same("describe columns", desc.columns(), ["stat", "age", "score"])
same("describe stats", desc.col("stat"), ["count", "mean", "std", "min", "median", "max"])
same("describe count", desc.col("age")[0], 4)
near("describe mean", desc.col("score")[1], 86.125)
let empty_col = DataFrame({"a": [none, none]})
same("mean of nothing is none", empty_col.mean("a"), none)
same("sum of nothing is 0", empty_col.sum("a"), 0)
same("std of one value is none", DataFrame({"a": [5]}).std("a"), none)

show "== groups"
let by_team = df.group_by("team")
same("group sizes", by_team.size().rows(), [{"team": "blue", "size": 2}, {"team": "red", "size": 3}])
let means = by_team.agg({"age": "mean", "score": "max"})
same("agg columns", means.columns(), ["team", "age", "score"])
same("groups are sorted by key", means.col("team"), ["blue", "red"])
near("group mean skips missing", means.col("age")[0], 25)
near("group mean", means.col("age")[1], 31)
same("group max", means.col("score"), [92, 88.5])
let several = by_team.agg({"age": ["min", "max", "count"]})
same("several aggregations", several.columns(), ["team", "age_min", "age_max", "age_count"])
same("several aggregations values", several.row(1), {"team": "red", "age_min": 28, "age_max": 35, "age_count": 3})
same("first and last", by_team.agg({"name": ["first", "last"]}).row(0), {"team": "blue", "name_first": "Ben", "name_last": "Dee"})
same("nunique", DataFrame({"g": ["a", "a", "a"], "v": [1, 1, 2]}).group_by("g").agg({"v": "nunique"}).col("v"), [2])
let two = DataFrame({"a": ["x", "x", "y", "y"], "b": [2, 1, 1, 1], "v": [10, 20, 30, 40]})
same("group by two columns", two.group_by(["a", "b"]).agg({"v": "sum"}).rows(), [{"a": "x", "b": 1, "v": 20}, {"a": "x", "b": 2, "v": 10}, {"a": "y", "b": 1, "v": 70}])
same("number keys sort as numbers", DataFrame({"k": [10, 9, 100], "v": [1, 1, 1]}).group_by("k").size().col("k"), [9, 10, 100])
same("rows with a missing key are left out", DataFrame({"k": ["a", none, "a"], "v": [1, 2, 3]}).group_by("k").agg({"v": "sum"}).rows(), [{"k": "a", "v": 4}])
let parts = by_team.parts()
ok("parts", len(parts) == 2 and parts[0][0] == ["blue"] and parts[0][1].col("name") == ["Ben", "Dee"])

show "== joins"
let teams = DataFrame({"team": ["red", "blue", "green"], "city": ["Rome", "Bern", "Graz"]})
let joined = df.merge(teams, "team")
same("inner join columns", joined.columns(), ["name", "team", "age", "score", "city"])
same("inner join values", joined.col("city"), ["Rome", "Bern", "Rome", "Bern", "Rome"])
let orders = DataFrame({"id": [1, 2, 3], "who": ["a", "b", "z"]})
let people = DataFrame({"who": ["a", "b", "b"], "id": [10, 20, 21]})
let inner = orders.merge(people, "who")
same("inner join drops rows without a match and repeats for several", inner.rows(), [{"id": 1, "who": "a", "id_right": 10}, {"id": 2, "who": "b", "id_right": 20}, {"id": 2, "who": "b", "id_right": 21}])
let left = orders.merge(people, "who", "left")
same("left join keeps every left row", left.col("id_right"), [10, 20, 21, none])
same("missing keys never match", DataFrame({"k": [none, 1]}).merge(DataFrame({"k": [none, 1], "v": [5, 6]}), "k").rows(), [{"k": 1, "v": 6}])
let stacked = frame_concat([DataFrame({"a": [1], "b": [2]}), DataFrame({"b": [3], "c": [4]})])
same("concat", stacked.rows(), [{"a": 1, "b": 2, "c": none}, {"a": none, "b": 3, "c": 4}])

show "== CSV"
let text = "name,qty,price,note\nApple,3,0.5,fresh\n\"Pear, green\",10,1.25,\"says \"\"hi\"\"\"\nPlum,,2,\n"
let csv = parse_csv(text)
same("csv shape", csv.shape(), [3, 4])
same("csv numbers", csv.col("qty"), [3, 10, none])
same("csv decimals", csv.col("price"), [0.5, 1.25, 2])
same("csv quoted comma", csv.col("name")[1], "Pear, green")
same("csv doubled quotes", csv.col("note")[1], "says \"hi\"")
same("csv empty cell is missing", csv.col("note")[2], none)
same("csv types", [type(csv.col("qty")[0]), type(csv.col("price")[0]), type(csv.col("name")[0])], ["int", "float", "string"])
let odd = parse_csv("a;b\r\n1;x\r\n\r\n-2.5e1;\"line one\nline two\"\r\n", ";")
same("csv other separator and line endings", odd.col("a"), [1, -25])
same("csv new line inside quotes", odd.col("b")[1], "line one\nline two")
let typed = parse_csv("v\n007\n\"12\"\ntrue\nfalse\nnan\n1e3\n+4\n 5 \n")
same("csv values", typed.col("v"), [7, "12", true, false, "nan", 1000, 4, 5])
same("csv header only", parse_csv("a,b\n").shape(), [0, 2])
same("csv without a final new line", parse_csv("a\n1").col("a"), [1])
let back = parse_csv(csv.to_csv_text())
same("csv round trip", back.rows(), csv.rows())
let tricky = DataFrame({"t": ["12", "true", " padded ", "", "a\"b", "x,y", none], "n": [1, 2.5, -3, 0, none, 7, 8]})
same("csv round trip keeps text that looks like something else", parse_csv(tricky.to_csv_text()).rows()[:6], tricky.rows()[:6])
let path = fs.join(os.temp_dir(), "glowframe_test.csv")
df.to_csv(path)
same("write and read a file", read_csv(path).rows(), df.rows())
fs.remove(path)

show "== output"
same("to_matrix", df.dropna().to_matrix(["age", "score"]), [[30, 88.5], [25, 92], [35, 79]])
same("to_matrix of one column", DataFrame({"a": [1, 2]}).to_matrix("a"), [[1], [2]])
let small = DataFrame({"item": ["pen", "notebook"], "qty": [12, 3]})
same("to_string", small.to_string(), "item      qty\n--------  ---\npen        12\nnotebook    3\n[2 rows x 2 columns]")
let long = DataFrame({"n": range(50)})
let shown = long.to_string(4)
ok("to_string shortens long tables", shown.contains("...") and shown.contains("49") and not shown.contains("25") and shown.contains("[50 rows x 1 columns]"))
ok("to_string shows missing values as blanks", df.to_string().contains("Dee   blue          85
Eli   red    28
"))

show "== errors"
fails_with("unknown column", lambda(): df.col("height"), "no column 'height'")
fails_with("unknown column lists the columns", lambda(): df.col("height"), "name, team, age, score")
fails_with("column lengths", lambda(): DataFrame({"a": [1, 2], "b": [1]}), "has 1 value(s) but 'a' has 2")
fails_with("column must be a list", lambda(): DataFrame({"a": 5}), "must be a list")
fails_with("data must be a dict", lambda(): DataFrame([1, 2]), "dict of column name")
fails_with("row out of range", lambda(): df.row(9), "outside the 5 row(s)")
fails_with("take out of range", lambda(): df.take([0, 7]), "outside")
fails_with("sample too many", lambda(): df.sample(9), "cannot take 9 of 5")
fails_with("with_column length", lambda(): df.with_column("x", [1, 2]), "2 value(s) for 5 row(s)")
fails_with("rename clash", lambda(): df.rename({"age": "name"}), "two columns would be called 'name'")
fails_with("mean of text", lambda(): df.mean("name"), "not a number")
fails_with("unknown aggregation", lambda(): df.group_by("team").agg({"age": "mode"}), "unknown aggregation 'mode'")
fails_with("agg of a missing column", lambda(): df.group_by("team").agg({"height": "sum"}), "no column 'height'")
fails_with("group by a missing column", lambda(): df.group_by("height"), "no column 'height'")
fails_with("merge on a missing column", lambda(): df.merge(teams, "city"), "no column 'city'")
fails_with("merge how", lambda(): df.merge(teams, "team", "outer"), "inner")
fails_with("to_matrix with a missing value", lambda(): df.to_matrix(["age"]), "not a number")
fails_with("to_matrix with text", lambda(): df.to_matrix(["name"]), "not a number")
fails_with("csv row width", lambda(): parse_csv("a,b\n1,2,3\n"), "data row 1 has 3 cell(s) but the header has 2")
fails_with("csv repeated header", lambda(): parse_csv("a,a\n1,2\n"), "appears twice")
fails_with("csv unclosed quote", lambda(): parse_csv("a\n\"oops\n"), "never closed")
fails_with("csv empty text", lambda(): parse_csv(""), "no header line")
fails_with("csv missing file", lambda(): read_csv(fs.join(os.temp_dir(), "glowframe_no_such_file.csv")), "no file")
fails_with("from rows of numbers", lambda(): frame_from_rows([1, 2]), "list of dicts")
fails_with("from matrix width", lambda(): frame_from_matrix([[1, 2, 3]], ["a", "b"]), "must have 2 value(s)")
fails_with("concat of nothing", lambda(): frame_concat([]), "non-empty list")

show ""
show "passed: " + str(passed) + "   failed: " + str(failed)
if failed > 0:
    os.exit(1)
end
