# Test fs module functions
show "--- fs.exists ---"
fs.write("__test_size_gl.txt", "0123456789")
show fs.exists("__test_size_gl.txt")
show fs.exists("nonexistent_file_xyz")

show "--- fs.size ---"
show fs.size("__test_size_gl.txt")
fs.remove("__test_size_gl.txt")

show "--- fs.mkdir / fs.remove ---"
fs.mkdir("__test_dir_gl")
show fs.exists("__test_dir_gl")
fs.remove("__test_dir_gl")
show fs.exists("__test_dir_gl")

show "--- fs.read / fs.write ---"
fs.write("__test_file_gl.txt", "hello glowlang")
content = fs.read("__test_file_gl.txt")
show content
fs.remove("__test_file_gl.txt")
show "fs tests passed"
