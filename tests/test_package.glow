# glowlang package: the program and every module it uses go inside the
# executable, which then runs from any folder and gets its arguments.
let dir = fs.join(os.temp_dir(), "glow_package_test_" + str(os.pid()))
fs.mkdirs(dir)
let exe = fs.join(dir, "tool")
when os.platform == "windows":
    exe = exe + ".exe"
end
try:
    let made = process.run([process.executable, "package", "tests/modules/package_tool.glow", "-o", exe], {})
    show made["code"], made["stdout"].contains("(4 files)")
    for each line in made["stdout"].split("\n"):
        when line.starts_with("  + "):
            show line.split(" (")[0]
        end
    end
    let ran = process.run([exe, "one", "two words"], {"cwd": dir})
    show ran["code"]
    show ran["stdout"].replace("\r\n", "\n").strip()
    # A packaged program finds the .env next to the executable, not in the
    # folder it is started from.
    let env_exe = fs.join(dir, "envtool")
    when os.platform == "windows":
        env_exe = env_exe + ".exe"
    end
    show process.run([process.executable, "package", "tests/modules/package_env.glow", "-o", env_exe], {})["code"]
    fs.write(fs.join(dir, ".env"), "GREETING=hello from the .env\n")
    let elsewhere = fs.join(dir, "elsewhere")
    fs.mkdirs(elsewhere)
    show process.run([env_exe], {"cwd": elsewhere})["stdout"].replace("\r\n", "\n").strip()
finally:
    fs.remove_all(dir)
end
