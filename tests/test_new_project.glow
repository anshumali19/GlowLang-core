# glowlang new: the project it writes, and that project's own tests pass.
# Also the two things the starter relies on: :name route parts and
# password hashes.
use "lib/web.glow"
use "lib/crypto.glow"
use "lib/jwt.glow"
import "dotenv"
import "re"

show "--- routes with :name parts"
func handler(req):
    return none
end
let r = Router()
r.get("/notes", handler)
r.get("/notes/:id", handler)
r.get("/notes/latest", handler)
r.del("/users/:user/notes/:id", handler)
let p = {}
show r.find_route("GET", "/notes/42", p).path, p
show r.find_route("GET", "/notes/latest").path
p = {}
show r.find_route("DELETE", "/users/ada/notes/7", p).path, p
show r.find_route("GET", "/notes/") == none, r.find_route("GET", "/notes/1/2") == none, r.find_route("POST", "/notes/1") == none

show "--- password hashes"
let h = hash.password("correct horse")
show h.starts_with("pbkdf2_sha256$600000$"), len(h.split("$"))
show hash.check_password("correct horse", h), hash.check_password("correct horsE", h)
show hash.password("correct horse") != h
# One made by Python's hashlib.pbkdf2_hmac (and Django) checks out too.
show hash.check_password("pw", "pbkdf2_sha256$1000$salt$CjglNVXON/XHKmtwP5loFOvyQfIDrxRuk9zesDHFVn4=")
show hash.check_password("x", "junk"), hash.check_password("x", "pbkdf2_sha256$0$a$b"), hash.check_password("x", none)

show "--- glowlang new"
let dir = fs.join(os.temp_dir(), "glow_new_test_" + str(os.pid()))
fs.mkdirs(dir)
# Run from here, with full paths, so the standard library is found where
# the test binary sits apart from lib/ (bin/Release on Windows CI).
func clean(t):
    return t.replace("\r\n", "\n").strip().replace(fs.join(dir, ""), "")
end
func glow(args):
    let res = process.run([process.executable] + args, {})
    return [res["code"], clean(res["stdout"]), clean(res["stderr"])]
end
let project = fs.join(dir, "notes-api")
try:
    let made = glow(["new", project])
    show made[0], made[1].split("\n")[0]
    show sorted(fs.list(project))
    show fs.read(fs.join(project, "README.md")).split("\n")[0]
    # Its own secret in .env, which .gitignore keeps out of git.
    let env_path = fs.join(project, ".env")
    let env = dotenv.parse(fs.read(env_path))
    show env["PORT"], env["DB_PATH"], re.fullmatch("[0-9a-f]{64}", env["APP_SECRET"]) is not none
    show fs.read(fs.join(project, ".gitignore")).contains(".env")
    # The app reads .env from its own folder: the port and the secret that
    # signs its tokens come from there.
    let port = 19000 + os.pid() % 1000
    fs.write(env_path, fs.read(env_path).replace("PORT=8000", "PORT=" + str(port)).replace("DB_PATH=app.db", "DB_PATH=" + fs.join(dir, "env.db")))
    let server = process.start([process.executable, "run", fs.join(project, "app.glow")], {})
    try:
        let base = "http://127.0.0.1:" + str(port)
        let up = false
        let tries = 0
        while not up and tries < 100:
            try:
                up = http.request("GET", base + "/health", {"timeout": 2})["status"] == 200
            catch e:
                os.sleep(100)
                tries = tries + 1
            end
        end
        let login = {"email": "env@example.com", "password": "correct horse"}
        http.request("POST", base + "/signup", {"body": json.stringify(login), "timeout": 10})
        let token = json.parse(http.request("POST", base + "/login", {"body": json.stringify(login), "timeout": 10})["body"])["token"]
        show up, jwt.decode(token, env["APP_SECRET"])["sub"]
    finally:
        process.kill(server)
        process.close(server)
    end
    show glow(["new", project])[2]
    show glow(["new", fs.join(dir, "bad name")])[2]
    let t = glow(["run", fs.join(project, "test_app.glow")])
    show t[0]
    show t[1]

    show "--- glowlang new --cli"
    let tool = fs.join(dir, "wc-tool")
    made = glow(["new", tool, "--cli"])
    show made[0], made[1].split("\n")[0]
    show sorted(fs.list(tool))
    let notes = fs.join(tool, "notes.txt")
    fs.write(notes, "The cat sat. The dog sat too!\nThe end.\n")
    let ran = glow(["run", fs.join(tool, "wc-tool.glow"), notes, "--top", "2"])
    show ran[0]
    # The table's width depends on the temporary folder's path: skip it.
    for each line in ran[1].split("\n"):
        when not line.starts_with("+") and not line.starts_with("|"):
            show line
        end
    end
finally:
    fs.remove_all(dir)
end
