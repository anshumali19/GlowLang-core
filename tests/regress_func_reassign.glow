# Assigning to a function's name changes what calls by that name run.
# Calls by name used to go straight to the function defined with the name,
# so `f = wrap(f)` changed `f` as a value but every call still ran the old
# function (from the top level, other functions and methods alike).
import "functools"

func twice(g):
    return lambda(x): g(g(x))
end

func inc(x):
    return x + 1
end
show inc(1)            # 2: before the assignment
inc = twice(inc)
show inc(1)            # 3

func call_inc(x):
    return inc(x)
end
show call_inc(10)      # 12

class Box:
    func get(x):
        return inc(x)
    end
end
show Box().get(100)    # 102

# A hot loop: the caller gets compiled by the JIT and must still see it.
let total = 0
for i from 1 to 2000:
    total = total + inc(i)
end
show total             # 2001000 + 2 * 2000 = 2005000

# Recursion through the new value: fib's own calls hit the cache.
let calls = 0
func fib(n):
    calls = calls + 1
    when n < 2:
        return n
    end
    return fib(n - 1) + fib(n - 2)
end
fib = cache(fib)
show fib(80)           # 23416728348467685
show calls             # 81: each n computed once

# Name = value arguments reach the function a name holds now.
func greet(name, greeting = "hello"):
    return greeting + ", " + name
end
func shout(f):
    return lambda(name, greeting = "hey"): f(name, greeting).upper()
end
greet = shout(greet)
show greet("ann")
show greet("bo", greeting = "hi")

# Assigning something that is not a function: calling it says so.
func gone():
    return 1
end
gone = 5
try:
    gone()
catch e:
    show "error: " + str(e)
end

# A function that is never assigned to is still called directly.
func plain(x):
    return x * 3
end
show plain(7)
