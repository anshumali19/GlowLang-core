func logger(req):
    show "[Middleware] Incoming connection"
    return true
end

let d1 = use_middleware(logger)

func home(req):
    let x = Dual()
    x.init(2.0, 1.0)
    let y = Dual()
    y.init(3.0, 0.0)
    let z = x.mul(y)
    
    show "Computed Gradient: ", z.grad
    
    let resp = {}
    resp["status"] = "OK"
    resp["gradient"] = z.grad
    return resp
end

let d2 = get_route("/", home)
let d3 = start_server(8080)
