# GlowLang Auto-Diff & AI Core (MVP)
class Dual:
    action init(val, grad):
        self.val = val
        self.grad = grad
    end
    
    action add(other):
        return Dual(self.val + other.val, self.grad + other.grad)
    end
    
    action mul(other):
        let res = Dual()
        res.init(self.val * other.val, self.val * other.grad + self.grad * other.val)
        return res
    end
end

let global_routes = {}
let global_middlewares = []

func use_middleware(mw):
    global_middlewares[len(global_middlewares)] = mw
end

func get_route(path, handler):
    global_routes[path] = handler
end

