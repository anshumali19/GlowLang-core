show "GlowLang Matrix Engine Test"

# 2x3 Matrix A
# [1, 2, 3]
# [4, 5, 6]
let A = tensor.create(6)
A[0] = 1.0
A[1] = 2.0
A[2] = 3.0
A[3] = 4.0
A[4] = 5.0
A[5] = 6.0

# 3x2 Matrix B
# [7, 8]
# [9, 10]
# [11, 12]
let B = tensor.create(6)
B[0] = 7.0
B[1] = 8.0
B[2] = 9.0
B[3] = 10.0
B[4] = 11.0
B[5] = 12.0

show "Matrix A (2x3): ", A
show "Matrix B (3x2): ", B

# Matrix Multiplication (A * B)
# Result should be 2x2
# [1*7+2*9+3*11, 1*8+2*10+3*12]  => [58, 64]
# [4*7+5*9+6*11, 4*8+5*10+6*12]  => [139, 154]
let C = tensor.matmul(A, 2, 3, B, 3, 2)
show "A * B Result (2x2): ", C

# Transpose A
let At = tensor.transpose(A, 2, 3)
show "Transpose of A (3x2): ", At
