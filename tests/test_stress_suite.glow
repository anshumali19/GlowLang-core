# ---------- 10. SQLite/ORM ----------
show ""
show "--- [10/11] SQLite/ORM Tests ---"

func test_sqlite_basic():
    let db = sqlite.open("stress_test.db")
    sqlite.exec(db, "DROP TABLE IF EXISTS stress_items")
    sqlite.exec(db, "CREATE TABLE stress_items (id INTEGER PRIMARY KEY, name TEXT, value REAL)")
    
    let i = 0
    while i < 100:
        let sql = "INSERT INTO stress_items (name, value) VALUES ('item_" + i + "', " + i + ".0)"
        sqlite.exec(db, sql)
        i = i + 1
    end
    
    let rows = sqlite.query(db, "SELECT COUNT(*) as cnt FROM stress_items")
    show "  SQLite bulk insert (100 rows): OK"
    sqlite.close(db)
    return true
end

total_tests = total_tests + 1
when test_sqlite_basic():
    passed_tests = passed_tests + 1
end

func test_sqlite_transactions():
    let db = sqlite.open("stress_test_tx.db")
    sqlite.exec(db, "DROP TABLE IF EXISTS tx_test")
    sqlite.exec(db, "CREATE TABLE tx_test (id INTEGER PRIMARY KEY, val INTEGER)")
    
    sqlite.exec(db, "BEGIN TRANSACTION")
    let i = 0
    while i < 50:
        sqlite.exec(db, "INSERT INTO tx_test (val) VALUES (" + i + ")")
        i = i + 1
    end
    sqlite.exec(db, "COMMIT")
    
    let rows = sqlite.query(db, "SELECT COUNT(*) as cnt FROM tx_test")
    show "  SQLite transactions: OK"
    sqlite.close(db)
    return true
end

total_tests = total_tests + 1
when test_sqlite_transactions():
    passed_tests = passed_tests + 1
end

# ---------- 11. RECURSION STRESS ----------
show ""
show "--- [11/11] Recursion Tests ---"

func fib(n):
    when n <= 1:
        return n
    end
    return fib(n - 1) + fib(n - 2)
end

func test_recursion():
    let result = fib(20)
    when result == 6765:
        show "  Fibonacci(20): OK (6765)"
        return true
    end
    show "  Fibonacci(20): FAIL (got ", result, ")"
    return false
end

total_tests = total_tests + 1
when test_recursion():
    passed_tests = passed_tests + 1
end

func factorial(n):
    when n <= 1:
        return 1
    end
    return n * factorial(n - 1)
end

func test_factorial():
    let result = factorial(12)
    when result == 479001600:
        show "  Factorial(12): OK"
        return true
    end
    show "  Factorial(12): FAIL (got ", result, ")"
    return false
end

total_tests = total_tests + 1
when test_factorial():
    passed_tests = passed_tests + 1
end

# ========== SUMMARY ==========
show ""
show "=============================="
show "STRESS TEST RESULTS"
show "=============================="
show "Total:  ", total_tests
show "Passed: ", passed_tests
show "Failed: ", total_tests - passed_tests
show ""
when passed_tests == total_tests:
    show "ALL STRESS TESTS PASSED ✅"
otherwise:
    show "SOME TESTS FAILED ❌"
    os.exit(1)
end
