abs: 5 2.5
min/max: 1 9 apple
sum: 6 0.75 0
sorted: [1, 2, 3] [a, b, c] [3, 2, 1]
sorted by key: [a, bb, ccc]
reversed: [3, 2, 1] cba
float/bool: 2.5 3 false true false
compare: true true true true
trim: [Hello, World] HELLO, WORLD hello, world
replace: a+b+c 3
starts/ends: true true
join: x, y, z 1-2-3
lines: [a, b, c]
is_number: true false
insert: [5, 4, 3, 8]
remove: true false [5, 4, 8]
index/contains: 2 -1 true
