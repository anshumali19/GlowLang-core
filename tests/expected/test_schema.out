--- an API body
ok
  /name: must have at least 1 character
  /age: must be at least 0
  /email: must match the pattern ^[^@ ]+@[^@ ]+\.[a-z]+$
  /tags/2: must be string, not integer
  /tags: must have at most 3 items
  /tags/1: repeats item 0
  /role: must be one of ["admin", "user"]
  /extra: is not an allowed key
ok
  /: the key "name" is required
  /: the key "email" is required
  /age: must be integer, not number
  /: must be object, not array
true false
