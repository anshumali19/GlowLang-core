# GlowTensor Integration Test
use "lib/tensor_utils.glow"

show "=== Running GlowTensor Integration Test ==="

# 1. Test tensor_ones and element-wise get/set
let shape = [3, 3]
let t = tensor_ones(shape)
show "Created 3x3 tensor of ones."

# Verify initial values
let ok = true
for i from 0 to 8:
    let val = tensor.get(t, i)
    when val != 1.0:
        ok = false
    end
end

when ok:
    show "Verification of ones: PASSED"
otherwise:
    show "Verification of ones: FAILED"
end

# Test set and get
tensor.set(t, 4, 10.5)
let mid_val = tensor.get(t, 4)
show "Middle value (index 4) set to 10.5, retrieved: ", mid_val

when mid_val == 10.5:
    show "Set/Get verification: PASSED"
otherwise:
    show "Set/Get verification: FAILED"
end

# 2. Test tensor math: sum, mean, max, min
let total = tensor_sum(t, 9)
let avg = tensor_mean(t, 9)
let mx = tensor_max(t, 9)
let mn = tensor_min(t, 9)

show "Tensor sum: ", total
show "Tensor mean: ", avg
show "Tensor max: ", mx
show "Tensor min: ", mn

# Expected total: 8 * 1.0 + 10.5 = 18.5
when total == 18.5:
    show "Sum verification: PASSED"
otherwise:
    show "Sum verification: FAILED"
end

# 3. Test matrix multiplication
# A = [1 2; 3 4] (size 2x2)
# B = [5 6; 7 8] (size 2x2)
# A * B = [19 22; 43 50]
let A = tensor_from_list([1.0, 2.0, 3.0, 4.0])
let B = tensor_from_list([5.0, 6.0, 7.0, 8.0])
let C = mat_multiply(A, B, 2, 2, 2)

let c00 = tensor.get(C, 0)
let c01 = tensor.get(C, 1)
let c10 = tensor.get(C, 2)
let c11 = tensor.get(C, 3)

show "C[0,0] = ", c00, " (expected 19.0)"
show "C[0,1] = ", c01, " (expected 22.0)"
show "C[1,0] = ", c10, " (expected 43.0)"
show "C[1,1] = ", c11, " (expected 50.0)"

when c00 == 19.0 and c01 == 22.0 and c10 == 43.0 and c11 == 50.0:
    show "Matrix Multiplication verification: PASSED"
otherwise:
    show "Matrix Multiplication verification: FAILED"
end

# 4. Test matrix transpose
# A^T = [1 3; 2 4]
let AT = mat_transpose(A, 2, 2)
let t00 = tensor.get(AT, 0)
let t01 = tensor.get(AT, 1)
let t10 = tensor.get(AT, 2)
let t11 = tensor.get(AT, 3)

show "A^T[0,0] = ", t00, " (expected 1.0)"
show "A^T[0,1] = ", t01, " (expected 3.0)"
show "A^T[1,0] = ", t10, " (expected 2.0)"
show "A^T[1,1] = ", t11, " (expected 4.0)"

when t00 == 1.0 and t01 == 3.0 and t10 == 2.0 and t11 == 4.0:
    show "Matrix Transpose verification: PASSED"
otherwise:
    show "Matrix Transpose verification: FAILED"
end

show "=== GlowTensor Integration Test Finished ==="
