# floats: the floor, as a whole number
same("7.5 // 2", 7.5 // 2, 3)
same("-7.5 // 2", -7.5 // 2, -4)
same("7 // 2.5", 7 // 2.5, 2)
same("0.5 // 0.1 (binary floats)", 0.5 // 0.1, 4)
same("1 // 0.1", 1 // 0.1, 9)
same("-0.5 // 0.1", -0.5 // 0.1, -5)
same("0.5 % 0.1 agrees", 0.5 // 0.1 * 0.1 + 0.5 % 0.1 == 0.5, true)
# precedence: // binds like * and /, left to right
same("2 + 7 // 2", 2 + 7 // 2, 5)
same("20 // 3 // 2", 20 // 3 // 2, 3)
same("2 * 7 // 4", 2 * 7 // 4, 3)
same("-7 // 2 (unary minus first)", -7 // 2, -4)
same("2 ** 3 // 3", 2 ** 3 // 3, 2)
# //=
let n = 17
n //= 5
same("//=", n, 3)
let big = 10 ** 25
big //= 10 ** 20
same("//= big", big, 100000)
# not a comment any more
let c = 9 // 2
same("// is division, not a comment", c, 4)
# errors
func errs(f):
    try:
        f()
    catch e:
        return str(e)
    end
    return "no error"
end
same("divide by zero", errs(lambda(): 1 // 0), "Division by zero")
same("divide by zero float", errs(lambda(): 1.5 // 0.0), "Division by zero")
same("big divide by zero", errs(lambda(): (10 ** 30) // 0), "Division by zero")
same("text", errs(lambda(): "a" // 2), "Cannot apply '//' to string and int")
# hot loop (compiled)
func hot():
    let total = 0
    every i from 1 to 3000:
        total = total + i // 7 + (0 - i) // 7
    end
    return total
end
same("hot loop", hot(), -2572)
show "passed: " + str(passed) + "   failed: " + str(failed)
if failed > 0:
    os.exit(1)
end
