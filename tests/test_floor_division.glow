# Floor division // and remainder %. Every expected value is what Python
# gives (generated); integers of any size must be exact.
let passed = 0
let failed = 0
func same(name, got, want):
    if got == want and type(got) == type(want):
        passed = passed + 1
    else:
        failed = failed + 1
        show "FAIL: " + name + " (got " + str(got) + " " + type(got) + ", wanted " + str(want) + " " + type(want) + ")"
    end
end
same("0 // 1", 0 // 1, 0)
same("0 % 1", 0 % 1, 0)
same("0 // -1", 0 // -1, 0)
same("0 % -1", 0 % -1, 0)
same("0 // 2", 0 // 2, 0)
