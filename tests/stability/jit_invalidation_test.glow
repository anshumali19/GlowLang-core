show "===================================================================="
show "         GLOWLANG JIT INVALIDATION TESTING — Phase 1 Expanded"
show "===================================================================="

# ═══════════════════════════════════════════════════════════════════════
# 1. Type Guard Fallback & Deoptimization Test
# ═══════════════════════════════════════════════════════════════════════
show "1. Testing basic type guard invalidation..."

func add_values(a, b):
    return a + b
end

# Warm up JIT with integer inputs (15 iterations)
let i = 0
while i < 15:
    let temp = add_values(i, 2)
    i = i + 1
end

# Call with float values. The JIT type guard should fail,
# deoptimize back to interpreter, and run correctly.
let res_float = add_values(1.5, 2.5)
show "   Result of float addition (expected 4): ", res_float

# Call with string values.
let res_string = add_values("Hello ", "World")
show "   Result of string addition (expected Hello World): ", res_string


# ═══════════════════════════════════════════════════════════════════════
# 2. Polymorphic Shape Mutation & Property Guard Invalidation Test
# ═══════════════════════════════════════════════════════════════════════
show "2. Testing shape mutation and property guard invalidation..."

class Point:
    func init(x, y):
        self.x = x
        self.y = y
    end
end

class Point3D:
    func init(x, y, z):
        self.x = x
        self.y = y
        self.z = z
    end
end

func get_coord_x(obj):
    return obj.x
end

# Warm up get_coord_x with Point instances to JIT compile it (15 iterations)
let j = 0
while j < 15:
    let p = Point(j * 1.0, j * 2.0)
    let val = get_coord_x(p)
    j = j + 1
end

# Call with Point3D instance. The shape guard should detect different shape,
# invalidate/deoptimize, and correctly fetch the x coordinate.
let p3d = Point3D(42.0, 43.0, 44.0)
let res_x = get_coord_x(p3d)
show "   Result of Point3D x-coordinate (expected 42): ", res_x


# ═══════════════════════════════════════════════════════════════════════
# 3. Dynamic Property Injection Invalidation
# ═══════════════════════════════════════════════════════════════════════
show "3. Testing dynamic property injection guard..."

func get_dynamic_prop(obj):
    return obj.extra
end

# Create instances of Point
let pts = []
let k = 0
while k < 15:
    let p = Point(k * 1.0, k * 2.0)
    p.extra = k * 10.0
    pts = pts + [p]
    k = k + 1
end

# Warm up get_dynamic_prop with these points
for each p in pts:
    let val = get_dynamic_prop(p)
end

# Now create a point but inject a different type of property
let p_new = Point(1.0, 2.0)
p_new.extra = "dynamic_string"
let res_dynamic = get_dynamic_prop(p_new)
show "   Result of dynamic string property (expected dynamic_string): ", res_dynamic

# ═══════════════════════════════════════════════════════════════════════
# 4. Guard Invalidation with Function Redefinition (NEW)
# ═══════════════════════════════════════════════════════════════════════
show "4. Testing JIT guard invalidation with function redefinition..."

func compute(x):
    return x * 2
end

# Warm up to trigger JIT compilation
let gi = 0
while gi < 20:
    let r = compute(gi)
    gi = gi + 1
end
show "   Pre-redefine compute(5) = ", compute(5)

# Redefine the function — JIT should invalidate
func compute(x):
    return x * 3
end

let post_result = compute(5)
show "   Post-redefine compute(5) (expected 15): ", post_result

# ═══════════════════════════════════════════════════════════════════════
# 5. Deoptimization Verification — Type Transition Chain (NEW)
# ═══════════════════════════════════════════════════════════════════════
show "5. Testing deoptimization chain: int -> float -> string -> list..."

func identity(x):
    return x
end

# Phase 1: Warm with ints
let di = 0
while di < 20:
    let r = identity(di)
    di = di + 1
end
show "   identity(42) with int: ", identity(42)

# Phase 2: Switch to floats — first deopt
show "   identity(3.14) with float: ", identity(3.14)

# Phase 3: Switch to strings — second deopt
show "   identity('hello') with string: ", identity("hello")

# Phase 4: Switch to lists — third deopt
show "   identity([1,2,3]) with list: ", identity([1, 2, 3])

# Phase 5: Back to ints — should still work
show "   identity(99) back to int: ", identity(99)

# ═══════════════════════════════════════════════════════════════════════
# 6. Polymorphic Shape Mutation Under Load (NEW)
# ═══════════════════════════════════════════════════════════════════════
show "6. Testing polymorphic shape mutation under continuous load..."

class Animal:
    func init(name, legs):
        self.name = name
        self.legs = legs
    end
end

class Bird:
    func init(name, wingspan):
        self.name = name
        self.wingspan = wingspan
    end
end

class Fish:
    func init(name, depth):
        self.name = name
        self.depth = depth
    end
end

func get_name(obj):
    return obj.name
end

# Warm with Animal
let ai = 0
while ai < 20:
    let a = Animal("dog_" + ai, 4)
    let n = get_name(a)
    ai = ai + 1
end

# Rapidly alternate between shapes
let mi = 0
while mi < 100:
    if mi % 3 == 0:
        let obj = Animal("animal", 4)
        let n = get_name(obj)
    end
    if mi % 3 == 1:
        let obj = Bird("bird", 2.0)
        let n = get_name(obj)
    end
    if mi % 3 == 2:
        let obj = Fish("fish", 100.0)
        let n = get_name(obj)
    end
    mi = mi + 1
end
show "   Polymorphic shape mutation (100 alternations) completed"

# ═══════════════════════════════════════════════════════════════════════
# 7. Recursive JIT Fallback (NEW)
# ═══════════════════════════════════════════════════════════════════════
show "7. Testing recursive JIT fallback..."

func fib_recursive(n):
    if n <= 1:
        return n
    end
    return fib_recursive(n - 1) + fib_recursive(n - 2)
end

# Warm up with small values
let fi = 0
while fi < 20:
    let r = fib_recursive(5)
    fi = fi + 1
end

# Now compute larger values that stress the JIT's recursive handling
let fib_10 = fib_recursive(10)
let fib_15 = fib_recursive(15)
show "   fib(10) = ", fib_10, " (expected 55)"
show "   fib(15) = ", fib_15, " (expected 610)"

# ═══════════════════════════════════════════════════════════════════════
# 8. Fast-Path Rollback Under Exception (NEW)
# ═══════════════════════════════════════════════════════════════════════
show "8. Testing fast-path rollback under exception..."

func safe_divide(a, b):
    if b == 0:
        throw "division by zero"
    end
    return a / b
end

# Warm up with valid divisions
let sd = 0
while sd < 20:
    let r = safe_divide(sd * 10, sd + 1)
    sd = sd + 1
end

# Now trigger exception — JIT must deopt and let exception propagate
try:
    let bad_result = safe_divide(100, 0)
    show "   [ERROR] Should have thrown!"
catch e:
    show "   [PASS] Caught exception after JIT: ", e
end

# Verify recovery — JIT should work again with valid input
let recovery = safe_divide(100, 5)
show "   Recovery after exception (expected 20): ", recovery

# ═══════════════════════════════════════════════════════════════════════
# 9. JIT with Closure Captures (NEW)
# ═══════════════════════════════════════════════════════════════════════
show "9. Testing JIT with closure captures..."

func make_multiplier(factor):
    let f = factor
    return lambda(x): x * f
end

let double_fn = make_multiplier(2)
let triple_fn = make_multiplier(3)

# Warm up double_fn
let ci = 0
while ci < 20:
    let r = double_fn(ci)
    ci = ci + 1
end

# Now call triple_fn — different closure, different captured value
let d_result = double_fn(10)
let t_result = triple_fn(10)
show "   double(10) = ", d_result, " (expected 20)"
show "   triple(10) = ", t_result, " (expected 30)"

# ═══════════════════════════════════════════════════════════════════════
# 10. JIT Specialization with Method Dispatch (NEW)
# ═══════════════════════════════════════════════════════════════════════
show "10. Testing JIT with method dispatch polymorphism..."

class Calculator:
    func init(base):
        self.base = base
    end

    func compute(x):
        return self.base + x
    end
end

class MultCalculator:
    func init(base):
        self.base = base
    end

    func compute(x):
        return self.base * x
    end
end

func call_compute(obj, val):
    return obj.compute(val)
end

# Warm with Calculator
let calc = Calculator(10)
let cai = 0
while cai < 20:
    let r = call_compute(calc, cai)
    cai = cai + 1
end

# Switch to MultCalculator — different method implementation
let mcalc = MultCalculator(10)
let mc_result = call_compute(mcalc, 5)
show "   Calculator.compute(5) with base=10: ", call_compute(calc, 5), " (expected 15)"
show "   MultCalculator.compute(5) with base=10: ", mc_result, " (expected 50)"

# ═══════════════════════════════════════════════════════════════════════
# 11. JIT Warmup Threshold Boundary (NEW)
# ═══════════════════════════════════════════════════════════════════════
show "11. Testing JIT warmup threshold boundary..."

func threshold_func(n):
    return n + 1
end

# Call exactly at and around the JIT threshold
# GlowLang typically JITs after ~10 calls
let ti = 0
while ti < 25:
    let r = threshold_func(ti)
    if ti == 9:
        show "   At call 10: ", r
    end
    if ti == 10:
        show "   At call 11 (post-threshold): ", r
    end
    if ti == 14:
        show "   At call 15: ", r
    end
    ti = ti + 1
end

# Now call with different type right at the boundary
show "   Post-threshold with string: ", threshold_func("test")
show "   Post-threshold with float: ", threshold_func(1.5)

# ═══════════════════════════════════════════════════════════════════════
# 12. JIT with List Operations (NEW)
# ═══════════════════════════════════════════════════════════════════════
show "12. Testing JIT with list operations..."

func sum_list(lst):
    let total = 0
    let idx = 0
    while idx < len(lst):
        total = total + lst[idx]
        idx = idx + 1
    end
    return total
end

# Warm up with small lists
let li = 0
while li < 20:
    let r = sum_list([1, 2, 3])
    li = li + 1
end

# Test with different list sizes
show "   sum_list([1,2,3]) = ", sum_list([1, 2, 3]), " (expected 6)"
show "   sum_list([10, 20, 30, 40, 50]) = ", sum_list([10, 20, 30, 40, 50]), " (expected 150)"
show "   sum_list([]) = ", sum_list([]), " (expected 0)"
show "   sum_list([42]) = ", sum_list([42]), " (expected 42)"

show "===================================================================="
show "         JIT INVALIDATION TESTS COMPLETED (12 sections)"
show "===================================================================="
