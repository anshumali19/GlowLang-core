# Sets (set(), {a, b}, | & - ^, methods, in, len, loops) and set / dict
# comprehensions. Items keep the order they were added in.
let s = set([3, 1, 3, 2])
show s, len(s), type(s), 2 in s, 9 in s, set(), {}
s.add(5)
s.add(1)
s.remove(3)
s.discard(42)
show s, s.has(5), s.to_list(), sorted(s), min(s), max(s), sum(s)
let a = {1, 2, 3}
let b = {3, 4}
show a | b, a & b, a - b, a ^ b, a.union([9]), a.intersection(b), a.difference(b), a.symmetric_difference(b)
show {1, 2} == {2, 1}, {1} == {1, 2}, {1, 1.0, "1"}, {true, 1}, {none}
show {1, 2}.is_subset({1, 2, 3}), {1, 2, 3}.is_superset({2}), {1}.is_disjoint({2})
show set("hello"), set({"a": 1, "b": 2}), {...[1, 2], 3, ...{4}}
let squares = {x * x for each x in [-2, -1, 0, 1, 2]}
show squares
let evens = {x for x in range(10) when x % 2 == 0}
show evens
let d = {w: len(w) for each w in ["a", "bb", "ccc"]}
show d, {k: d[k] * 10 for each k in d.keys() when d[k] > 1}
let total = 0
for each x in {10, 20, 30}:
    total = total + x
end
show total
let c = a.copy()
c.add(100)
show a, c
c.clear()
show c, c.is_empty()
show 2 ** 70 in {2 ** 70}, 2.5 in {2.5}, (1 << 3) in {8.0}
class K:
    func init(n):
        self.n = n
    end
end
let k1 = K(1)
show len({k1, k1, K(1)}), k1 in {k1}
func hot(n):
    let seen = set()
    every i from 1 to n:
        seen.add(i % 100)
    end
    return len(seen)
end
show hot(10000)
try:
    set([[1]])
catch e:
    show e
end
try:
    s.remove(77)
catch e:
    show e
end
try:
    show {1} - [1]
catch e:
    show e
end
