# humanize.bytes, duration, ago, ordinal and slug (lib/humanize.glow).
import "humanize"
import "datetime"

show "--- bytes"
for each n in [0, 1, 999, 1000, 1536000, 999950, 1000000000, 123456789012345, -2048]:
    show n, humanize.bytes(n), humanize.bytes(n, true)
end
show humanize.bytes(10 ** 30)

show "--- duration"
for each s in [0, 0.4, 1, 59, 60, 61, 3600, 3725, 3605, 86399, 90061, 31536000, 40000000, -90]:
    show s, humanize.duration(s)
end
show humanize.duration(90061, 3), humanize.duration(90061, 1)

show "--- ago"
let now = datetime.create(2026, 11, 25, 12, 0, 0, 0, 0)
for each t in [now, now.add_seconds(-9), now.add_seconds(-45), now.add_minutes(-5), now.add_hours(-26), now.add_days(-400), now.add_days(3), now.add_seconds(30)]:
    show humanize.ago(t, now)
end
show humanize.ago(datetime.now())

show "--- ordinal"
let ords = []
for each n in [0, 1, 2, 3, 4, 11, 12, 13, 21, 22, 23, 101, 111, 112, 1003, -1, -12]:
    ords.push(humanize.ordinal(n))
end
show ords

show "--- slug"
for each t in ["Hello, World!", "  Héllo   Wörld  ", "Straße & Œuvre", "C++ / C# -- 2026", "already-a-slug", "日本語", "", "---", "Ünïcödé--Tëxt__here"]:
    show json.stringify(humanize.slug(t))
end
