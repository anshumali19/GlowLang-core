# Slice assignment (it used to store the whole list as one item:
# a[1:3] = [9] gave [1, [9], 3, 4, 5]), min/max with a key function (they
# returned the list itself), and values that cannot be compared (they were
# put in some order anyway). Results match Python's.
let a = [1, 2, 3, 4, 5]
a[1:3] = [9]
show a
a[1:1] = ["x", "y"]
show a
a[:] = [0, 0]
show a
let b = [0, 1, 2, 3, 4, 5]
b[::2] = ["a", "b", "c"]
show b
b[::-1] = [6, 5, 4, 3, 2, 1]
show b
b[-2:] = []
show b
b[10:] = [99]
show b
let c = [1, 2, 3]
c[1:] = c
show c
func f(xs):
    xs[0:2] = [xs[1], xs[0]]
    return xs
end
show f([7, 8, 9])
let grid = [[1, 2, 3], [4, 5, 6]]
grid[1][0:2] = [0]
show grid

try:
    b[::2] = [1]
catch e:
    show e
end
try:
    let s = "abc"
    s[0:1] = ["z"]
catch e:
    show e
end
try:
    b[0:1] = "z"
catch e:
    show e
end
try:
    b[0:1:0] = []
catch e:
    show e
end

# min / max
show max(["bb", "a", "ccc"], lambda(s): len(s)), min(["bb", "a", "ccc"], lambda(s): len(s))
show max([{"n": 2}, {"n": 5}, {"n": 5}], lambda(d): d.n), min([3, -4, 2], abs)
show max([3, 1, 2]), min(4, 2, 8), max([[1, 2], [1, 3]]), max(["b", "a"]), max(2, 7.5)
try:
    show max(1, "a")
catch e:
    show e
end
try:
    show min([3, none])
catch e:
    show e
end
try:
    show max([])
catch e:
    show e
end

# sorting values that cannot be compared
show sorted([3, 1, 2]), sorted(["b", "a"]), sorted([2.5, 1, true])
try:
    show sorted([3, "a", 1])
catch e:
    show e
end
try:
    let mixed = [none, 1]
    mixed.sort()
catch e:
    show e
end
