# toml.parse and toml.read (lib/toml.glow).
import "toml"

show "--- a config file"
let text = "# app settings\ntitle = \"Glow \\\"shop\\\"\"   # trailing comment\nport = 8_080\ndebug = false\nratio = 0.75\n\n[database]\nurl = 'sqlite:///C:\\data\\app.db'\npool = { min = 1, max = 10 }\ntags = [\n  \"a\",  # first\n  \"b\",\n]\n\n[servers.alpha]\nip = \"10.0.0.1\"\n\n[[users]]\nname = \"ana\"\nroles = [\"admin\", \"dev\"]\n\n[[users]]\nname = \"bo\"\n[users.prefs]\ntheme = \"dark\"\n"
let c = toml.parse(text)
show c["title"], c["port"], c["debug"], c["ratio"]
show c["database"]
show c["servers"]
show c["users"]

show "--- keys"
show toml.parse("a.b.c = 1\na.b.d = 2\n\"quoted key\" = 3\n'lit.key' = 4\nsite.\"google.com\" = true\n-dash_ = 5\n1234 = 6")

show "--- strings"
let s = toml.parse("a = \"tab\\there\\u00e9\\U0001F600\"\nb = 'C:\\no\\escapes'\nc = \"\"\"\nline one\nline two\"\"\"\nd = \"\"\"joined \\\n     here\"\"\"\ne = '''\nraw \\n text\n'''\nf = \"\"\"two \"\"quotes\"\"\"\"\"\ng = \"\"\nh = \"é ü 😀\"")
for each k in s.keys():
    show k, json.stringify(s[k])
end

show "--- numbers"
let n = toml.parse("a = +99\nb = -17\nc = 0\nd = 1_000_000\ne = 0xDEAD_beef\nf = 0o755\ng = 0b1101\nh = 3.14\ni = -0.01\nj = 5e+22\nk = 6.626e-34\nl = inf\nm = -inf\no = nan\np = 9_223_372_036_854_775_807")
for each k in n.keys():
    show k, n[k], type(n[k])
end

show "--- dates stay text"
show toml.parse("a = 1979-05-27T07:32:00Z\nb = 1979-05-27 07:32:00-07:00\nc = 1979-05-27\nd = 07:32:00")

show "--- arrays and inline tables"
show toml.parse("a = [ [1, 2], [\"x\"], [] ]\nb = [{ x = 1 }, { y.z = 2 }]\nc = {}\nd = [\n]\n")

show "--- line endings"
show toml.parse("a = 1\r\n[t]\r\nb = \"\"\"x\r\ny\"\"\"\r\n")
show toml.parse(""), toml.parse("# only a comment\n\n")

show "--- files"
let path = "test_toml_tmp.toml"
try:
    fs.write(path, "[server]\nport = 9000\n")
    show toml.read(path)
    try:
        toml.read("no_such_file.toml")
    catch e:
        show e
    end
finally:
    fs.remove(path)
end

show "--- the quick reader and the full parser agree"
# toml.parse reads with parse_tokens first and gives up to parse on
# anything it does not cover; both must give the same dict.
let doc = "# c\ntitle = \"T\" # c\n[a.b]\nx = 1\ny.z = [1, 2.5, \"s\", 'lit', [true], {p = 1, q = \"r\"}]\n[[arr]]\nk = 1979-05-27T07:32:00Z\n[[arr]]\nm = \"\"\"\nline\none\"\"\"\nn = '''raw \\ text'''\n\"quoted key\" = 0x1F\n"
show json.stringify(_TomlParser(doc).parse_tokens()) == json.stringify(_TomlParser(doc).parse())
show toml.parse(doc)
# Left to the full parser: an escape, and a date and time with a space.
show toml.parse("a = \"tab\\there\"\nd = 1979-05-27 07:32:00\n")
for each give_up in ["[ [a]]", "[[a] ]", "a = \"x\\ty\"", "\"q\".k = 1"]:
    try:
        _TomlParser(give_up).parse_tokens()
        show "read", json.stringify(give_up)
    catch e:
        show e
    end
end

show "--- errors"
for each bad in ["a = 1\na = 2", "[t]\n[t]", "a = 1\n[a]", "a = 1\na.b = 2", "a = \"open", "a = \"x\ny\"", "a = 'open", "a = \"\"\"open", "a = 01", "a = 1__0", "a = _1", "a = [1 2]", "a = {x = 1", "a = 1 b = 2", "= 1", "a 1", "a = ", "a = \"\\q\"", "a = \"\\uD800\"", "[t", "[[t]\n", "x = 1\n[[x]]", "[a]\n[[a]]", "a = truth", "a = 1.2.3"]:
    try:
        toml.parse(bad)
        show "allowed", json.stringify(bad)
    catch e:
        show e
    end
end

show "--- writing"
let data = {"title": "Example", "n": 3, "pi": 3.0, "ok": true, "tags": ["a", "b"], "odd key": "x\ty\"", "café": chr(127), "empty": [], "mixed": [1, {"a": 2, "b": {}}], "server": {"host": "h", "port": 80, "tls": {"on": false}}, "deep": {"a": {"b": {"c": 1}}}, "users": [{"name": "ana", "roles": {"admin": true}}, {}], "blank": {}}
let text = toml.stringify(data)
show text
show json.stringify(toml.parse(text)) == json.stringify(data), type(toml.parse(text)["pi"])
show json.stringify(toml.stringify({}))
show toml.stringify({"f": 1e20, "g": -0.5, "i": math.inf, "j": -math.inf, "k": math.nan, "big": 12345678901234})
let out_path = "test_toml_out.toml"
try:
    toml.write(out_path, {"server": {"port": 9000}})
    show toml.read(out_path)
finally:
    fs.remove(out_path)
end
for each bad in [{"a": none}, {"t": {"a": [1, none]}}, {"f": len}, [1], "x"]:
    try:
        toml.stringify(bad)
        show "allowed"
    catch e:
        show e
    end
end
