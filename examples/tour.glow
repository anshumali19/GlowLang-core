# tour.glow: every example from docs/glowlang_in_10_minutes.md, in order.
# Run it with:  glowlang examples/tour.glow

# 1. Values
let name = "Glow"
let year = 2026
let pi = 3.14159
let ready = true
let nothing = none
show f"Hello, {name}! It is {year}."

# 2. Lists and dicts
let langs = ["C", "Python", "GlowLang"]
langs.append("Rust")
show langs[2]
show len(langs)
show langs[1:3]

let ages = {"ada": 36, "linus": 21}
ages["grace"] = 85
show ages["grace"]
show "ada" in ages

# 3. Decisions: two spellings, one meaning
let score = 72
if score >= 90:
    show "A"
eif score >= 70:
    show "B"
else:
    show "C"
end

when score >= 90:
    show "A"
eif score >= 70:
    show "B"
otherwise:
    show "C"
end

# 4. Loops
for each lang in langs:
    show "I know " + lang
end

every i from 1 to 3:
    show i * i
end

let n = 0
while n < 10:
    n = n + 3
end
show n

# 5. Functions
func area(w, h = 1):
    return w * h
end
show area(3, 4)
show area(5)

let double = lambda(x): x * 2
show double(21)

func fib(k):
    if k < 2:
        return k
    end
    return fib(k - 1) + fib(k - 2)
end
show fib(25)

# 6. Classes
class Counter:
    func init(start):
        self.count = start
    end

    func tick():
        self.count = self.count + 1
        return self
    end
end

let c = Counter(10)
c.tick().tick()
show c.count

# 7. Errors
func safe_div(a, b):
    try:
        if b == 0:
            throw "cannot divide by zero"
        end
        return a / b
    catch e:
        show "caught: " + str(e)
        return none
    end
end
show safe_div(10, 4)
show safe_div(1, 0)

# 8. Batteries included
use "glownum"
show gnum.mean([1, 2, 3, 4])
show gnum.dot([[1, 2], [3, 4]], [[1], [1]])

use "glowtext"
show most_common(tokenize("the cat and the hat and the bat"), 2)
