# ORM & Database Demo
# Demonstrates SQLite ORM operations in GlowLang (lib/orm.glow)

use "lib/orm.glow"

show "=== GlowLang ORM Demo ==="

# Create a database
let db = ORM("demo.db")

# Create table
db.exec_sql("DROP TABLE IF EXISTS users")
db.exec_sql("CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT, email TEXT, age INTEGER)")

# Insert records
db.insert("users", {"name": "Alice", "email": "alice@example.com", "age": 30})
db.insert("users", {"name": "Bob", "email": "bob@example.com", "age": 25})
db.insert("users", {"name": "Charlie", "email": "charlie@example.com", "age": 35})

show "Inserted 3 users"

# Query all users
let results = db.exec_raw("SELECT name, email, age FROM users")
show "All users:"
every row in results:
    show "  " + row["name"] + " <" + row["email"] + ">, age " + row["age"]
end

# Query with condition
let young = db.exec_raw("SELECT name, age FROM users WHERE age < 30")
show ""
show "Users under 30:"
every row in young:
    show "  " + row["name"] + " (" + row["age"] + ")"
end

# Update
db.exec_sql("UPDATE users SET age = 31 WHERE name = 'Alice'")
show ""
show "Updated Alice's age to 31"

# Count
show "Total users: " + db.count("users")

# Cleanup
db.close()
fs.remove("demo.db")
show ""
show "Database demo complete."
