show "[String Processing] Testing supported string operations..."

let s1 = "Glow"
let s2 = "Lang"
let combined = s1 + s2
show "Concatenated string: ", combined
show "Length of combined string: ", len(combined)

show "Using text_builder to construct a string:"
let sb = text_builder()
append(sb, "Hello ")
append(sb, "from ")
append(sb, "GlowLang!")
let result = build(sb)
show "Built result: ", result
