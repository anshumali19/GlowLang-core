# subprocess.glow
# Natural Language Subprocess Execution for GlowLang, built on the native
# `process` module (process.run / process.start).

class ProcessResult:
    func init(code, output):
        self.code = code
        self.output = output
    end

    func display():
        show "--- Process Result ---"
        show "Exit Code: ", self.code
        show "Output: "
        show self.output
        show "----------------------"
    end
end

class SubprocessManager:
    func init():
    end

    # command: a string (run by the system shell) or a list of program and
    # arguments (run directly, no shell). With capture_output the program's
    # stdout and stderr are returned in output; otherwise they go to the
    # terminal.
    func run(command, capture_output):
        if capture_output == true:
            let r = process.run(command, {"stderr": "stdout"})
            let res = ProcessResult()
            res.init(r["code"], r["stdout"])
            return res
        else:
            let r = process.run(command, {"stdout": "inherit", "stderr": "inherit"})
            let res = ProcessResult()
            res.init(r["code"], "")
            return res
        end
    end
end

let sys_cmd = SubprocessManager()
sys_cmd.init()
