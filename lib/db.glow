# db.glow — a small SQLite helper: create a table from a dict of columns,
# insert dicts, read all rows. Values are always passed to SQLite as bound
# parameters, and table and column names must be plain identifiers, so data
# can never change the SQL. For queries, migrations and transactions, use
# orm.glow.

func _db_is_ident(name):
    when type(name) != "string" or len(name) == 0:
        return false
    end
    let first = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_"
    let rest = first + "0123456789"
    when not first.contains(name[0]):
        return false
    end
    let i = 1
    while i < len(name):
        when not rest.contains(name[i]):
            return false
        end
        i = i + 1
    end
    return true
end

# A table or column name, quoted for SQL; anything else is refused.
func _db_ident(name):
    when not _db_is_ident(name):
        throw "db: invalid table or column name: " + str(name)
    end
    return "\"" + name + "\""
end

blueprint Model:
    action init(db_path):
        self.db = sqlite.open(db_path)
        when self.db is none:
            throw "db: cannot open " + str(db_path)
        end
    end

    # schema: {"name": "TEXT", "age": "INTEGER"}; an id primary key is added.
    action create_table(table_name, schema):
        let sql = "CREATE TABLE IF NOT EXISTS " + _db_ident(table_name) + " (id INTEGER PRIMARY KEY AUTOINCREMENT"
        when type(schema) == "dict":
            for each k in schema.keys():
                let col_type = schema[k]
                when not _db_is_ident(col_type):
                    throw "db: invalid column type for " + k + ": " + str(col_type)
                end
                sql = sql + ", " + _db_ident(k) + " " + col_type
            end
        end
        sqlite.exec(self.db, sql + ")")
    end

    # Insert a dict of column values; returns the new row's id.
    action insert(table_name, data):
        when type(data) != "dict" or len(data) == 0:
            throw "db: insert needs a dict of column values"
        end
        let cols = []
        let marks = []
        let values = []
        for each k in data.keys():
            cols.append(_db_ident(k))
            marks.append("?")
            values.append(data[k])
        end
        sqlite.exec(self.db, "INSERT INTO " + _db_ident(table_name) + " (" + cols.join(", ") + ") VALUES (" + marks.join(", ") + ")", values)
        return sqlite.last_insert_id(self.db)
    end

    action find_all(table_name):
        return sqlite.query(self.db, "SELECT * FROM " + _db_ident(table_name) + " ORDER BY id")
    end

    action close():
        sqlite.close(self.db)
    end
end
