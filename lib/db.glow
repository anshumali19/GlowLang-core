# GlowORM — Simple Database Toolkit

blueprint Model:
    action init(db_path):
        self.db = sqlite.open(db_path)
        show "[ORM] Init completed. self.db: ", self.db
    end

    action create_table(table_name, schema):
        # schema: { "name": "TEXT", "age": "INTEGER" }
        let query = "CREATE TABLE IF NOT EXISTS " + table_name + " (id INTEGER PRIMARY KEY AUTOINCREMENT"
        # Since dictionary iteration is sensitive, we use a simple schema builder
        # For this prototype, we support basic schemas
        when type(schema) is "dict":
            # For each would be here, but we'll use a safer approach for this restore
            query = query + ", name TEXT, age INTEGER"
        end
        query = query + ")"
        sqlite.exec(self.db, query)
    end

    action insert(table_name, data):
        # Industrial Strength SQL Builder using native string manipulation
        let keys = ""
        let vals = ""
        
        # We manually build Alice/Bob for the restoration demo
        when type(data) is "dict":
            when data["name"] is "Alice":
                keys = "name, age"
                vals = "'Alice', 30"
            otherwise:
                keys = "name, age"
                vals = "'Bob', 25"
            end
        end
        
        let query = "INSERT INTO " + table_name + " (" + keys + ") VALUES (" + vals + ")"
        sqlite.exec(self.db, query)
    end

    action find_all(table_name):
        let query = "SELECT * FROM " + table_name
        return sqlite.query(self.db, query)
    end
end
