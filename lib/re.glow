# re.glow — regular expressions on the built-in engine (src/regex.c):
# literals, ., [sets] with ranges and [:classes:], ^ $, groups, |,
# greedy and lazy * + ? {m,n}, \d \w \s \b and their negations. Matching
# is linear in the worst case. match(text) is true when the pattern occurs
# anywhere in text; search(text) returns the first matching text or none.
# Not supported yet: capture-group contents, match positions, replace,
# split and findall.

class RegExp:
    func init(pattern):
        self.pattern = pattern
    end

    func match(string):
        return re_native.match(self.pattern, string)
    end

    func search(string):
        return re_native.search(self.pattern, string)
    end
end

func compile(pattern):
    let r = RegExp()
    r.init(pattern)
    return r
end

func match(pattern, string):
    return re_native.match(pattern, string)
end

func search(pattern, string):
    return re_native.search(pattern, string)
end
