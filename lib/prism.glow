# Prism: Key-Value Record Formatter
# Projects key-value streams into formatted record arrays

blueprint PrismEngine:
    action init():
        self.refracted_count = 0
    end

    action refract_record(key_str, val_str):
        self.refracted_count = self.refracted_count + 1
        let token = f"[{key_str} :=> {val_str}]"
        return token
    end

    action project_stream(keys, vals):
        let output_tokens = []
        let i = 0
        let count = len(keys)
        while i < count:
            let k = keys[i]
            let v = vals[i]
            let rec = self.refract_record(k, v)
            output_tokens = output_tokens + [rec]
            i = i + 1
        end
        return output_tokens
    end
end
