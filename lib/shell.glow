# shell.glow — run commands the way a shell script does.
#
#   import "shell"
#   let branch = sh("git rev-parse --abbrev-ref HEAD")   # output, final newline removed
#   sh("make test")                    # raises if the command fails
#   sh_run("npm install")              # output shown live; returns the exit code
#   if sh_ok("git diff --quiet"):      # true when it exits with 0
#       show "clean"
#   end
#   for each f in sh_lines("git ls-files"):
#       show f
#   end
#   let fixes = pipe([["git", "log", "--oneline"], ["grep", "fix"]])
#   sh("echo " + quote(user_text))     # safe to put in a command line
#
# A command is a string, run by /bin/sh (or cmd.exe on Windows) so pipes,
# redirection and wildcards work, or a list such as ["git", "commit", "-m",
# message], run directly with each item as one argument (no quoting
# needed, nothing interpreted). Every function also takes the options of
# process.run: {"cwd": dir, "env": {...}, "input": text, "timeout": seconds}.
#
# The same functions are reachable as shell.sh, shell.run (sh_run),
# shell.ok, shell.lines, shell.pipe, shell.quote, shell.which and
# shell.exit. Script arguments are os.args; see also os.env, os.chdir,
# fs.glob, fs.copy, fs.move, fs.mkdirs and fs.remove_all.

func _sh_opts(opts):
    let o = {}
    if opts != none:
        for each k, v in opts:
            o[k] = v
        end
    end
    return o
end

func _sh_show(cmd):
    if type(cmd) == "list":
        return cmd.join(" ")
    end
    return cmd
end

# Output with Windows line endings (\r\n) turned into \n, and the final
# newline removed.
func _sh_chomp(text):
    text = text.replace("\r\n", "\n")
    if text.ends_with("\n"):
        return text.slice(0, len(text) - 1)
    end
    return text
end

# Runs cmd and returns its output (with \n line endings) without the final
# newline. A command that
# fails (exit code not 0, or a timeout) raises, with its error output.
func sh(cmd, opts = none):
    let r = process.run(cmd, _sh_opts(opts))
    if r.timed_out:
        throw "command timed out: " + _sh_show(cmd)
    end
    if r.code != 0:
        let msg = "command failed (exit " + str(r.code) + "): " + _sh_show(cmd)
        let err = r.stderr.trim()
        if err != "":
            msg = msg + "\n" + err
        end
        throw msg
    end
    return _sh_chomp(r.stdout)
end

# Runs cmd with its output going straight to the terminal; returns the exit
# code (a failure does not raise).
func sh_run(cmd, opts = none):
    let o = _sh_opts(opts)
    o["stdout"] = "inherit"
    o["stderr"] = "inherit"
    return process.run(cmd, o).code
end

# True when cmd exits with code 0; its output is discarded.
func sh_ok(cmd, opts = none):
    let o = _sh_opts(opts)
    o["stdout"] = "null"
    o["stderr"] = "null"
    let r = process.run(cmd, o)
    return r.code == 0 and not r.timed_out
end

# The output of sh(cmd) as a list of lines (empty lines at the end dropped).
func sh_lines(cmd, opts = none):
    let out = sh(cmd, opts)
    if out == "":
        return []
    end
    return out.split("\n")
end

# Feeds each command's output to the next, without a shell (each command
# is a list or a string); returns the last one's output. Raises if any
# command fails.
func pipe(commands, opts = none):
    let data = none
    let i = 0
    for each cmd in commands:
        let o = _sh_opts(opts)
        if i > 0:
            o["input"] = data
        end
        let r = process.run(cmd, o)
        if r.code != 0:
            throw "command failed (exit " + str(r.code) + ") in pipe: " + _sh_show(cmd) + "\n" + r.stderr.trim()
        end
        data = r.stdout
        i = i + 1
    end
    if data == none:
        return ""
    end
    return _sh_chomp(data)
end

# text quoted as one argument for a command string: '...' for /bin/sh,
# "..." for cmd.exe. A list command needs no quoting at all.
func quote(text):
    let s = str(text)
    if os.platform == "windows":
        return "\"" + s.replace("\"", "\"\"") + "\""
    end
    return "'" + s.replace("'", "'\\''") + "'"
end

# The full path of a program on PATH, or none.
func which(name):
    return process.find(name)
end

let shell = {
    "sh": sh, "run": sh_run, "ok": sh_ok, "lines": sh_lines, "pipe": pipe,
    "quote": quote, "which": which, "exit": os.exit
}
