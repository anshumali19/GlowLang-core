# glowlang new <name> [--cli]: makes the folder <name> with a working
# project from the templates in lib/starter (a web API: sign-up, login,
# notes in SQLite) or, with --cli, lib/starter_cli (a command-line tool
# ready for glowlang package), each with its tests and a README.
import "cli"
import "re"

let cli_app = ArgParser("glowlang new", "Start a project: a web API (login, a database, tests), or a command-line tool with --cli")
cli_app.positional("name", "The project's folder (letters, digits, - and _)")
cli_app.flag("--cli", "A command-line tool instead of a web API")
let args = cli_app.parse_or_exit()
let name = args["name"]
let base = fs.basename(name)

when re.find("^[A-Za-z0-9_-]+$", base) == none:
    os.eprint("glowlang new: use letters, digits, - and _ in the name, not \"" + base + "\"")
    os.exit(1)
end
when fs.exists(name):
    os.eprint("glowlang new: " + name + " already exists")
    os.exit(1)
end

let lib_dir = fs.dirname(fs.abspath(os.script))
# Each template file and the name it gets in the project.
let templates = fs.join(lib_dir, "starter")
let files = [["app.glow", "app.glow"], ["test_app.glow", "test_app.glow"], ["README.md", "README.md"], ["gitignore", ".gitignore"]]
let next = ["glowlang test", "glowlang watch app.glow     (http://localhost:8000)"]
when args["--cli"]:
    templates = fs.join(lib_dir, "starter_cli")
    files = [["tool.glow", base + ".glow"], ["words.glow", "words.glow"], ["test_words.glow", "test_words.glow"], ["README.md", "README.md"]]
    next = ["glowlang test", "glowlang run " + base + ".glow README.md", "glowlang package " + base + ".glow"]
end
fs.mkdirs(name)
for each pair in files:
    fs.write(fs.join(name, pair[1]), fs.read(fs.join(templates, pair[0])).replace("__NAME__", base))
end
when not args["--cli"]:
    # Each project gets its own secret; .gitignore keeps the file out of git.
    fs.write(fs.join(name, ".env"), "# Settings for app.glow. The real environment wins over this file.\n# Keep it private: it is listed in .gitignore.\nPORT=8000\nDB_PATH=app.db\nAPP_SECRET=" + crypto.random_hex(32) + "\n")
end

let made = [p[1] for each p in files if not p[1].starts_with(".")]
show "Made " + name + "/ with " + ", ".join(made) + ". Next:"
show "  cd " + name
for each step in next:
    show "  " + step
end
