# datetime.glow — format Unix timestamps (seconds since 1970, from os.time())
# in local time with strftime codes: DateTime(os.time()).to_string(),
# .format("%Y-%m-%d"), .get_year() and the other getters. Parsing dates and
# time zones are not supported yet.

class DateTime:
    func init(timestamp):
        self.timestamp = timestamp
    end

    func format(fmt):
        return os.format_time(fmt, self.timestamp)
    end

    func to_string():
        return self.format("%Y-%m-%d %H:%M:%S")
    end

    func get_year():
        return self.format("%Y")
    end

    func get_month():
        return self.format("%m")
    end
    
    func get_day():
        return self.format("%d")
    end
end

func datetime_now():
    let dt = DateTime()
    dt.init(os.time())
    return dt
end
