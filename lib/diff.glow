# diff.glow — the differences between two texts, line by line.
#
#   import "diff"
#   diff.lines(a, b)       [[op, line], ...] with op " " (in both), "-" (only
#                          in a) or "+" (only in b)
#   diff.unified(a, b, from_name = "a", to_name = "b", context = 3)
#                          the differences in the format of diff -u and
#                          git diff, or "" when there are none
#
# a and b are texts, or lists of lines. The diff is a shortest one (Myers'
# algorithm, in linear space for large changes), as GNU diff finds; a line
# that lacks a final line break differs from the same line with one, and
# diff.unified marks it with "\ No newline at end of file", as diff -u does.

let _DIFF_MAX_EDITS = 5000
let _DIFF_QUICK_EDITS = 200

# The lines of a text, each with its line break; a list of lines gets one.
func _diff_split(value):
    let lines = []
    when type(value) == "list":
        for each line in value:
            lines.push(str(line) + "\n")
        end
        return lines
    end
    let parts = value.split("\n")
    let i = 0
    while i < len(parts) - 1:
        lines.push(parts[i] + "\n")
        i = i + 1
    end
    when parts[len(parts) - 1] != "":
        lines.push(parts[len(parts) - 1])
    end
    return lines
end

# Myers' algorithm on a[sa:ea] against b[sb:eb], keeping every round: the
# ops, as [op, line], or none past _DIFF_QUICK_EDITS edits. Its memory grows
# with the square of the edits, so past that _diff_middle splits the work.
func _diff_rounds(a, sa, ea, b, sb, eb):
    let n = ea - sa
    let m = eb - sb
    let v = {"1": 0}
    let trace = []
    let found = false
    let d = 0
    while d <= n + m and not found:
        when d > _DIFF_QUICK_EDITS:
            return none
        end
        trace.push(v.copy())
        let k = -d
        while k <= d:
            let x = 0
            when k == -d or (k != d and v[str(k - 1)] < v[str(k + 1)]):
                x = v[str(k + 1)]
            otherwise:
                x = v[str(k - 1)] + 1
            end
            let y = x - k
            while x < n and y < m and a[sa + x] == b[sb + y]:
                x = x + 1
                y = y + 1
            end
            v[str(k)] = x
            when x >= n and y >= m:
                found = true
                stop
            end
            k = k + 2
        end
        when not found:
            d = d + 1
        end
    end
    # Walk back from the end through the saved rounds.
    let ops = []
    let x = n
    let y = m
    let round = d
    while round >= 0:
        let vp = trace[round]
        let k = x - y
        let prev_k = k - 1
        when k == -round or (k != round and vp[str(k - 1)] < vp[str(k + 1)]):
            prev_k = k + 1
        end
        let prev_x = vp[str(prev_k)]
        let prev_y = prev_x - prev_k
        while x > prev_x and y > prev_y:
            ops.push([" ", a[sa + x - 1]])
            x = x - 1
            y = y - 1
        end
        when round > 0:
            when x == prev_x:
                ops.push(["+", b[sb + prev_y]])
            otherwise:
                ops.push(["-", a[sa + prev_x]])
            end
        end
        x = prev_x
        y = prev_y
        round = round - 1
    end
    ops.reverse()
    return ops
end

# Myers' linear-space search on a[sa:ea] against b[sb:eb], which differ at
# their first and last lines: the middle snake of a shortest diff, as
# [x, y, u, v] (the diagonal run from a[x], b[y] to a[u], b[v]), or none
# past _DIFF_MAX_EDITS rounds from each end (twice as many edits), which
# keeps the worst case, two unrelated 20,000-line texts, near a second. Two lists of size n + m hold the furthest
# points reached from the front and from the back.
func _diff_middle(a, sa, ea, b, sb, eb):
    let n = ea - sa
    let m = eb - sb
    let delta = n - m
    let odd = delta % 2 != 0
    let limit = (n + m + 1) // 2 + 1
    let off = limit + 1
    let vf = [0] * (2 * off + 1)
    let vb = [0] * (2 * off + 1)
    let d = 0
    while d < limit:
        when d > _DIFF_MAX_EDITS:
            return none
        end
        # From the front: x counts lines of a taken, k = x - y.
        let k = -d
        while k <= d:
            let x = 0
            when k == -d or (k != d and vf[off + k - 1] < vf[off + k + 1]):
                x = vf[off + k + 1]
            otherwise:
                x = vf[off + k - 1] + 1
            end
            let y = x - k
            let x0 = x
            let y0 = y
            while x < n and y < m and a[sa + x] == b[sb + y]:
                x = x + 1
                y = y + 1
            end
            vf[off + k] = x
            let r = delta - k
            when odd and r >= 1 - d and r <= d - 1 and x + vb[off + r] >= n:
                return [sa + x0, sb + y0, sa + x, sb + y]
            end
            k = k + 2
        end
        # From the back: x counts lines of a taken from the end.
        k = -d
        while k <= d:
            let x = 0
            when k == -d or (k != d and vb[off + k - 1] < vb[off + k + 1]):
                x = vb[off + k + 1]
            otherwise:
                x = vb[off + k - 1] + 1
            end
            let y = x - k
            let x0 = x
            let y0 = y
            while x < n and y < m and a[ea - x - 1] == b[eb - y - 1]:
                x = x + 1
                y = y + 1
            end
            vb[off + k] = x
            let f = delta - k
            when not odd and f >= -d and f <= d and x + vf[off + f] >= n:
                return [ea - x, eb - y, ea - x0, eb - y0]
            end
            k = k + 2
        end
        d = d + 1
    end
    return none
end

# The ops of a[sa:ea] against b[sb:eb], added to ops; true when the work
# was split, which can put additions before removals.
func _diff_into(ops, a, sa, ea, b, sb, eb):
    while sa < ea and sb < eb and a[sa] == b[sb]:
        ops.push([" ", a[sa]])
        sa = sa + 1
        sb = sb + 1
    end
    let tail = 0
    while ea > sa and eb > sb and a[ea - 1] == b[eb - 1]:
        ea = ea - 1
        eb = eb - 1
        tail = tail + 1
    end
    let quick = none
    let snake = none
    let split = false
    when sa < ea and sb < eb:
        quick = _diff_rounds(a, sa, ea, b, sb, eb)
        when quick is none:
            snake = _diff_middle(a, sa, ea, b, sb, eb)
        end
    end
    when quick is not none:
        ops.extend(quick)
    eif snake is not none:
        split = true
        _diff_into(ops, a, sa, snake[0], b, sb, snake[1])
        every i from snake[0] to snake[2] - 1:
            ops.push([" ", a[i]])
        end
        _diff_into(ops, a, snake[2], ea, b, snake[3], eb)
    otherwise:
        # Only removals or only additions are left, or, past the edit limit,
        # the middle is reported as all removed and all added.
        every i from sa to ea - 1:
            ops.push(["-", a[i]])
        end
        every i from sb to eb - 1:
            ops.push(["+", b[i]])
        end
    end
    every i from ea to ea + tail - 1:
        ops.push([" ", a[i]])
    end
    return split
end

# The ops with each line still holding its line break.
func _diff_ops(a, b):
    let ops = []
    when not _diff_into(ops, a, 0, len(a), b, 0, len(b)):
        return ops
    end
    # In each run of changes the removals come first, as diff -u prints them.
    let out = []
    let added = []
    for each op in ops:
        when op[0] == "+":
            added.push(op)
        otherwise:
            when op[0] == " " and len(added) > 0:
                out.extend(added)
                added = []
            end
            out.push(op)
        end
    end
    out.extend(added)
    return out
end

func _diff_text(line):
    when line.ends_with("\n"):
        return line.slice(0, -1)
    end
    return line
end

func diff_lines(a, b):
    let out = []
    for each op in _diff_ops(_diff_split(a), _diff_split(b)):
        out.push([op[0], _diff_text(op[1])])
    end
    return out
end

func _diff_range(start, count):
    when count == 1:
        return str(start)
    end
    when count == 0:
        return str(start) + ",0"
    end
    return str(start) + "," + str(count)
end

func diff_unified(a, b, from_name = "a", to_name = "b", context = 3):
    let ops = _diff_ops(_diff_split(a), _diff_split(b))
    let changes = []
    let i = 0
    while i < len(ops):
        when ops[i][0] != " ":
            changes.push(i)
        end
        i = i + 1
    end
    when len(changes) == 0:
        return ""
    end
    # Lines of a and of b before each op.
    let a_at = []
    let b_at = []
    let na = 0
    let nb = 0
    for each op in ops:
        a_at.push(na)
        b_at.push(nb)
        when op[0] != "+":
            na = na + 1
        end
        when op[0] != "-":
            nb = nb + 1
        end
    end
    a_at.push(na)
    b_at.push(nb)
    let out = ["--- " + from_name + "\n", "+++ " + to_name + "\n"]
    let g = 0
    while g < len(changes):
        let first = changes[g]
        let last = first
        while g + 1 < len(changes) and changes[g + 1] - last <= 2 * context + 1:
            g = g + 1
            last = changes[g]
        end
        g = g + 1
        let lo = max(0, first - context)
        let hi = min(len(ops), last + context + 1)
        let a_count = a_at[hi] - a_at[lo]
        let b_count = b_at[hi] - b_at[lo]
        let a_start = a_at[lo]
        when a_count > 0:
            a_start = a_start + 1
        end
        let b_start = b_at[lo]
        when b_count > 0:
            b_start = b_start + 1
        end
        out.push("@@ -" + _diff_range(a_start, a_count) + " +" + _diff_range(b_start, b_count) + " @@\n")
        every j from lo to hi - 1:
            let line = ops[j][1]
            out.push(ops[j][0] + line)
            when not line.ends_with("\n"):
                out.push("\n\\ No newline at end of file\n")
            end
        end
    end
    return out.join("")
end

let diff = {"lines": diff_lines, "unified": diff_unified}
