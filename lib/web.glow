# GlowWeb — a small web framework: router, middleware, request/response
# objects, JSON helpers and static files (with path traversal blocked).
# Each connection gets a thread, and threads take turns under the GIL; a
# connection stays open for the client's next request (keep-alive). It
# speaks plain HTTP: in production put it behind a reverse proxy (nginx,
# Caddy) for TLS, compression and load balancing.
# String methods: .split() .contains() .find() .slice()

use "websocket"

# ─── String Helpers ───
func _ends_with(s, suffix):
    let slen = len(s)
    let plen = len(suffix)
    when plen > slen:
        return false
    end
    let tail = s.slice(slen - plen, slen)
    return tail == suffix
end

# Calls a handler or hook with the arguments it takes: f(req) or f(req, res).
func _web_call(f, req, res):
    when __glow_params(f) == 1:
        return f(req)
    end
    return f(req, res)
end

# ─── Request Parser ───
blueprint Request:
    action init(raw):
        self.raw = raw
        self.method = ""
        self.path = ""
        self.query_string = ""
        self.query_params = {}
        self.headers = {}
        self.body = ""
        self.params = {}
        self.context = {}
        self._parse()
    end

    action _parse():
        when self.raw is none:
            return none
        end
        when len(self.raw) == 0:
            return none
        end

        # Split by double newline to get headers and body (support both \r\n and \n)
        let body_pos = self.raw.find("\r\n\r\n")
        let split_len = 4
        let line_split = "\r\n"
        
        when body_pos < 0:
            body_pos = self.raw.find("\n\n")
            split_len = 2
            line_split = "\n"
        end

        let header_section = self.raw
        when body_pos >= 0:
            header_section = self.raw.slice(0, body_pos)
            self.body = self.raw.slice(body_pos + split_len, len(self.raw))
        end

        # Parse header lines
        let lines = header_section.split(line_split)
        when len(lines) == 0:
            return none
        end

        # Parse request line: METHOD /path HTTP/1.1
        let request_line = lines[0]
        let parts = request_line.split(" ")
        when len(parts) >= 2:
            self.method = parts[0]
            let full_path = parts[1]

            # Split path and query string
            when full_path.contains("?"):
                let qpos = full_path.find("?")
                self.path = full_path.slice(0, qpos)
                self.query_string = full_path.slice(qpos + 1, len(full_path))
                self._parse_query(self.query_string)
            otherwise:
                self.path = full_path
            end
        end

        # Parse headers
        let i = 1
        while i < len(lines):
            let line = lines[i]
            when line.contains(": "):
                let cpos = line.find(": ")
                when cpos >= 0:
                    let hkey = line.slice(0, cpos)
                    let hval = line.slice(cpos + 2, len(line))
                    self.headers[hkey] = hval
                end
            end
            i = i + 1
        end
    end

    action _parse_query(qs):
        let pairs = qs.split("&")
        for each pair in pairs:
            when pair.contains("="):
                let epos = pair.find("=")
                # ?q=hello+world%21 gives "hello world!"
                let k = http.url_decode(pair.slice(0, epos), true)
                let v = http.url_decode(pair.slice(epos + 1, len(pair)), true)
                self.query_params[k] = v
            end
        end
    end

    # A request header by name, in any case (HTTP header names ignore case).
    action get_header(name):
        when self.headers.has(name):
            return self.headers[name]
        end
        let want = name.lower()
        for each k in self.headers.keys():
            when k.lower() == want:
                return self.headers[k]
            end
        end
        return none
    end

    # The request's cookies as a dict (empty when there are none).
    action cookies():
        let found = {}
        let header = self.get_header("Cookie")
        when header is none:
            return found
        end
        for each raw_part in header.split(";"):
            let part = raw_part.trim()
            let eq = part.find("=")
            when eq > 0:
                found[part.slice(0, eq).trim()] = part.slice(eq + 1, len(part)).trim()
            end
        end
        return found
    end

    action json_body():
        when len(self.body) > 0:
            return json.parse(self.body)
        end
        return none
    end

    action set_context(key, value):
        self.context[key] = value
    end

    action get_context(key):
        when self.context.has(key):
            return self.context[key]
        end
        return none
    end
end

# ─── Response Builder ───
blueprint Response:
    action init():
        self.status_code = 200
        self.headers = {}
        self.body = ""
        self.sent = false
        self.cookies = []
    end

    # Sets a cookie in the browser. HttpOnly (scripts in the page cannot
    # read it), SameSite=Lax and Path=/ unless options say otherwise:
    # max_age (seconds), path, domain, secure, http_only, same_site.
    action set_cookie(name, value, options = none):
        let o = options ?? {}
        when name == "" or not _web_cookie_chars(name, "!#$%&'*+.^_`|~-"):
            throw "set_cookie: \"" + name + "\" is not a valid cookie name"
        end
        value = str(value)
        when not _web_cookie_chars(value, "!#$%&'()*+-./:<=>?@[]^_`{|}~"):
            throw "set_cookie: the value for \"" + name + "\" may only hold ASCII letters, digits and !#$%&'()*+-./:<=>?@[]^_`{|}~ (no spaces, quotes, commas or semicolons)"
        end
        let line = name + "=" + value + "; Path=" + (o["path"] ?? "/")
        when o.has("max_age"):
            line = line + "; Max-Age=" + str(int(o["max_age"]))
        end
        when o.has("domain"):
            line = line + "; Domain=" + o["domain"]
        end
        when o["secure"] ?? false:
            line = line + "; Secure"
        end
        when o["http_only"] ?? true:
            line = line + "; HttpOnly"
        end
        line = line + "; SameSite=" + (o["same_site"] ?? "Lax")
        when line.contains("\r") or line.contains("\n"):
            throw "set_cookie: options may not contain line breaks"
        end
        append(self.cookies, line)
        return self
    end

    # Removes a cookie from the browser (path must match the one it was set with).
    action clear_cookie(name, path = "/"):
        return self.set_cookie(name, "", {"max_age": 0, "path": path})
    end

    action status(code):
        self.status_code = code
        return self
    end

    action header(key, value):
        self.headers[key] = value
        return self
    end

    action text(body):
        self.headers["Content-Type"] = "text/plain"
        self.body = body
        self.sent = true
        return self
    end

    action html(body):
        self.headers["Content-Type"] = "text/html"
        self.body = body
        self.sent = true
        return self
    end

    action send_json(data):
        self.headers["Content-Type"] = "application/json"
        self.body = json.stringify(data)
        self.sent = true
        return self
    end

    action redirect(url):
        self.status_code = 302
        self.headers["Location"] = url
        self.sent = true
        return self
    end

    action _status_text():
        when self.status_code == 200:
            return "OK"
        eif self.status_code == 201:
            return "Created"
        eif self.status_code == 204:
            return "No Content"
        eif self.status_code == 301:
            return "Moved Permanently"
        eif self.status_code == 302:
            return "Found"
        eif self.status_code == 400:
            return "Bad Request"
        eif self.status_code == 401:
            return "Unauthorized"
        eif self.status_code == 403:
            return "Forbidden"
        eif self.status_code == 404:
            return "Not Found"
        eif self.status_code == 405:
            return "Method Not Allowed"
        eif self.status_code == 429:
            return "Too Many Requests"
        eif self.status_code == 500:
            return "Internal Server Error"
        otherwise:
            return "Unknown"
        end
    end

    action build():
        let result = "HTTP/1.1 " + self.status_code + " " + self._status_text() + "\r\n"
        for each key in self.headers:
            result = result + key + ": " + self.headers[key] + "\r\n"
        end
        for each c in self.cookies:
            result = result + "Set-Cookie: " + c + "\r\n"
        end
        result = result + "Content-Length: " + str(self.body).byte_len() + "\r\n"
        result = result + "\r\n" + self.body
        return result
    end
end

# Whether the connection can carry another request after this one: the
# client asked for keep-alive (the default in HTTP/1.1) and http.read got
# exactly this request. Extra bytes (a second request sent before the first
# was answered) or a chunked body would be lost, so those close instead.
func _web_keep_alive(req):
    when req.raw is none or req.method == "":
        return false
    end
    let conn = ""
    let length = 0
    for each k in req.headers.keys():
        let name = k.lower()
        when name == "connection":
            conn = req.headers[k].lower()
        eif name == "content-length":
            try:
                length = int(req.headers[k].trim())
            catch e:
                return false
            end
        eif name == "transfer-encoding":
            return false
        end
    end
    when req.body.byte_len() != length:
        return false
    end
    let eol = req.raw.find("\r\n")
    when eol < 0:
        return false
    end
    when req.raw.slice(0, eol).ends_with("HTTP/1.1"):
        return not conn.contains("close")
    end
    return conn.contains("keep-alive")
end

# Whether text has only ASCII letters, digits and the characters in extra
# (what a cookie name or value may hold; anything else could end the header).
func _web_cookie_chars(text, extra):
    for each c in text:
        when not ((c.byte_len() == 1 and c.is_alnum()) or extra.contains(c)):
            return false
        end
    end
    return true
end

# What a route path like /notes/:id matched in path, or none.
func _web_match(pattern, path):
    let want = pattern.split("/")
    let have = path.split("/")
    when len(want) != len(have):
        return none
    end
    let got = {}
    for each i, w in want:
        when w.starts_with(":") and have[i] != "":
            got[w[1:]] = http.url_decode(have[i])
        eif w != have[i]:
            return none
        end
    end
    return got
end

# ─── Route Entry ───
blueprint Route:
    action init(method, path, handler):
        self.method = method
        self.path = path
        self.handler = handler
    end
end

# ─── Router ───
blueprint Router:
    action init():
        self.routes = []
        self.prefix = ""
    end

    action set_prefix(prefix):
        self.prefix = prefix
        return self
    end

    action add(method, path, handler):
        let full_path = self.prefix + path
        let r = Route(method, full_path, handler)
        append(self.routes, r)
        return self
    end

    action get(path, handler):
        return self.add("GET", path, handler)
    end

    action post(path, handler):
        return self.add("POST", path, handler)
    end

    action put(path, handler):
        return self.add("PUT", path, handler)
    end

    action patch(path, handler):
        return self.add("PATCH", path, handler)
    end

    action del(path, handler):
        return self.add("DELETE", path, handler)
    end

    # The route for a request. A route path may have :name parts, as in
    # /notes/:id; what they matched goes into params (req.params), when given.
    # Routes without :name parts win over those with them.
    action find_route(method, path, params = none):
        for each r in self.routes:
            when r.method == method and r.path == path:
                return r
            end
        end
        # Try matching with wildcard/any method
        for each r in self.routes:
            when r.method == "ANY" and r.path == path:
                return r
            end
        end
        for each r in self.routes:
            when (r.method == method or r.method == "ANY") and r.path.contains("/:"):
                let got = _web_match(r.path, path)
                when got is not none:
                    when params is not none:
                        for each k in got.keys():
                            params[k] = got[k]
                        end
                    end
                    return r
                end
            end
        end
        return none
    end

    # The methods that have a route for path, in the order they were added.
    action methods_for(path):
        let found = []
        for each r in self.routes:
            when (r.path == path or (r.path.contains("/:") and _web_match(r.path, path) is not none)) and not found.contains(r.method):
                found.push(r.method)
            end
        end
        return found
    end
end

# ─── Middleware Chain ───
blueprint MiddlewareChain:
    action init():
        self.before_hooks = []
        self.after_hooks = []
    end

    action before(handler):
        append(self.before_hooks, handler)
        return self
    end

    action after(handler):
        append(self.after_hooks, handler)
        return self
    end

    action run_before(req, res):
        for each hook in self.before_hooks:
            _web_call(hook, req, res)
            when res.sent:
                return none
            end
        end
    end

    action run_after(req, res):
        for each hook in self.after_hooks:
            _web_call(hook, req, res)
        end
    end
end

# ─── Static File Server Helper ───
# The file under base_dir that a request path names, or none if the path
# could reach outside base_dir: "..", backslashes, drive letters and colons,
# NUL bytes and percent-encoded dots or slashes are all refused.
func static_file_path(base_dir, request_path):
    when request_path is none or not request_path.starts_with("/"):
        return none
    end
    let lowered = request_path.lower()
    when request_path.contains("\\") or request_path.contains(":") or request_path.contains("\0"):
        return none
    end
    when lowered.contains("%2e") or lowered.contains("%2f") or lowered.contains("%5c") or lowered.contains("%00"):
        return none
    end
    let kept = []
    for each seg in request_path.split("/"):
        when seg == "..":
            return none
        end
        when seg != "" and seg != ".":
            kept.append(seg)
        end
    end
    when len(kept) == 0:
        return none
    end
    return base_dir + "/" + kept.join("/")
end

func serve_static(base_dir, req, res):
    let file_path = static_file_path(base_dir, req.path)
    let info = none
    when file_path is not none:
        info = fs.stat(file_path)
    end
    when info is not none and not info["is_dir"]:
        let content = fs.read(file_path)
        # Determine content type from extension
        let ctype = "application/octet-stream"
        when _ends_with(file_path, ".html"):
            ctype = "text/html"
        eif _ends_with(file_path, ".css"):
            ctype = "text/css"
        eif _ends_with(file_path, ".js"):
            ctype = "application/javascript"
        eif _ends_with(file_path, ".json"):
            ctype = "application/json"
        eif _ends_with(file_path, ".txt"):
            ctype = "text/plain"
        eif _ends_with(file_path, ".png"):
            ctype = "image/png"
        eif _ends_with(file_path, ".jpg"):
            ctype = "image/jpeg"
        end
        res.header("Content-Type", ctype)
        res.body = content
        res.sent = true
    otherwise:
        res.status(404).text("File not found")
    end
end

# ─── JSON API Helpers ───
func json_ok(res, data):
    res.status(200).send_json(data)
end

func json_created(res, data):
    res.status(201).send_json(data)
end

func json_error(res, code, message):
    res.status(code).send_json({"error": message})
end

func json_not_found(res):
    res.status(404).send_json({"error": "Not Found"})
end

# ─── Server ───
blueprint Server:
    action init(port):
        self.port = port
        self.router = Router()
        self.middleware = MiddlewareChain()
        self.running = false
        self.static_dir = none
        self.ws_routes = {}
    end

    # A WebSocket endpoint: handler(ws) gets the connection (see
    # lib/websocket.glow), with the HTTP request as ws.request. It runs in
    # the connection's thread; the connection closes when it returns.
    action websocket(path, handler):
        self.ws_routes[path] = handler
        return self
    end

    action _websocket(client, raw, req):
        let ws = none
        try:
            ws = websocket.accept(client, raw)
        catch err:
            http.close(client)
            return none
        end
        ws.request = req
        try:
            let handler = self.ws_routes[req.path]
            handler(ws)
        catch err:
            show "[GlowWeb] WebSocket error: " + str(err)
            ws.close(1011, "internal error")
            return none
        end
        ws.close()
    end

    # Each takes the handler, or, left out, returns a decorator that adds
    # the function it is put on:
    #     @server.get("/hello")
    #     func hello(req): ... end
    action route(path, handler = none):
        when handler is none:
            return lambda(h):
                self.router.add("ANY", path, h)
                return h
            end
        end
        self.router.add("ANY", path, handler)
        return self
    end

    action get(path, handler = none):
        when handler is none:
            return lambda(h):
                self.router.get(path, h)
                return h
            end
        end
        self.router.get(path, handler)
        return self
    end

    action post(path, handler = none):
        when handler is none:
            return lambda(h):
                self.router.post(path, h)
                return h
            end
        end
        self.router.post(path, handler)
        return self
    end

    action put(path, handler = none):
        when handler is none:
            return lambda(h):
                self.router.put(path, h)
                return h
            end
        end
        self.router.put(path, handler)
        return self
    end

    action patch(path, handler = none):
        when handler is none:
            return lambda(h):
                self.router.patch(path, h)
                return h
            end
        end
        self.router.patch(path, handler)
        return self
    end

    action del(path, handler = none):
        when handler is none:
            return lambda(h):
                self.router.del(path, h)
                return h
            end
        end
        self.router.del(path, handler)
        return self
    end

    action use_before(hook):
        self.middleware.before(hook)
        return self
    end

    action use_after(hook):
        self.middleware.after(hook)
        return self
    end

    action set_static(dir_path):
        self.static_dir = dir_path
        return self
    end

    action use_router(router):
        for each r in router.routes:
            append(self.router.routes, r)
        end
        return self
    end

    action start(port):
        if port != none:
            self.port = port
        end
        return self.start_server()
    end

    action start_server():
        show "[GlowWeb] Starting server on port " + self.port
        let listener = http.listen(self.port)
        self.running = true

        while self.running:
            let client = http.accept(listener)
            if client >= 0:
                spawn self.handle_client(client)
            end
        end
    end

    # Answers requests on one connection while the client keeps it open
    # (HTTP keep-alive), closing it after 5 idle seconds.
    action handle_client(client):
        let raw = http.read(client)
        while raw is not none:
            when not self._respond(client, raw):
                return none
            end
            raw = http.read(client, 5)
        end
        http.close(client)
    end

    # Answers one request. Returns whether the connection stays open; when
    # it does not, it has been closed or handed to a WebSocket handler.
    action _respond(client, raw):
        let req = Request(raw)

        # An upgrade to a WebSocket route: the connection is the handler's.
        when self.ws_routes.has(req.path):
            for each k in req.headers.keys():
                when k.lower() == "upgrade" and req.headers[k].lower() == "websocket":
                    self._websocket(client, raw, req)
                    return false
                end
            end
        end
        let res = Response()

        # Run before middleware
        self.middleware.run_before(req, res)

        when not res.sent:
            # Try to find route
            let matched = self.router.find_route(req.method, req.path, req.params)
            when matched is not none:
                try:
                    # A handler may fill in res, or return the response:
                    # a dict or list (sent as JSON) or text (HTML when it
                    # starts with <, JSON when it starts with { or [).
                    let out = _web_call(matched.handler, req, res)
                    when not res.sent and out is not none:
                        when type(out) == "dict" or type(out) == "list":
                            res.send_json(out)
                        otherwise:
                            let text = str(out)
                            let head = text.trim()
                            when head.starts_with("<"):
                                res.html(text)
                            eif head.starts_with("{") or head.starts_with("["):
                                res.headers["Content-Type"] = "application/json"
                                res.body = text
                                res.sent = true
                            otherwise:
                                res.text(text)
                            end
                        end
                    end
                catch err:
                    show "[GlowWeb] Error: " + err
                    res.status(500).send_json({"error": "Internal Server Error"})
                end
            otherwise:
                # A known path asked with another method: 405 and the methods
                # it takes, then static files, then 404.
                let allowed = self.router.methods_for(req.path)
                when len(allowed) > 0:
                    res.headers["Allow"] = ", ".join(allowed)
                    res.status(405).send_json({"error": "Method Not Allowed"})
                eif self.static_dir is not none:
                    serve_static(self.static_dir, req, res)
                otherwise:
                    res.status(404).send_json({"error": "Not Found"})
                end
            end
        end

        # Run after middleware
        self.middleware.run_after(req, res)

        # Send response
        let keep = _web_keep_alive(req)
        for each k in res.headers.keys():
            when k.lower() == "connection":
                keep = keep and res.headers[k].lower() != "close"
                res.headers.remove(k)
            end
        end
        when keep:
            res.headers["Connection"] = "keep-alive"
        otherwise:
            res.headers["Connection"] = "close"
        end
        when http.send(client, res.build()) == -1:
            keep = false
        end
        when not keep:
            http.close(client)
        end
        return keep
    end

    action shutdown():
        self.running = false
        show "[GlowWeb] Server stopped"
    end
end

blueprint WebResponse:
    action init(status, body, headers):
        self.status = status
        self.body = body
        self.headers = headers
    end

    action to_json():
        if self.body != none and len(self.body) > 0:
            return json.parse(self.body)
        end
        return none
    end

    action text():
        return self.body
    end
end

blueprint WebClient:
    action init():
    end

    action fetch(url):
        let raw = http.request("GET", url, dict())
        if raw == none:
            return none
        end
        return WebResponse(raw["status"], raw["body"], raw["headers"])
    end

    action get(url):
        return self.fetch(url)
    end

    action post(url, data):
        let body_str = ""
        let headers = dict("Content-Type", "application/json")
        if data != none:
            if type(data) == "dict" or type(data) == "list":
                body_str = json.stringify(data)
            else:
                body_str = str(data)
            end
        end
        let opts = dict("body", body_str, "headers", headers)
        let raw = http.request("POST", url, opts)
        if raw == none:
            return none
        end
        return WebResponse(raw["status"], raw["body"], raw["headers"])
    end
end
