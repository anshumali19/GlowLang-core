# web.glow
# High-Level HTTP Client for GlowLang

class Response:
    func init(status, headers, body):
        self.status = status
        self.headers = headers
        self.body = body
    end
    
    func to_json():
        return json.parse(self.body)
    end
end

class WebClient:
    func init():
    end
    
    func fetch(url):
        return self.request("GET", url, dict())
    end
    
    func fetch_with_options(url, options):
        return self.request("GET", url, options)
    end

    func post(url, payload):
        let options = dict()
        options["headers"] = dict("Content-Type", "application/json")
        if type(payload) == "dict" or type(payload) == "list":
            options["body"] = json.stringify(payload)
        else:
            options["body"] = payload
        end
        return self.request("POST", url, options)
    end
    
    func request(method, url, options):
        let resp = http.request(method, url, options)
        if resp == none:
            return none
        end
        let r = Response()
        r.init(resp.status, resp.headers, resp.body)
        return r
    end
end
