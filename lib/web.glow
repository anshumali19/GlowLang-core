# GlowWeb — High-Performance Native Web Framework

blueprint Server:
    action init(port):
        self.port = port
        self.routes = {}
        self.running = false
    end

    action route(path, handler):
        self.routes[path] = handler
    end

    action start():
        show "[GlowWeb] Starting server on port ", self.port
        let listener = http.listen(self.port)
        self.running = true
        
        while self.running:
            let client = http.accept(listener)
            if client:
                spawn self.handle_client(client)
            end
        end
    end

    action handle_client(client):
        let request = http.read(client)
        if request:
            # Simple Request Parser
            let lines = request.split("\n")
            if len(lines) > 0:
                let first_line = lines[0]
                let parts = first_line.split(" ")
                if len(parts) >= 2:
                    let path = parts[1]
                    
                    if self.routes.has(path):
                        let handler = self.routes[path]
                        let response_body = handler(request)
                        let response = "HTTP/1.1 200 OK\r\nContent-Type: text/html\r\nContent-Length: " + len(response_body) + "\r\n\r\n" + response_body
                        http.send(client, response)
                    otherwise:
                        let response_body = "<h1>404 Not Found</h1>"
                        let response = "HTTP/1.1 404 Not Found\r\nContent-Type: text/html\r\nContent-Length: " + len(response_body) + "\r\n\r\n" + response_body
                        http.send(client, response)
                    end
                end
            end
        end
        http.close(client)
    end
end
