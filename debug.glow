# GlowLang OOP Stress Test
# Tests: blueprint, class, action, can, inheritance, method chaining, self

show "=== OOP Stress Test ==="

# Blueprint with actions
blueprint Animal:
    action init(name, sound):
        self.name = name
        self.sound = sound
        self.energy = 100
    end

    action speak():
        show self.name + " says " + self.sound
        self.energy = self.energy - 10
        return self
    end

    action eat(food):
        show self.name + " eats " + food
        self.energy = self.energy + 20
        return self
    end

    action status():
        show self.name + " energy: " + self.energy
        return self
    end
end

let dog = Animal("Rex", "Woof")
dog.speak()
dog.eat("bone")
dog.status()

# Class with can
class Calculator:
    can init():
        self.result = 0
        self.history = []
    end

    can add(n):
        self.result = self.result + n
        append(self.history, "+" + n)
        return self
    end

    can sub(n):
        self.result = self.result - n
        append(self.history, "-" + n)
        return self
    end

    can mul(n):
        self.result = self.result * n
        append(self.history, "*" + n)
        return self
    end

    can reset():
        self.result = 0
        self.history = []
        return self
    end

    can get_result():
        return self.result
    end
end

let calc = Calculator()
calc.init()
calc.add(10)
calc.add(5)
calc.sub(3)
show "Calc result: ", calc.get_result()

# Nested objects
blueprint Team:
    action init(name):
        self.name = name
        self.members = []
    end

    action add_member(member):
        append(self.members, member)
        return self
    end

    action size():
        return len(self.members)
    end

    action show_team():
        show "Team: " + self.name + " (" + self.size() + " members)"
        for each m in self.members:
            show "  - " + m
        end
    end
end

show "Before Team"
let team = Team("GlowLang Core")
show "Before Alice"
team.add_member("Alice")
team.add_member("Bob")
team.add_member("Charlie")
team.show_team()

# Blueprint with complex state
show "REACHED END"
