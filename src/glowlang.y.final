%code requires {
    #include "glowlang.h"
}

%{
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#include <math.h>
#include <ctype.h>
#include <time.h>
#include <sys/time.h>
#include <sys/socket.h>
#include <netinet/in.h>
#include <arpa/inet.h>
#include <errno.h>
#include <sys/stat.h>
#include <dirent.h>
#include <pthread.h>
#include <sched.h>
#include <sys/mman.h>
#include <unistd.h>
#include <openssl/ssl.h>
#include <openssl/err.h>
#include "glowlang.h"
#include "lsp.h"

/* VM State */
static __thread Value *vm_stack = NULL;
static __thread int vm_stack_size = 0;
static __thread int sp = 0;

#define PUSH(v) do { \
    if (sp >= vm_stack_size) { \
        vm_stack_size = (vm_stack_size == 0) ? 1024 : vm_stack_size * 2; \
        vm_stack = realloc(vm_stack, sizeof(Value) * vm_stack_size); \
    } \
    vm_stack[sp++] = (v); \
} while(0)
#define POP() (vm_stack[--sp])

/* Forward declarations */
extern const char *intern_string(const char *s);
extern void intern_cleanup(void);
extern void intern_table_init(void);
extern int line_num;
extern int yylex(void);
extern FILE *yyin;
void yyerror(const char *s);

static void gc_mark_value(Value v);
static void gc_mark_object(GCObject *obj);
static void gc_collect(void);
static void* gc_alloc(size_t sz, ObjType type);
void print_value(Value v);
static Value run_bytecode(Bytecode *bc, int base_tsp);
static void var_set(const char *name, Value value);
static Value var_get(const char *name);

static __thread Value pending_exception = 0;
static __thread int has_exception = 0;
static __thread LetShadow *let_shadow_list = NULL;

static void var_set_let(const char *name, Value val) {
    LetShadow *s = malloc(sizeof(LetShadow));
    s->name = name; s->old_value = var_get(name); s->next = let_shadow_list;
    let_shadow_list = s; var_set(name, val);
}

static void var_restore_shadow(LetShadow *target) {
    while (let_shadow_list != target) {
        LetShadow *s = let_shadow_list;
        var_set(s->name, s->old_value);
        let_shadow_list = s->next;
        free(s);
    }
}

typedef struct { int handler_ip; int sp; LetShadow *shadow_list; } TryHandler;
static __thread TryHandler try_stack[64];
static __thread int tsp = 0;

static int value_truthy(Value v) {
    if ((v & MASK_NAN) != MASK_NAN) return AS_FLOAT(v) != 0.0;
    uint64_t type = (v & MASK_TYPE) >> 48;
    if (type == VAL_INT) return AS_INT(v) != 0;
    if (type == VAL_BOOL) return AS_BOOL(v);
    if (type == VAL_STRING) return AS_STRING(v) && AS_STRING(v)[0] != '\0';
    if (type == VAL_LIST) return AS_LIST(v) && AS_LIST(v)->size > 0;
    return 0;
}

double val_to_double(Value v) {
    if ((v & MASK_NAN) != MASK_NAN) return AS_FLOAT(v);
    if (GET_TYPE(v) == VAL_INT) return (double)AS_INT(v);
    return 0.0;
}

int val_eq(Value a, Value b) {
    if (a == b) return 1;
    uint64_t ta = GET_TYPE(a), tb = GET_TYPE(b);
    if ((ta == VAL_INT || ta == VAL_FLOAT) && (tb == VAL_INT || tb == VAL_FLOAT)) {
        return val_to_double(a) == val_to_double(b);
    }
    if (ta == VAL_STRING && tb == VAL_STRING) return strcmp(AS_STRING(a), AS_STRING(b)) == 0;
    return 0;
}

static Value value_string_copy(const char *s) {
    size_t len = strlen(s);
    GCString *gs = gc_alloc(sizeof(GCString) + len + 25, OBJ_STRING);
    strcpy(gs->chars, s);
    return make_value(VAL_STRING, (uint64_t)(uintptr_t)gs);
}

/* Hash Tables */
#define VAR_TABLE_SIZE 16384
typedef struct { const char *name; Value value; int used; } VarEntry;
static VarEntry var_table[VAR_TABLE_SIZE];
static void var_table_init(void) { memset(var_table, 0, sizeof(var_table)); }
static unsigned int hash_str(const char *s) {
    unsigned int h = 5381;
    while (*s) h = ((h << 5) + h) + *s++;
    return h;
}
static void var_set(const char *name, Value value) {
    unsigned int h = hash_str(name) % VAR_TABLE_SIZE;
    unsigned int idx = h;
    do {
        if (!var_table[idx].used || strcmp(var_table[idx].name, name) == 0) {
            var_table[idx].name = name; var_table[idx].value = value; var_table[idx].used = 1;
            return;
        }
        idx = (idx + 1) % VAR_TABLE_SIZE;
    } while (idx != h);
}
static Value var_get(const char *name) {
    unsigned int h = hash_str(name) % VAR_TABLE_SIZE;
    unsigned int idx = h;
    do {
        if (!var_table[idx].used) break;
        if (strcmp(var_table[idx].name, name) == 0) return var_table[idx].value;
        idx = (idx + 1) % VAR_TABLE_SIZE;
    } while (idx != h);
    return value_none();
}

static int func_table_size = 1024;
static FuncEntry *func_table = NULL;
static void func_table_init(void) { func_table = calloc(func_table_size, sizeof(FuncEntry)); }
static FuncEntry* func_table_add(const char *name) {
    unsigned int h = hash_str(name) % func_table_size;
    unsigned int idx = h;
    do {
        if (!func_table[idx].used || strcmp(func_table[idx].name, name) == 0) {
            if (!func_table[idx].used) func_table[idx].used = 1; func_table[idx].name = name; return &func_table[idx];
        }
        idx = (idx + 1) % func_table_size;
    } while (idx != h);
    return NULL;
}
static FuncEntry* func_get(const char *name) {
    if (!func_table) return NULL;
    unsigned int h = hash_str(name) % func_table_size;
    unsigned int idx = h;
    do {
        if (!func_table[idx].used) break;
        if (strcmp(func_table[idx].name, name) == 0) return &func_table[idx];
        idx = (idx + 1) % func_table_size;
    } while (idx != h);
    return NULL;
}

/* Concurrency */
typedef struct { Value callee; int argc; Value *args; } ThreadData;
pthread_mutex_t glow_gil = PTHREAD_MUTEX_INITIALIZER;
pthread_mutex_t gc_mutex = PTHREAD_MUTEX_INITIALIZER;
pthread_mutex_t threads_mutex = PTHREAD_MUTEX_INITIALIZER;
typedef struct { Value **vm_stack_ptr; int *sp_ptr; LetShadow **shadow_ptr; Value *exc_ptr; } ThreadStack;
static ThreadStack active_stacks[128];
static int active_stack_count = 0;

static void vm_stack_init(void) {
    vm_stack_size = 4096;
    vm_stack = malloc(sizeof(Value) * vm_stack_size);
    sp = 0;
    pthread_mutex_lock(&threads_mutex);
    if (active_stack_count < 128) {
        active_stacks[active_stack_count].vm_stack_ptr = &vm_stack;
        active_stacks[active_stack_count].sp_ptr = &sp;
        active_stacks[active_stack_count].shadow_ptr = &let_shadow_list;
        active_stacks[active_stack_count].exc_ptr = &pending_exception;
        active_stack_count++;
    }
    pthread_mutex_unlock(&threads_mutex);
}

static void* thread_wrapper(void *arg) {
    ThreadData *td = (ThreadData*)arg;
    pthread_mutex_lock(&glow_gil);
    vm_stack_init();
    FuncEntry *fe = NULL;
    if (GET_TYPE(td->callee) == VAL_OBJECT && (td->callee & MASK_PAYLOAD)) {
        ObjType ot = GET_OBJ_TYPE(td->callee);
        if (ot == OBJ_NATIVE_FUNC) { AS_NATIVE_FUNC(td->callee)->func(td->argc, td->args); }
        else if (ot == OBJ_BOUND_METHOD) { BoundMethod *bm = AS_BOUND_METHOD(td->callee); fe = bm->method; var_set("self", bm->instance); }
    }
    if (fe && fe->body) {
        LetShadow *old_shadow = let_shadow_list;
        for (int i=0; i<fe->param_count; i++) {
            Value val = (i < td->argc) ? td->args[i] : value_none();
            var_set_let(fe->params[i], val);
        }
        run_bytecode(fe->body, 0);
        var_restore_shadow(old_shadow);
    }
    free(td->args); free(td); 
    pthread_mutex_unlock(&glow_gil);
    return NULL;
}

/* GC */
static GCObject *gc_objects = NULL;
static size_t gc_allocated = 0;
static size_t gc_threshold = 128 * 1024 * 1024;

static void gc_mark_object(GCObject *obj) {
    if (!obj || obj->marked) return;
    obj->marked = 1;
    switch (obj->type) {
        case OBJ_STRING: break;
        case OBJ_LIST: { List *l = (List*)obj; for (int i=0; i<l->size; i++) gc_mark_value(l->items[i]); break; }
        case OBJ_DICT: { Dict *d = (Dict*)obj; for (int i=0; i<d->size; i++) gc_mark_value(d->values[i]); break; }
        case OBJ_CLASS: { Class *c = (Class*)obj; gc_mark_object((GCObject*)c->parent); gc_mark_object((GCObject*)c->methods); gc_mark_object((GCObject*)c->root_shape); break; }
        case OBJ_INSTANCE: { Instance *ins = (Instance*)obj; gc_mark_object((GCObject*)ins->klass); gc_mark_object((GCObject*)ins->shape); if(ins->fields) for(int i=0; i<ins->field_capacity; i++) gc_mark_value(ins->fields[i]); break; }
        case OBJ_BOUND_METHOD: { BoundMethod *bm = (BoundMethod*)obj; gc_mark_value(bm->instance); break; }
        case OBJ_SHAPE: { Shape *s = (Shape*)obj; gc_mark_object((GCObject*)s->parent); gc_mark_object((GCObject*)s->transitions); break; }
        case OBJ_TRAIT: { Trait *t = (Trait*)obj; gc_mark_object((GCObject*)t->methods); break; }
        case OBJ_CLOSURE: { Closure *c = (Closure*)obj; if(c->captured_values) for(int i=0; i<c->captured_count; i++) gc_mark_value(c->captured_values[i]); break; }
        default: break;
    }
}
static void gc_mark_value(Value v) {
    if (GET_TYPE(v) == VAL_OBJECT || GET_TYPE(v) == VAL_LIST || GET_TYPE(v) == VAL_DICT || GET_TYPE(v) == VAL_STRING) {
        if (v & MASK_PAYLOAD) gc_mark_object((GCObject*)(uintptr_t)(v & MASK_PAYLOAD));
    }
}
static void gc_collect(void) {
    for (int i=0; i<VAR_TABLE_SIZE; i++) if (var_table[i].used) gc_mark_value(var_table[i].value);
    pthread_mutex_lock(&threads_mutex);
    for (int i=0; i<active_stack_count; i++) {
        Value *stk = *(active_stacks[i].vm_stack_ptr);
        int stk_sp = *(active_stacks[i].sp_ptr);
        if (stk) for (int j=0; j<stk_sp; j++) gc_mark_value(stk[j]);
        gc_mark_value(*(active_stacks[i].exc_ptr));
        LetShadow *ls = *(active_stacks[i].shadow_ptr);
        while(ls) { gc_mark_value(ls->old_value); ls = ls->next; }
    }
    pthread_mutex_unlock(&threads_mutex);
    GCObject **p = &gc_objects;
    while (*p) {
        if (!(*p)->marked) {
            GCObject *unmarked = *p; *p = unmarked->next;
            if (unmarked->type == OBJ_LIST) free(((List*)unmarked)->items);
            else if (unmarked->type == OBJ_DICT) { free(((Dict*)unmarked)->keys); free(((Dict*)unmarked)->values); }
            else if (unmarked->type == OBJ_INSTANCE) free(((Instance*)unmarked)->fields);
            else if (unmarked->type == OBJ_CLASS) free((char*)((Class*)unmarked)->name);
            else if (unmarked->type == OBJ_TRAIT) free((char*)((Trait*)unmarked)->name);
            gc_allocated -= unmarked->sz; free(unmarked);
        } else { (*p)->marked = 0; p = &((*p)->next); }
    }
}
static void* gc_alloc(size_t sz, ObjType type) {
    pthread_mutex_lock(&gc_mutex);
    if (gc_allocated > gc_threshold) gc_collect();
    GCObject *obj = calloc(1, sz); obj->type = type; obj->sz = sz; obj->next = gc_objects; gc_objects = obj; gc_allocated += sz;
    pthread_mutex_unlock(&gc_mutex);
    return obj;
}

static List* list_new(int sz) { List *l = gc_alloc(sizeof(List), OBJ_LIST); l->capacity = sz; l->items = sz > 0 ? calloc(sz, sizeof(Value)) : NULL; l->size = 0; return l; }
static void list_push(List *l, Value v) { if (l->size >= l->capacity) { l->capacity = (l->capacity == 0) ? 4 : l->capacity * 2; l->items = realloc(l->items, sizeof(Value)*l->capacity); } l->items[l->size++] = v; }
static Dict* dict_new(int sz) { Dict *d = gc_alloc(sizeof(Dict), OBJ_DICT); d->capacity = sz; d->keys = sz > 0 ? calloc(sz, sizeof(char*)) : NULL; d->values = sz > 0 ? calloc(sz, sizeof(Value)) : NULL; d->size = 0; return d; }
static void dict_set(Dict *d, const char *key, Value val) { for (int i = 0; i < d->size; i++) if (strcmp(d->keys[i], key) == 0) { d->values[i] = val; return; } if (d->size >= d->capacity) { d->capacity = (d->capacity == 0) ? 4 : d->capacity * 2; d->keys = realloc(d->keys, sizeof(char*) * d->capacity); d->values = realloc(d->values, sizeof(Value) * d->capacity); } d->keys[d->size] = key; d->values[d->size++] = val; }
static Value dict_get(Dict *d, const char *key) { if (!d) return value_none(); for (int i = 0; i < d->size; i++) if (strcmp(d->keys[i], key) == 0) return d->values[i]; return value_none(); }
static Shape* shape_new(Shape *p, const char *n, int o) { Shape *s = gc_alloc(sizeof(Shape), OBJ_SHAPE); s->parent = p; s->name = n; s->offset = o; s->transitions = dict_new(4); return s; }
static Shape* shape_get_next(Shape* curr, const char *name) { for (int i=0; i<curr->transitions->size; i++) if (strcmp(curr->transitions->keys[i], name) == 0) return (Shape*)(uintptr_t)(curr->transitions->values[i] & MASK_PAYLOAD); Shape *next = shape_new(curr, name, curr->offset + 1); dict_set(curr->transitions, name, value_obj(next)); return next; }
static Class* class_new(const char *name, Class *parent) { Class *c = gc_alloc(sizeof(Class), OBJ_CLASS); c->name = strdup(name); c->parent = parent; c->methods = dict_new(8); c->root_shape = shape_new(NULL, "__root__", -1); return c; }
static Instance* instance_new(Class *k) { Instance *i = gc_alloc(sizeof(Instance), OBJ_INSTANCE); i->klass = k; i->shape = k->root_shape; i->field_capacity = 8; i->fields = calloc(8, sizeof(Value)); for(int j=0; j<8; j++) i->fields[j] = value_none(); return i; }
static void instance_set(Instance *inst, const char *name, Value val) { Shape *s = inst->shape; while (s && s->name && strcmp(s->name, "__root__") != 0) { if (strcmp(s->name, name) == 0) { inst->fields[s->offset] = val; return; } s = s->parent; } inst->shape = shape_get_next(inst->shape, name); if (inst->shape->offset >= inst->field_capacity) { int old = inst->field_capacity; inst->field_capacity *= 2; inst->fields = realloc(inst->fields, sizeof(Value)*inst->field_capacity); for(int j=old; j<inst->field_capacity; j++) inst->fields[j] = value_none(); } inst->fields[inst->shape->offset] = val; }
static Value instance_get(Instance *inst, const char *name) { Shape *s = inst->shape; while (s && s->name && strcmp(s->name, "__root__") != 0) { if (strcmp(s->name, name) == 0) return inst->fields[s->offset]; s = s->parent; } return value_none(); }
static Value class_get_method(Class *k, const char *n) { while(k) { Value m = dict_get(k->methods, n); if((m & MASK_PAYLOAD) != 0) return m; k=k->parent; } return value_none(); }
static BoundMethod* bound_method_new(Value inst, FuncEntry *m) { BoundMethod *bm = gc_alloc(sizeof(BoundMethod), OBJ_BOUND_METHOD); bm->instance = inst; bm->method = m; return bm; }
Closure* closure_new(int pc, char **ps, Bytecode *b) { Closure *c = gc_alloc(sizeof(Closure), OBJ_CLOSURE); c->param_count = pc; c->params = ps; c->body = b; c->captured_count = 0; c->captured_names = NULL; c->captured_values = NULL; return c; }

static Bytecode* bc_new() { Bytecode *bc = calloc(1, sizeof(Bytecode)); bc->capacity = 1024; bc->code = calloc(bc->capacity, sizeof(Instruction)); return bc; }
static int bc_emit(Bytecode *bc, OpCode op, int arg, intptr_t ptr) { if (bc->count >= bc->capacity) { bc->capacity *= 2; bc->code = realloc(bc->code, sizeof(Instruction) * bc->capacity); } bc->code[bc->count].op = op; bc->code[bc->count].arg = arg; bc->code[bc->count].ptr = ptr; bc->code[bc->count].cache_key = NULL; bc->code[bc->count].cache_val = 0; bc->code[bc->count].exec_count = 0; return bc->count++; }

static void func_add_local(FuncEntry *fe, const char *name) { if (!fe || !name) return; for (int i=0; i<fe->local_count; i++) if (strcmp(fe->local_names[i], name) == 0) return; for (int i=0; i<fe->param_count; i++) if (strcmp(fe->params[i], name) == 0) return; if (fe->local_count >= fe->local_capacity) { fe->local_capacity = (fe->local_capacity == 0) ? 8 : fe->local_capacity * 2; fe->local_names = realloc(fe->local_names, sizeof(char*) * fe->local_capacity); } fe->local_names[fe->local_count++] = (char*)name; }

static FuncEntry *compiling_func = NULL;
static Bytecode *compiling_bc = NULL;
static Class *last_compiling_class = NULL;
static Trait *last_compiling_trait = NULL;

void compile(Node *n) {
    if (!n) return;
    if (compiling_func && n->name) { if (n->type == NODE_VAR || n->type == NODE_ASSIGN || n->type == NODE_LET) func_add_local(compiling_func, n->name); }
    switch (n->type) {
        case NODE_INT_LIT: bc_emit(compiling_bc, OP_CONST_INT, AS_INT(n->value), 0); break;
        case NODE_FLOAT_LIT: { Value *v = malloc(sizeof(Value)); *v = n->value; bc_emit(compiling_bc, OP_CONST_FLOAT, 0, (intptr_t)v); break; }
        case NODE_BOOL_LIT: bc_emit(compiling_bc, OP_CONST_BOOL, AS_BOOL(n->value), 0); break;
        case NODE_STRING_LIT: bc_emit(compiling_bc, OP_CONST_STRING, 0, (intptr_t)n->name); break;
        case NODE_VAR: bc_emit(compiling_bc, OP_LOAD_VAR, 0, (intptr_t)n->name); break;
        case NODE_ASSIGN: compile(n->left); bc_emit(compiling_bc, OP_STORE_VAR, 0, (intptr_t)n->name); break;
        case NODE_ADD: compile(n->left); compile(n->right); bc_emit(compiling_bc, OP_ADD, 0, 0); break;
        case NODE_SUB: compile(n->left); compile(n->right); bc_emit(compiling_bc, OP_SUB, 0, 0); break;
        case NODE_MUL: compile(n->left); compile(n->right); bc_emit(compiling_bc, OP_MUL, 0, 0); break;
        case NODE_DIV: compile(n->left); compile(n->right); bc_emit(compiling_bc, OP_DIV, 0, 0); break;
        case NODE_LT: compile(n->left); compile(n->right); bc_emit(compiling_bc, OP_LT, 0, 0); break;
        case NODE_GT: compile(n->left); compile(n->right); bc_emit(compiling_bc, OP_GT, 0, 0); break;
        case NODE_LTE: compile(n->left); compile(n->right); bc_emit(compiling_bc, OP_LTE, 0, 0); break;
        case NODE_GTE: compile(n->left); compile(n->right); bc_emit(compiling_bc, OP_GTE, 0, 0); break;
        case NODE_EQ: compile(n->left); compile(n->right); bc_emit(compiling_bc, OP_EQ, 0, 0); break;
        case NODE_NEQ: compile(n->left); compile(n->right); bc_emit(compiling_bc, OP_NEQ, 0, 0); break;
        case NODE_AND: compile(n->left); compile(n->right); bc_emit(compiling_bc, OP_AND, 0, 0); break;
        case NODE_OR: compile(n->left); compile(n->right); bc_emit(compiling_bc, OP_OR, 0, 0); break;
        case NODE_NOT: compile(n->left); bc_emit(compiling_bc, OP_NOT, 0, 0); break;
        case NODE_SEQ: compile(n->left); compile(n->right); break;
        case NODE_SHOW: for (int i=0; i<n->print_count; i++) compile(n->print_items[i]); bc_emit(compiling_bc, OP_SHOW, n->print_count, 0); break;
        case NODE_FUNC_DEF: {
            FuncEntry *fe = func_table_add(n->name); fe->param_count = n->func_param_count; fe->params = n->func_params; fe->body = bc_new();
            Bytecode *p = compiling_bc; compiling_bc = fe->body; FuncEntry *pf = compiling_func; compiling_func = fe;
            compile(n->left); bc_emit(compiling_bc, OP_RETURN, 0, 0); compiling_bc = p; compiling_func = pf;
            bc_emit(compiling_bc, (last_compiling_class || last_compiling_trait) ? OP_METHOD_DEF : OP_FUNC_DEF, 0, (intptr_t)n->name); break;
        }
        case NODE_CLASS: { if (n->parent_name) bc_emit(compiling_bc, OP_LOAD_VAR, 0, (intptr_t)n->parent_name); bc_emit(compiling_bc, OP_CLASS_DEF, n->parent_name ? 1 : 0, (intptr_t)n->name); compile(n->left); break; }
        case NODE_IF: { compile(n->left); int jf = bc_emit(compiling_bc, OP_JUMP_IF_FALSE, 0, 0); compile(n->right); int j = bc_emit(compiling_bc, OP_JUMP, 0, 0); compiling_bc->code[jf].arg = compiling_bc->count; if (n->third) compile(n->third); compiling_bc->code[j].arg = compiling_bc->count; break; }
        case NODE_WHILE: { int start = compiling_bc->count; compile(n->left); int jf = bc_emit(compiling_bc, OP_JUMP_IF_FALSE, 0, 0); compile(n->right); bc_emit(compiling_bc, OP_JUMP, start, 0); compiling_bc->code[jf].arg = compiling_bc->count; break; }
        case NODE_LET: compile(n->left); bc_emit(compiling_bc, OP_STORE_VAR, 0, (intptr_t)n->name); break;
        case NODE_CALL_EXPR:
        case NODE_CALL: { int ac = n->call_arg_count; for (int i=0; i<ac; i++) compile(n->call_args[i]); if (n->type == NODE_CALL) bc_emit(compiling_bc, OP_CALL, ac, (intptr_t)n->name); else { compile(n->left); bc_emit(compiling_bc, OP_CALL_VALUE, ac, 0); } break; }
        case NODE_RETURN: compile(n->left); bc_emit(compiling_bc, OP_RETURN, 0, 0); break;
        case NODE_EXPR_STMT: compile(n->left); bc_emit(compiling_bc, OP_POP, 0, 0); break;
        case NODE_STOP: bc_emit(compiling_bc, OP_STOP, 0, 0); break;
        case NODE_SKIP: bc_emit(compiling_bc, OP_SKIP, 0, 0); break;
        case NODE_INDEX: { if (n->name) { compile(n->left); bc_emit(compiling_bc, OP_GET_PROPERTY, 0, (intptr_t)n->name); } else { compile(n->left); compile(n->right); bc_emit(compiling_bc, OP_INDEX, 0, 0); } break; }
        case NODE_INDEX_ASSIGN: { if (n->name) { compile(n->third); compile(n->left); bc_emit(compiling_bc, OP_SET_PROPERTY, 0, (intptr_t)n->name); } else { compile(n->third); compile(n->left); compile(n->right); bc_emit(compiling_bc, OP_STORE_INDEX, 0, 0); } break; }
        case NODE_LIST_LITERAL: { for (int i=0; i<n->element_count; i++) compile(n->elements[i]); bc_emit(compiling_bc, OP_LIST_LITERAL, n->element_count, 0); break; }
        case NODE_FOR_EACH: { compile(n->left); bc_emit(compiling_bc, OP_FOR_EACH, 0, (intptr_t)n->right); compiling_bc->code[compiling_bc->count-1].cache_key = (void*)n->name; break; }
        default: break;
    }
}

/* JIT placeholder */
static void jit_compile(Bytecode *bc) { bc->jit_failed = 1; }

static Class *vm_last_class = NULL; static Trait *vm_last_trait = NULL;

static Value run_bytecode(Bytecode *bc, int base_tsp) {
    int start_sp = sp; LetShadow *start_shadow = let_shadow_list;
    Instruction *pc = bc->code;
    static void* dt[] = {
        &&l_OP_CONST_INT, &&l_OP_CONST_FLOAT, &&l_OP_CONST_STRING, &&l_OP_CONST_BOOL,
        &&l_OP_LOAD_VAR, &&l_OP_STORE_VAR,
        &&l_OP_ADD, &&l_OP_SUB, &&l_OP_MUL, &&l_OP_DIV, &&l_OP_MOD, &&l_OP_POW, &&l_OP_NEG,
        &&l_OP_LT, &&l_OP_GT, &&l_OP_LTE, &&l_OP_GTE, &&l_OP_EQ, &&l_OP_NEQ,
        &&l_OP_AND, &&l_OP_OR, &&l_OP_NOT,
        &&l_OP_JUMP, &&l_OP_JUMP_IF_FALSE, &&l_OP_JUMP_IF_TRUE,
        &&l_OP_LEN, &&l_OP_RANGE, &&l_OP_TYPE, &&l_OP_APPEND, &&l_OP_INPUT, &&l_OP_SHOW, &&l_OP_WRITE,
        &&l_OP_LIST_LITERAL, &&l_OP_DICT_LITERAL,
        &&l_OP_INDEX, &&l_OP_SLICE, &&l_OP_STORE_INDEX,
        &&l_OP_FUNC_DEF, &&l_OP_CALL, &&l_OP_RETURN,
        &&l_OP_FOR_EACH, &&l_OP_FOR_EACH_PAIR,
        &&l_OP_STOP, &&l_OP_SKIP, &&l_OP_POP,
        &&l_OP_STORE_LET,
        &&l_OP_DICT_KEYS, &&l_OP_DICT_VALUES, &&l_OP_DICT_HAS, &&l_OP_DICT_REMOVE, &&l_OP_DICT_MERGE,
        &&l_OP_MATH_ABS, &&l_OP_MATH_MIN, &&l_OP_MATH_MAX, &&l_OP_MATH_ROUND, &&l_OP_MATH_FLOOR, &&l_OP_MATH_CEIL, &&l_OP_MATH_SQRT,
        &&l_OP_STR_UPPER, &&l_OP_STR_LOWER, &&l_OP_STR_TRIM, &&l_OP_STR_FIND, &&l_OP_STR_REPLACE, &&l_OP_STR_STARTSWITH, &&l_OP_STR_ENDSWITH, &&l_OP_STR_SPLIT,
        &&l_OP_LIST_PUSH, &&l_OP_LIST_POP, &&l_OP_LIST_INSERT, &&l_OP_LIST_REMOVE, &&l_OP_LIST_CONTAINS, &&l_OP_LIST_SORT, &&l_OP_LIST_REVERSE,
        &&l_OP_FILE_READ, &&l_OP_FILE_WRITE, &&l_OP_FILE_APPEND,
        &&l_OP_FSTRING, &&l_OP_LIST_COMP, &&l_OP_THROW, &&l_OP_TRY_START, &&l_OP_TRY_END, &&l_OP_LAMBDA, &&l_OP_CALL_VALUE,
        &&l_OP_CLASS_DEF, &&l_OP_METHOD_DEF, &&l_OP_TRAIT_DEF, &&l_OP_USE_TRAIT, &&l_OP_GET_PROPERTY, &&l_OP_SET_PROPERTY, &&l_OP_SPAWN
    };
#define DISPATCH() goto *dt[pc->op]
    DISPATCH();
    l_OP_CONST_INT: PUSH(value_int(pc->arg)); pc++; DISPATCH();
    l_OP_CONST_FLOAT: PUSH(*(Value*)pc->ptr); pc++; DISPATCH();
    l_OP_CONST_STRING: PUSH(value_string_copy((const char*)pc->ptr)); pc++; DISPATCH();
    l_OP_CONST_BOOL: PUSH(value_bool(pc->arg)); pc++; DISPATCH();
    l_OP_LOAD_VAR: { const char *n = (const char*)pc->ptr; Value v = var_get(n); if (GET_TYPE(v) == VAL_NONE) { FuncEntry *fe = func_get(n); if (fe) v = value_bound_method(bound_method_new(value_none(), fe)); } PUSH(v); pc++; DISPATCH(); }
    l_OP_STORE_VAR: { var_set((const char*)pc->ptr, POP()); pc++; DISPATCH(); }
    l_OP_ADD: { Value b = POP(), a = POP(); if (GET_TYPE(a) == VAL_INT && GET_TYPE(b) == VAL_INT) PUSH(value_int(AS_INT(a) + AS_INT(b))); else PUSH(value_float(val_to_double(a) + val_to_double(b))); pc++; DISPATCH(); }
    l_OP_SUB: { Value b = POP(), a = POP(); if (GET_TYPE(a) == VAL_INT && GET_TYPE(b) == VAL_INT) PUSH(value_int(AS_INT(a) - AS_INT(b))); else PUSH(value_float(val_to_double(a) - val_to_double(b))); pc++; DISPATCH(); }
    l_OP_MUL: { Value b = POP(), a = POP(); if (GET_TYPE(a) == VAL_INT && GET_TYPE(b) == VAL_INT) PUSH(value_int(AS_INT(a) * AS_INT(b))); else PUSH(value_float(val_to_double(a) * val_to_double(b))); pc++; DISPATCH(); }
    l_OP_DIV: { Value b = POP(), a = POP(); if (GET_TYPE(a) == VAL_INT && GET_TYPE(b) == VAL_INT && AS_INT(b) != 0) PUSH(value_int(AS_INT(a) / AS_INT(b))); else PUSH(value_float(val_to_double(a) / (val_to_double(b) == 0 ? 1.0 : val_to_double(b)))); pc++; DISPATCH(); }
    l_OP_MOD: { Value b = POP(), a = POP(); if (GET_TYPE(a) == VAL_INT && GET_TYPE(b) == VAL_INT && AS_INT(b) != 0) PUSH(value_int(AS_INT(a) % AS_INT(b))); else PUSH(value_float(fmod(val_to_double(a), val_to_double(b) == 0 ? 1.0 : val_to_double(b)))); pc++; DISPATCH(); }
    l_OP_POW: { Value b = POP(), a = POP(); PUSH(value_float(pow(val_to_double(a), val_to_double(b)))); pc++; DISPATCH(); }
    l_OP_NEG: { Value a = POP(); if (GET_TYPE(a) == VAL_INT) PUSH(value_int(-AS_INT(a))); else PUSH(value_float(-val_to_double(a))); pc++; DISPATCH(); }
    l_OP_LT: { Value b = POP(), a = POP(); PUSH(value_bool(val_to_double(a) < val_to_double(b))); pc++; DISPATCH(); }
    l_OP_GT: { Value b = POP(), a = POP(); PUSH(value_bool(val_to_double(a) > val_to_double(b))); pc++; DISPATCH(); }
    l_OP_LTE: { Value b = POP(), a = POP(); PUSH(value_bool(val_to_double(a) <= val_to_double(b))); pc++; DISPATCH(); }
    l_OP_GTE: { Value b = POP(), a = POP(); PUSH(value_bool(val_to_double(a) >= val_to_double(b))); pc++; DISPATCH(); }
    l_OP_EQ: { Value b = POP(), a = POP(); PUSH(value_bool(val_eq(a, b))); pc++; DISPATCH(); }
    l_OP_NEQ: { Value b = POP(), a = POP(); PUSH(value_bool(!val_eq(a, b))); pc++; DISPATCH(); }
    l_OP_AND: { Value b = POP(), a = POP(); PUSH(value_bool(value_truthy(a) && value_truthy(b))); pc++; DISPATCH(); }
    l_OP_OR: { Value b = POP(), a = POP(); PUSH(value_bool(value_truthy(a) || value_truthy(b))); pc++; DISPATCH(); }
    l_OP_NOT: { Value a = POP(); PUSH(value_bool(!value_truthy(a))); pc++; DISPATCH(); }
    l_OP_JUMP: { pc = bc->code + pc->arg; DISPATCH(); }
    l_OP_JUMP_IF_FALSE: { Value v = POP(); if(!value_truthy(v)) pc = bc->code + pc->arg; else pc++; DISPATCH(); }
    l_OP_JUMP_IF_TRUE: { Value v = POP(); if(value_truthy(v)) pc = bc->code + pc->arg; else pc++; DISPATCH(); }
    l_OP_LEN: { Value v = POP(); if(GET_TYPE(v)==VAL_STRING) PUSH(value_int(strlen(AS_STRING(v)))); else if(GET_TYPE(v)==VAL_LIST) PUSH(value_int(AS_LIST(v)->size)); else PUSH(value_int(0)); pc++; DISPATCH(); }
    l_OP_RANGE: { int n = (int)AS_INT(POP()); List *l = list_new(n); for(int i=0; i<n; i++) list_push(l, value_int(i)); PUSH(value_list(l)); pc++; DISPATCH(); }
    l_OP_TYPE: { Value v = POP(); PUSH(value_int(GET_TYPE(v))); pc++; DISPATCH(); }
    l_OP_APPEND: { Value v = POP(), l = POP(); if(GET_TYPE(l)==VAL_LIST) list_push(AS_LIST(l), v); PUSH(l); pc++; DISPATCH(); }
    l_OP_INPUT: { char buf[1024]; if(fgets(buf, 1024, stdin)) { buf[strcspn(buf, "\n")] = 0; PUSH(value_string_copy(buf)); } else PUSH(value_none()); pc++; DISPATCH(); }
    l_OP_SHOW: { int n = pc->arg; for (int i=0; i<n; i++) { print_value(vm_stack[sp-n+i]); if(i<n-1) printf(" "); } printf("\n"); sp-=n; pc++; DISPATCH(); }
    l_OP_WRITE: { Value v = POP(); print_value(v); pc++; DISPATCH(); }
    l_OP_LIST_LITERAL: { int n = pc->arg; List *l = list_new(n); for(int i=0; i<n; i++) list_push(l, vm_stack[sp-n+i]); sp-=n; PUSH(value_list(l)); pc++; DISPATCH(); }
    l_OP_DICT_LITERAL: { int n = pc->arg; Dict *d = dict_new(n); for(int i=0; i<n; i++) { Value v = POP(); Value k = POP(); if(GET_TYPE(k)==VAL_STRING) dict_set(d, AS_STRING(k), v); } PUSH(value_dict(d)); pc++; DISPATCH(); }
    l_OP_INDEX: { Value i = POP(), o = POP(); if(GET_TYPE(o)==VAL_LIST && GET_TYPE(i)==VAL_INT) { int idx = AS_INT(i); if(idx>=0 && idx<AS_LIST(o)->size) PUSH(AS_LIST(o)->items[idx]); else PUSH(value_none()); } else if(GET_TYPE(o)==VAL_DICT && GET_TYPE(i)==VAL_STRING) { PUSH(dict_get(AS_DICT(o), AS_STRING(i))); } else PUSH(value_none()); pc++; DISPATCH(); }
    l_OP_SLICE: { Value endV = POP(), startV = POP(), obj = POP(); int slen = 0; if (GET_TYPE(obj) == VAL_STRING) slen = strlen(AS_STRING(obj)); else if (GET_TYPE(obj) == VAL_LIST) slen = AS_LIST(obj)->size; int s = (startV == value_int(-1)) ? 0 : (int)AS_INT(startV); int e = (endV == value_int(-1)) ? slen : (int)AS_INT(endV); if (s < 0) s = 0; if (e > slen) e = slen; if (s > e) s = e; if (GET_TYPE(obj) == VAL_STRING) { int rlen = e - s; char *sub = malloc(rlen + 1); strncpy(sub, AS_STRING(obj) + s, rlen); sub[rlen] = 0; PUSH(value_string_copy(sub)); free(sub); } else if (GET_TYPE(obj) == VAL_LIST) { List *rl = list_new(e - s); for (int i = s; i < e; i++) list_push(rl, AS_LIST(obj)->items[i]); PUSH(value_list(rl)); } else PUSH(value_none()); pc++; DISPATCH(); }
    l_OP_STORE_INDEX: { Value i = POP(), o = POP(), v = POP(); if(GET_TYPE(o)==VAL_LIST && GET_TYPE(i)==VAL_INT) { int idx = AS_INT(i); if(idx>=0 && idx<AS_LIST(o)->size) AS_LIST(o)->items[idx] = v; } else if(GET_TYPE(o)==VAL_DICT && GET_TYPE(i)==VAL_STRING) { dict_set(AS_DICT(o), AS_STRING(i), v); } pc++; DISPATCH(); }
    l_OP_FUNC_DEF: pc++; DISPATCH();
    l_OP_CALL: { int ac = pc->arg; FuncEntry *fe = func_get((const char*)pc->ptr); if (fe && fe->body) { LetShadow *old_shadow = let_shadow_list; for (int i=0; i<fe->param_count; i++) { Value val = (i < ac) ? vm_stack[sp-ac+i] : value_none(); var_set_let(fe->params[i], val); } sp -= ac; Value res = run_bytecode(fe->body, tsp); var_restore_shadow(old_shadow); if(has_exception) { PUSH(pending_exception); goto l_OP_THROW; } PUSH(res); } else { sp -= ac; PUSH(value_none()); } pc++; DISPATCH(); }
    l_OP_RETURN: { Value res = sp > start_sp ? POP() : value_none(); sp = start_sp; var_restore_shadow(start_shadow); return res; }
    l_OP_FOR_EACH: { Value iter = POP(); const char *vn = (const char*)pc->cache_key; Bytecode *body = (Bytecode*)pc->ptr; if (GET_TYPE(iter) == VAL_LIST) { List *l = AS_LIST(iter); for (int i=0; i<l->size; i++) { var_set_let(vn, l->items[i]); run_bytecode(body, tsp); if (has_exception) break; } } if (has_exception) goto l_OP_THROW; pc++; DISPATCH(); }
    l_OP_FOR_EACH_PAIR: pc++; DISPATCH();
    l_OP_STOP: { sp = start_sp; var_restore_shadow(start_shadow); return value_none(); }
    l_OP_SKIP: pc++; DISPATCH();
    l_OP_POP: if(sp > 0) POP(); pc++; DISPATCH();
    l_OP_STORE_LET: { var_set_let((const char*)pc->ptr, POP()); pc++; DISPATCH(); }
    l_OP_PUSH_SCOPE: pc++; DISPATCH(); l_OP_POP_SCOPE: pc++; DISPATCH();
    l_OP_LOAD_LOCAL: pc++; DISPATCH(); l_OP_STORE_LOCAL: pc++; DISPATCH();
    l_OP_DICT_KEYS: { Value d = POP(); if (GET_TYPE(d) != VAL_DICT) PUSH(value_none()); else { List *l = list_new(AS_DICT(d)->size); for (int i=0; i<AS_DICT(d)->size; i++) list_push(l, value_string_copy(AS_DICT(d)->keys[i])); PUSH(value_list(l)); } pc++; DISPATCH(); }
    l_OP_DICT_VALUES: { Value d = POP(); if (GET_TYPE(d) != VAL_DICT) PUSH(value_none()); else { List *l = list_new(AS_DICT(d)->size); for (int i=0; i<AS_DICT(d)->size; i++) list_push(l, AS_DICT(d)->values[i]); PUSH(value_list(l)); } pc++; DISPATCH(); }
    l_OP_DICT_HAS: { Value k = POP(), d = POP(); int f = 0; if (GET_TYPE(d) == VAL_DICT && GET_TYPE(k) == VAL_STRING) { for (int i=0; i<AS_DICT(d)->size; i++) if (strcmp(AS_DICT(d)->keys[i], AS_STRING(k)) == 0) { f = 1; break; } } PUSH(value_bool(f)); pc++; DISPATCH(); }
    l_OP_DICT_REMOVE: pc++; DISPATCH(); l_OP_DICT_MERGE: pc++; DISPATCH();
    l_OP_MATH_ABS: { Value v = POP(); PUSH(value_float(fabs(val_to_double(v)))); pc++; DISPATCH(); }
    l_OP_MATH_MIN: { Value b = POP(), a = POP(); PUSH(value_float(fmin(val_to_double(a), val_to_double(b)))); pc++; DISPATCH(); }
    l_OP_MATH_MAX: { Value b = POP(), a = POP(); PUSH(value_float(fmax(val_to_double(a), val_to_double(b)))); pc++; DISPATCH(); }
    l_OP_MATH_ROUND: { Value v = POP(); PUSH(value_int((int64_t)round(val_to_double(v)))); pc++; DISPATCH(); }
    l_OP_MATH_FLOOR: { Value v = POP(); PUSH(value_int((int64_t)floor(val_to_double(v)))); pc++; DISPATCH(); }
    l_OP_MATH_CEIL: { Value v = POP(); PUSH(value_int((int64_t)ceil(val_to_double(v)))); pc++; DISPATCH(); }
    l_OP_MATH_SQRT: { Value v = POP(); PUSH(value_float(sqrt(val_to_double(v)))); pc++; DISPATCH(); }
    l_OP_STR_UPPER: pc++; DISPATCH(); l_OP_STR_LOWER: pc++; DISPATCH(); l_OP_STR_TRIM: pc++; DISPATCH(); l_OP_STR_FIND: pc++; DISPATCH(); l_OP_STR_REPLACE: pc++; DISPATCH(); l_OP_STR_STARTSWITH: pc++; DISPATCH(); l_OP_STR_ENDSWITH: pc++; DISPATCH(); l_OP_STR_SPLIT: pc++; DISPATCH();
    l_OP_LIST_PUSH: { Value v = POP(), l = POP(); if(GET_TYPE(l)==VAL_LIST) list_push(AS_LIST(l), v); pc++; DISPATCH(); }
    l_OP_LIST_POP: { Value l = POP(); if(GET_TYPE(l)==VAL_LIST && AS_LIST(l)->size > 0) PUSH(AS_LIST(l)->items[--AS_LIST(l)->size]); else PUSH(value_none()); pc++; DISPATCH(); }
    l_OP_LIST_INSERT: pc++; DISPATCH(); l_OP_LIST_REMOVE: pc++; DISPATCH(); l_OP_LIST_CONTAINS: pc++; DISPATCH(); l_OP_LIST_SORT: pc++; DISPATCH(); l_OP_LIST_REVERSE: pc++; DISPATCH();
    l_OP_FILE_READ: pc++; DISPATCH(); l_OP_FILE_WRITE: pc++; DISPATCH(); l_OP_FILE_APPEND: pc++; DISPATCH();
    l_OP_FSTRING: { int n = pc->arg; char *res = strdup(\"\"); for (int i=0; i<n; i++) { Value v = vm_stack[sp-n+i]; char buf[1024]; if (GET_TYPE(v) == VAL_STRING) strcpy(buf, AS_STRING(v)); else sprintf(buf, \"%g\", val_to_double(v)); char *next = malloc(strlen(res) + strlen(buf) + 1); strcpy(next, res); strcat(next, buf); free(res); res = next; } sp -= n; PUSH(value_string_copy(res)); free(res); pc++; DISPATCH(); }
    l_OP_LIST_COMP: { Value iter = POP(); const char *vn = (const char*)pc->cache_key; Bytecode *body = (Bytecode*)pc->ptr; List *res = list_new(8); if (GET_TYPE(iter) == VAL_LIST) { List *l = AS_LIST(iter); for (int i=0; i<l->size; i++) { var_set_let(vn, l->items[i]); Value val = run_bytecode(body, tsp); if (GET_TYPE(val) != VAL_NONE) list_push(res, val); if (has_exception) break; } } if (has_exception) { PUSH(pending_exception); goto l_OP_THROW; } PUSH(value_list(res)); pc++; DISPATCH(); }
    l_OP_THROW: { Value exc = (sp > 0) ? POP() : pending_exception; if (tsp > base_tsp) { TryHandler h = try_stack[--tsp]; sp = h.sp; var_restore_shadow(h.shadow_list); PUSH(exc); has_exception = 0; pc = bc->code + h.handler_ip; DISPATCH(); } pending_exception = exc; has_exception = 1; var_restore_shadow(start_shadow); return value_none(); }
    l_OP_TRY_START: try_stack[tsp++] = (TryHandler){ pc->arg, sp, let_shadow_list }; pc++; DISPATCH();
    l_OP_TRY_END: tsp--; pc++; DISPATCH();
    l_OP_LAMBDA: { FuncEntry *fe = func_get((const char*)pc->ptr); Closure *c = gc_alloc(sizeof(Closure), OBJ_CLOSURE); c->param_count = fe->param_count; c->params = fe->params; c->body = fe->body; LetShadow *s = let_shadow_list; while (s) { c->captured_count++; c->captured_names = realloc(c->captured_names, sizeof(char*)*c->captured_count); c->captured_values = realloc(c->captured_values, sizeof(Value)*c->captured_count); c->captured_names[c->captured_count-1] = (char*)s->name; c->captured_values[c->captured_count-1] = var_get(s->name); s = s->next; } PUSH(value_closure(c)); pc++; DISPATCH(); }
    l_OP_CALL_VALUE: { int ac = pc->arg; Value callee = POP(); if(GET_TYPE(callee)==VAL_OBJECT && (callee & MASK_PAYLOAD)) { ObjType ot = GET_OBJ_TYPE(callee); if(ot==OBJ_CLASS) { PUSH(value_instance(instance_new(AS_CLASS(callee)))); } else if(ot==OBJ_BOUND_METHOD) { BoundMethod *bm = AS_BOUND_METHOD(callee); if(bm->method && bm->method->body) { LetShadow *old_shadow = let_shadow_list; var_set_let(intern_string(\"self\"), bm->instance); for(int i=0; i<bm->method->param_count; i++) { Value val = (i < ac) ? vm_stack[sp-ac+i] : value_none(); var_set_let(bm->method->params[i], val); } sp -= ac; Value res = run_bytecode(bm->method->body, tsp); var_restore_shadow(old_shadow); if(has_exception) { PUSH(pending_exception); goto l_OP_THROW; } PUSH(res); } else { sp -= ac; PUSH(value_none()); } } else if(ot==OBJ_CLOSURE) { Closure *c = AS_CLOSURE(callee); if(c->body) { LetShadow *old_shadow = let_shadow_list; for(int i=0; i<c->captured_count; i++) var_set_let(c->captured_names[i], c->captured_values[i]); for(int i=0; i<c->param_count; i++) { Value val = (i < ac) ? vm_stack[sp-ac+i] : value_none(); var_set_let(c->params[i], val); } sp -= ac; Value res = run_bytecode(c->body, tsp); var_restore_shadow(old_shadow); if(has_exception) { PUSH(pending_exception); goto l_OP_THROW; } PUSH(res); } else { sp -= ac; PUSH(value_none()); } } else if(ot==OBJ_NATIVE_FUNC) { Value res = AS_NATIVE_FUNC(callee)->func(ac, &vm_stack[sp-ac]); sp-=ac; PUSH(res); } else PUSH(value_none()); } else PUSH(value_none()); pc++; DISPATCH(); }
    l_OP_CLASS_DEF: { const char *n = (const char*)pc->ptr; Class *p = NULL; if (pc->arg == 1) { Value pv = POP(); if (GET_TYPE(pv) == VAL_OBJECT && (pv & MASK_PAYLOAD)) p = AS_CLASS(pv); } Value c = value_class(class_new(n, p)); var_set(n, c); vm_last_class = AS_CLASS(c); pc++; DISPATCH(); }
    l_OP_METHOD_DEF: { FuncEntry *fe = func_get((const char*)pc->ptr); if(vm_last_class) dict_set(vm_last_class->methods, fe->name, value_bound_method(bound_method_new(value_none(), fe))); else if(vm_last_trait) dict_set(vm_last_trait->methods, fe->name, value_bound_method(bound_method_new(value_none(), fe))); pc++; DISPATCH(); }
    l_OP_TRAIT_DEF: { const char *n = (const char*)pc->ptr; Value t = value_trait(trait_new(n)); var_set(n, t); vm_last_trait = AS_TRAIT(t); pc++; DISPATCH(); }
    l_OP_USE_TRAIT: { Value tv = var_get((const char*)pc->ptr); if (GET_TYPE(tv) == VAL_OBJECT && (tv & MASK_PAYLOAD) && GET_OBJ_TYPE(tv) == OBJ_TRAIT && vm_last_class) { Trait *t = AS_TRAIT(tv); for (int i=0; i<t->methods->size; i++) dict_set(vm_last_class->methods, t->methods->keys[i], t->methods->values[i]); } pc++; DISPATCH(); }
    l_OP_GET_PROPERTY: { const char *n = (const char*)pc->ptr; Value o = POP(); if(GET_TYPE(o)==VAL_OBJECT && (o & MASK_PAYLOAD)) { ObjType ot = GET_OBJ_TYPE(o); if(ot==OBJ_INSTANCE) { Value v = instance_get(AS_INSTANCE(o), n); if(GET_TYPE(v)==VAL_OBJECT && (v & MASK_PAYLOAD) && GET_OBJ_TYPE(v)==OBJ_BOUND_METHOD && GET_TYPE(AS_BOUND_METHOD(v)->instance)==VAL_NONE) v = value_bound_method(bound_method_new(o, AS_BOUND_METHOD(v)->method)); PUSH(v); } else if(ot==OBJ_CLASS) PUSH(class_get_method(AS_CLASS(o), n)); else if(ot==OBJ_DICT) PUSH(dict_get(AS_DICT(o), n)); else PUSH(value_none()); } else PUSH(value_none()); pc++; DISPATCH(); }
    l_OP_SET_PROPERTY: { const char *n = (const char*)pc->ptr; Value o = POP(); Value v = POP(); if(GET_TYPE(o)==VAL_OBJECT && (o & MASK_PAYLOAD) && GET_OBJ_TYPE(o)==OBJ_INSTANCE) instance_set(AS_INSTANCE(o), n, v); else if(GET_TYPE(o)==VAL_DICT) dict_set(AS_DICT(o), n, v); pc++; DISPATCH(); }
    l_OP_SPAWN: { int ac = pc->arg; Value callee = POP(); ThreadData *td = malloc(sizeof(ThreadData)); td->callee = callee; td->argc = ac; td->args = malloc(sizeof(Value)*ac); for(int i=0; i<ac; i++) td->args[ac-1-i] = POP(); pthread_t t; pthread_create(&t, NULL, thread_wrapper, td); pthread_detach(t); pc++; DISPATCH(); }

    var_restore_shadow(start_shadow);
    return value_none();
}

void print_value(Value v) {
    if (v == 0) { printf(\"none\"); return; }
    if ((v & MASK_NAN) != MASK_NAN) { printf(\"%g\", AS_FLOAT(v)); return; }
    uint64_t type = (v & MASK_TYPE) >> 48;
    if (type == VAL_INT) printf(\"%ld\", (long)AS_INT(v));
    else if (type == VAL_BOOL) printf(AS_BOOL(v) ? \"true\" : \"false\");
    else if (type == VAL_STRING) printf(\"%s\", AS_STRING(v));
    else if (type == VAL_LIST) { List *l = AS_LIST(v); printf(\"[\"); for (int i=0; i<l->size; i++) { print_value(l->items[i]); if (i < l->size - 1) printf(\", \"); } printf(\"]\"); }
    else if (type == VAL_OBJECT) {
        if (!(v & MASK_PAYLOAD)) { printf(\"none\"); return; }
        ObjType ot = GET_OBJ_TYPE(v);
        if (ot == OBJ_CLASS) printf(\"<class %s>\", AS_CLASS(v)->name);
        else if (ot == OBJ_INSTANCE) printf(\"<instance of %s>\", AS_INSTANCE(v)->klass->name);
        else if (ot == OBJ_BOUND_METHOD) printf(\"<method %s>\", AS_BOUND_METHOD(v)->method->name);
        else printf(\"<object>\");
    } else printf(\"none\");
}

GlowError *glow_errors = NULL; int glow_error_count = 0; static int glow_error_capacity = 0;
void glow_clear_errors(void) { for (int i = 0; i < glow_error_count; i++) if(glow_errors[i].message) free(glow_errors[i].message); glow_error_count = 0; }
void glow_add_error(int line, const char *msg) {
    if (glow_error_count >= glow_error_capacity) { glow_error_capacity = (glow_error_capacity == 0) ? 8 : glow_error_capacity * 2; glow_errors = realloc(glow_errors, sizeof(GlowError) * glow_error_capacity); }
    glow_errors[glow_error_count].line = line; glow_errors[glow_error_count].message = strdup(msg); glow_error_count++;
}

static Value native_len(int argc, Value *args) { if (argc < 1) return value_int(0); Value v = args[0]; if (GET_TYPE(v) == VAL_STRING) return value_int(strlen(AS_STRING(v))); if (GET_TYPE(v) == VAL_LIST) return value_int(AS_LIST(v)->size); return value_int(0); }
static Value native_range(int argc, Value *args) { int n = (argc > 0) ? (int)AS_INT(args[0]) : 0; List *l = list_new(n); for (int i = 0; i < n; i++) list_push(l, value_int(i)); return value_list(l); }
static Value os_exit(int argc, Value *args) { exit(argc > 0 ? AS_INT(args[0]) : 0); return value_none(); }
static Value os_time(int argc, Value *args) { struct timeval tv; gettimeofday(&tv, NULL); return value_float(tv.tv_sec + tv.tv_usec / 1000000.0); }

static SSL_CTX *ssl_ctx = NULL;
static void ssl_init_native() { SSL_library_init(); OpenSSL_add_all_algorithms(); SSL_load_error_strings(); ssl_ctx = SSL_CTX_new(TLS_server_method()); }
static Value ssl_listen(int argc, Value *args) {
    if (argc < 3) return value_int(-1);
    int port = AS_INT(args[0]); const char *cert = AS_STRING(args[1]), *key = AS_STRING(args[2]);
    if (!ssl_ctx) ssl_init_native();
    if (SSL_CTX_use_certificate_file(ssl_ctx, cert, SSL_FILETYPE_PEM) <= 0) return value_int(-2);
    if (SSL_CTX_use_PrivateKey_file(ssl_ctx, key, SSL_FILETYPE_PEM) <= 0) return value_int(-3);
    int sockfd = socket(AF_INET, SOCK_STREAM, 0); struct sockaddr_in addr; memset(&addr, 0, sizeof(addr));
    addr.sin_family = AF_INET; addr.sin_addr.s_addr = INADDR_ANY; addr.sin_port = htons(port);
    int opt = 1; setsockopt(sockfd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));
    if (bind(sockfd, (struct sockaddr *)&addr, sizeof(addr)) < 0) return value_int(-4);
    listen(sockfd, 10); return value_int(sockfd);
}
static Value ssl_accept(int argc, Value *args) {
    if (argc < 1) return value_none();
    int server_fd = AS_INT(args[0]), client_fd = accept(server_fd, NULL, NULL);
    if (client_fd < 0) return value_none();
    SSL *ssl = SSL_new(ssl_ctx); SSL_set_fd(ssl, client_fd);
    if (SSL_accept(ssl) <= 0) { SSL_free(ssl); close(client_fd); return value_none(); }
    return make_value(VAL_OBJECT, (uint64_t)(uintptr_t)ssl);
}
static Value net_listen(int argc, Value *args) {
    if (argc < 1) return value_int(-1);
    int port = AS_INT(args[0]), sockfd = socket(AF_INET, SOCK_STREAM, 0);
    struct sockaddr_in addr; memset(&addr, 0, sizeof(addr));
    addr.sin_family = AF_INET; addr.sin_addr.s_addr = INADDR_ANY; addr.sin_port = htons(port);
    int opt = 1; setsockopt(sockfd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));
    if (bind(sockfd, (struct sockaddr *)&addr, sizeof(addr)) < 0) return value_int(-1);
    listen(sockfd, 10); return value_int(sockfd);
}
static Value net_close(int argc, Value *args) { if (argc < 1) return value_int(-1); close(AS_INT(args[0])); return value_none(); }
static Value http_listen(int argc, Value *args) {
    if (argc < 1) return value_int(-1);
    int port = AS_INT(args[0]), sockfd = socket(AF_INET, SOCK_STREAM, 0);
    struct sockaddr_in addr; memset(&addr, 0, sizeof(addr));
    addr.sin_family = AF_INET; addr.sin_addr.s_addr = INADDR_ANY; addr.sin_port = htons(port);
    int opt = 1; setsockopt(sockfd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));
    if (bind(sockfd, (struct sockaddr *)&addr, sizeof(addr)) < 0) return value_int(-1);
    listen(sockfd, 1024); return value_int(sockfd);
}
static Value http_close(int argc, Value *args) { if (argc < 1) return value_int(-1); close(AS_INT(args[0])); return value_none(); }

static void std_init(void) {
    var_set(intern_string(\"len\"), native_func_new(\"len\", native_len));
    var_set(intern_string(\"range\"), native_func_new(\"range\", native_range));
    var_set(intern_string(\"net_close\"), native_func_new(\"net_close\", net_close));
    Dict *os = dict_new(4); dict_set(os, intern_string(\"exit\"), native_func_new(\"exit\", os_exit)); dict_set(os, intern_string(\"time\"), native_func_new(\"time\", os_time)); var_set(intern_string(\"os\"), value_dict(os));
    Dict *net = dict_new(4); dict_set(net, intern_string(\"listen\"), native_func_new(\"listen\", net_listen)); dict_set(net, intern_string(\"close\"), native_func_new(\"close\", net_close)); var_set(intern_string(\"net\"), value_dict(net));
    Dict *http = dict_new(4); dict_set(http, intern_string(\"listen\"), native_func_new(\"listen\", http_listen)); dict_set(http, intern_string(\"close\"), native_func_new(\"close\", http_close)); var_set(intern_string(\"http\"), value_dict(http));
    Dict *ssl = dict_new(4); dict_set(ssl, intern_string(\"listen\"), native_func_new(\"listen\", ssl_listen)); dict_set(ssl, intern_string(\"accept\"), native_func_new(\"accept\", ssl_accept)); var_set(intern_string(\"ssl\"), value_dict(ssl));
}

Node *root = NULL;
int main(int argc, char **argv) {
    var_table_init(); func_table_init(); vm_stack_init(); intern_table_init(); std_init();
    if (argc > 1) {
        if (strcmp(argv[1], \"--lsp\") == 0) { handle_client(0); return 0; }
        yyin = fopen(argv[1], \"r\");
        if(yyin) {
            yyparse();
            if(root) {
                Bytecode *main_bc = bc_new(); compiling_bc = main_bc; compile(root); bc_emit(main_bc, OP_RETURN, 0, 0);
                pthread_mutex_lock(&glow_gil);
                run_bytecode(main_bc, 0);
                pthread_mutex_unlock(&glow_gil);
            }
            fclose(yyin);
        }
    }
    return 0;
}
void yyerror(const char *s) { fprintf(stderr, \"Error: %s at line %d\\n\", s, line_num); }
