# CI runs this with GLOW_JIT_DEBUG=1 and fails unless the JIT reports
# compiling something: the test suite also passes interpreter-only, so it
# cannot tell on its own whether compiled code ran.
func fib(n):
    if n < 2:
        return n
    end
    return fib(n - 1) + fib(n - 2)
end

func float_sum(n):
    let s = 0.0
    let i = 0
    while i < n:
        s = s + i * 0.5
        i = i + 1
    end
    return s
end

show fib(24), float_sum(100000)
