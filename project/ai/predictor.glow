# GlowNet AI Predictor
# A one-layer model: output = weights * input + bias, squashed to 0..1.

use "matrix.glow"
use "tensor.glow"

func sigmoid(x):
    return 1.0 / (1.0 + math.exp(0.0 - x))
end

blueprint Predictor:
    action init():
        # 2 inputs -> 2 outputs
        self.weights = Matrix(2, 2)
        self.weights.fill([[0.5, -0.5], [-0.5, 0.5]])
        self.bias = [0.0, 0.0]
        self.updates = 0
    end

    action predict(input_vec):
        let x = Matrix(2, 1)
        x.fill([[input_vec[0]], [input_vec[1]]])
        let z = self.weights.multiply(x)
        return [sigmoid(z.get(0, 0) + self.bias[0]), sigmoid(z.get(1, 0) + self.bias[1])]
    end

    # One step of gradient descent on the squared error.
    action adjust_weights(lr, input_vec, pred, target):
        let i = 0
        while i < 2:
            let grad = (pred[i] - target[i]) * pred[i] * (1.0 - pred[i])
            let j = 0
            while j < 2:
                self.weights.set(i, j, self.weights.get(i, j) - lr * grad * input_vec[j])
                j = j + 1
            end
            self.bias[i] = self.bias[i] - lr * grad
            i = i + 1
        end
        self.updates = self.updates + 1
    end
end
