# GlowNet AI Training Engine
# Trains a Predictor by gradient descent on the mean squared error.

use "matrix.glow"
use "tensor.glow"

blueprint Trainer:
    action init(model, learning_rate):
        self.model = model
        self.lr = learning_rate
        self.history = []
    end

    action train_step(input_vec, target_vec):
        let prediction = self.model.predict(input_vec)
        let loss = 0.0
        let i = 0
        while i < len(prediction):
            let diff = prediction[i] - target_vec[i]
            loss = loss + diff * diff
            i = i + 1
        end
        loss = loss / len(prediction)
        self.model.adjust_weights(self.lr, input_vec, prediction, target_vec)
        self.history.push(loss)
        return loss
    end

    # One pass over the data; returns the average loss.
    action run_epoch(inputs, targets):
        let total = 0.0
        let i = 0
        while i < len(inputs):
            total = total + self.train_step(inputs[i], targets[i])
            i = i + 1
        end
        return total / len(inputs)
    end
end
