# Tensor Subsystem
# A shaped block of numbers backed by a packed (SIMD-capable) array.

blueprint Tensor:
    action init(shape, type):
        self.shape = shape
        self.type = type
        let size = 1
        for each dim in shape:
            size = size * dim
        end
        self.data = tensor.zeros(size, type)
    end

    action get_size():
        return len(self.data)
    end

    # Element-wise sum, or none when the types differ.
    action add(other):
        if self.type != other.type:
            return none
        end
        let res = Tensor(self.shape, self.type)
        res.data = tensor.add(self.data, other.data)
        return res
    end
end
