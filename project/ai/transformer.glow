# ============================================================================
# Project AI: Transformer Module (project/ai/transformer.glow)
# ============================================================================
# High-level Transformer pipeline interface for GlowLang projects.
# Uses pure GlowLang native SIMD tensors with zero Python dependencies.
# ============================================================================

import "lib/transformer.glow"

blueprint TransformerModel:
    action init(seq_len, d_model, num_heads, d_ff, num_layers, num_classes):
        self.seq_len = seq_len
        self.d_model = d_model
        self.num_classes = num_classes
        self.classifier = TransformerClassifier(d_model, num_heads, d_ff, num_layers, num_classes)
        self.classifier.init(d_model, num_heads, d_ff, num_layers, num_classes)
    end

    action predict_tokens(embedding_tensor):
        return self.classifier.forward(embedding_tensor, self.seq_len)
    end

    action summary():
        show "=== GlowLang Pure Transformer Model ==="
        show "  Sequence Length : " + self.seq_len
        show "  Hidden Dim      : " + self.d_model
        show "  Output Classes  : " + self.num_classes
        show "======================================="
    end
end
