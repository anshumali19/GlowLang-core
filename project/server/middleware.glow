# GlowNet Middleware System
# Wraps a request handler in a chain of middleware functions. A middleware
# is func(req, next): it may change the request, call next(req) to continue,
# and change the response on the way back.

let middleware_chain = []

func use_middleware(m):
    middleware_chain.push(m)
end

func clear_middleware():
    middleware_chain = []
end

# Runs the chain from position `index`, then the final handler.
# (The position is passed along: a nested function cannot assign to a
# variable of the function around it.)
func run_chain_from(req, index, final_handler):
    if index < len(middleware_chain):
        let m = middleware_chain[index]
        return m(req, lambda(r): run_chain_from(r, index + 1, final_handler))
    end
    return final_handler(req)
end

func execute_chain(request, final_handler):
    return run_chain_from(request, 0, final_handler)
end

# Example: logs each request and how long it took.
func logger_middleware(req, next):
    show "[Request] ", req["method"], " ", req["path"]
    let start = os.time()
    let res = next(req)
    let end_time = os.time()
    show "[Response] Status: ", res["status"], " (", (end_time - start), "s)"
    return res
end
