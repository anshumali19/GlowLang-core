# GlowNet Async Task Infrastructure
# Promises and deferred execution.

blueprint Promise:
    action init():
        self.state = "pending"
        self.value = none
        self.callbacks = []
    end

    action resolve(val):
        if self.state == "pending":
            self.state = "fulfilled"
            self.value = val
            for each cb in self.callbacks:
                cb(val)
            end
        end
    end

    action then(cb):
        if self.state == "fulfilled":
            cb(self.value)
        else:
            self.callbacks.push(cb)
        end
        return self
    end
end

func delay_worker(p, seconds):
    # os.sleep counts milliseconds.
    os.sleep(seconds * 1000)
    p.resolve(true)
end

# A promise that resolves to true after `seconds`, on another thread.
func delay(seconds):
    let p = Promise()
    spawn delay_worker(p, seconds)
    return p
end

func async_all_store(p, st, index, count, val):
    st["results"][index] = val
    st["done"] = st["done"] + 1
    if st["done"] == count:
        p.resolve(st["results"])
    end
end

func async_all_slot(p, st, index, count):
    return lambda(val): async_all_store(p, st, index, count, val)
end

# A promise for the list of every promise's value, in order.
# A lambda cannot assign to a variable of the function around it, so the
# running state is kept in a dict, which it can change.
func async_all(promises):
    let p = Promise()
    let count = len(promises)
    let st = {"done": 0, "results": []}
    let i = 0
    while i < count:
        st["results"].push(none)
        i = i + 1
    end
    if count == 0:
        p.resolve([])
        return p
    end
    i = 0
    while i < count:
        promises[i].then(async_all_slot(p, st, i, count))
        i = i + 1
    end
    return p
end
