show "Testing net module..."
server = net.listen(9999)
show "Server socket: " + server
when server != (0 - 1):
    show "net.listen works"
    net.close(server)
    show "net.close works"
otherwise:
    show "net.listen failed (maybe port 9999 is taken?)"
end

show "Testing global net_ functions..."
server2 = net.listen(9998)
when server2 != (0 - 1):
    net_close(server2)
    show "net_close works"
otherwise:
    show "net.listen failed (maybe port 9998 is taken?)"
end
