use "lib/ai.glow"

# Test basic layer
let l = Layer(3, 2)
let input = tensor.create(3)
tensor.set(input, 0, 1.0)
tensor.set(input, 1, 2.0)
tensor.set(input, 2, 3.0)
let out = l.forward(input)
show "Layer output: ", out

# Test NeuralNet
let net = NeuralNet([3, 4, 2])
net.summary()
let pred = net.forward(input)
show "Net prediction: ", pred

# Test LossFunction
let loss_fn = LossFunction("mse")
let target = tensor.create(2)
tensor.set(target, 0, 1.0)
tensor.set(target, 1, 0.0)
let loss = loss_fn.compute(pred, target, 2)
show "MSE Loss: " + loss

# Test Optimizer
let opt = Optimizer(0.01)
show "Optimizer created with lr=0.01"

# Test activation functions
show "relu(5) = " + relu(5)
show "relu(-3) = " + relu(-3)
show "sigmoid(0) = " + sigmoid(0)

# Test preprocessing
let data_t = tensor.create(4)
tensor.set(data_t, 0, 10.0)
tensor.set(data_t, 1, 20.0)
tensor.set(data_t, 2, 30.0)
tensor.set(data_t, 3, 40.0)
let normed = min_max_normalize(data_t, 4)
show "Normalized: ", normed

# Test one-hot
let oh = one_hot_encode(2, 5)
show "One-hot(2, 5): ", oh

show "=== All AI tests passed ==="
