# Can we compute abs without abs()?
func my_abs(x):
    if x < 0:
        return 0 - x
    end
    return x
end
show my_abs(-5)
show my_abs(5)

# Can we compute exp without exp()?
# exp(x) = e^x. We have math.pow(base, exp)
# e ≈ 2.718281828
func my_exp(x):
    return math.pow(2.718281828, x)
end
show my_exp(0)
show my_exp(1)

