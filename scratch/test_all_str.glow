
let s = "hello world"
# Test method forms
let parts = s.split(" ")
show "split:", parts

# indexOf
let idx = s.indexOf("world")
show "indexOf:", idx

# Test replace
let r = s.replace("world", "glow")
show "replace:", r

# Test trim 
let t = "  hello  "
show "trim:", t.trim()

# Test upper/lower
show "upper:", s.upper()
show "lower:", s.lower()

